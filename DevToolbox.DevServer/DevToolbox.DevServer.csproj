<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Plain net10.0, so it runs wherever the UI is being worked on. It picks the platform's
         services at startup: Windows or Unix. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Serves its own components over Kestrel, so it needs _framework/blazor.web.js in its manifest. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <!-- A development tool, never shipped: it exists so the Blazor components can be viewed and
         iterated on in an ordinary browser instead of inside the packaged WinForms WebView. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevToolbox.UI.Shared\DevToolbox.UI.Shared.csproj" />
    <ProjectReference Include="..\DevToolbox.Services.Windows\DevToolbox.Services.Windows.csproj" />
    <ProjectReference Include="..\DevToolbox.Services.Unix\DevToolbox.Services.Unix.csproj" />
  </ItemGroup>

</Project>
