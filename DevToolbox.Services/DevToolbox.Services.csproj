<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0: the platform-neutral core. Anything that has to call Windows or Unix goes
         behind an interface here, with the implementations in DevToolbox.Services.Windows and
         DevToolbox.Services.Unix. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- So the test project can assert on monitor-loop lifecycle, which is not observable from
         the public surface and is exactly where two duplicate-loop bugs went unnoticed. -->
    <InternalsVisibleTo Include="DevToolbox.Tests" />
    <InternalsVisibleTo Include="DevToolbox.Tests.Windows" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Scripts\*.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The configuration a fresh machine arrives with. ConfigDefaults copies these into
         %LOCALAPPDATA%\DevToolbox\Config on first run, never overwriting, because MSIX has no
         install step that could put them there. Without this beside the executable there is
         nothing to seed, and every Open falls through to the Windows file association. -->
    <None Update="ConfigDefaults\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevToolbox.Logs\DevToolbox.Logs.csproj" />
  </ItemGroup>

</Project>
