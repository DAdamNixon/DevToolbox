<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The icon Windows shows for the file, the shortcut and the taskbar button. Without it the
         published executable carries the generic .NET icon, while the window and tray icons — set
         from the same file at runtime — looked right, so the mismatch only showed up on the desktop. -->
    <ApplicationIcon>Resources\toolbox_Y9B_icon.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableDefaultRazorGenerateItems>true</EnableDefaultRazorGenerateItems>
    <RazorLangVersion>latest</RazorLangVersion>
    <!-- Explicit: this app serves its own components over Kestrel, so it needs the
         framework static assets (_framework/blazor.web.js) resolved into its manifest. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.90" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevToolbox.Services\DevToolbox.Services.csproj" />
  </ItemGroup>

  <!--
    Put blazor.web.js where the app can serve it.

    Microsoft.AspNetCore.App.Internal.Assets ships the script and has a target that
    registers it as a static web asset, but that target is gated on OutputType == 'Exe'
    and this project is WinExe, being a Windows app that happens to also serve itself.
    So the script never reached the manifest and /_framework/blazor.web.js 404'd, which
    leaves the browser view rendered but inert � no circuit, no interactivity.

    Copied into wwwroot rather than fought over in MSBuild: from there it is an ordinary
    static web asset of this project. It is generated, so .gitignore covers it.
  -->
  <Target Name="CopyBlazorWebScript"
          BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild"
          Condition="Exists('$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js')">
    <Copy SourceFiles="$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\_framework"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Rebuild the Tailwind stylesheet when its inputs change.

    wwwroot/css/output.css is a committed artifact, and keeping it in sync used to
    be something you had to remember: Tailwind only emits the classes it saw at
    build time, so a new utility class in markup silently did nothing until
    someone re-ran npm. That trap is what pushed dashboard.css into being plain
    CSS in the first place.

    Conditioned on node_modules existing so `dotnet build` still works on a clone
    with no npm install — the committed output.css is used as-is in that case,
    which is the same behaviour as before. ContinueOnError keeps a Tailwind
    failure from breaking an otherwise fine build; the stale stylesheet is a
    cosmetic problem, not a broken one.
  -->
  <Target Name="BuildTailwindCss"
          BeforeTargets="BeforeBuild"
          Condition="Exists('$(MSBuildProjectDirectory)\node_modules')"
          Inputs="wwwroot\css\input.css;tailwind.config.js;@(Content);@(None)"
          Outputs="wwwroot\css\output.css">
    <Message Importance="high" Text="Tailwind: rebuilding wwwroot/css/output.css" />
    <Exec Command="npm run build-css-prod"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <Folder Include="Services\" />
    <Folder Include="wwwroot\css\" />
    <Folder Include="wwwroot\images\" />
  </ItemGroup>

  <ItemGroup>
  <Compile Update="MainWindow.Designer.cs">
    <DependentUpon>MainWindow.cs</DependentUpon>
  </Compile>
  <Compile Update="MainWindow.resx">
    <DependentUpon>MainWindow.cs</DependentUpon>
  </Compile>
  <Compile Update="Properties\Resources.Designer.cs">
    <DesignTime>True</DesignTime>
    <AutoGen>True</AutoGen>
    <DependentUpon>Resources.resx</DependentUpon>
  </Compile>
</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
