<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The icon Windows shows for the file, the shortcut and the taskbar button. Without it the
         published executable carries the generic .NET icon, while the window and tray icons — set
         from the same file at runtime — looked right, so the mismatch only showed up on the desktop. -->
    <ApplicationIcon>Resources\devtoolbox.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableDefaultRazorGenerateItems>true</EnableDefaultRazorGenerateItems>
    <RazorLangVersion>latest</RazorLangVersion>
    <!-- Explicit: this app serves its own components over Kestrel, so it needs the
         framework static assets (_framework/blazor.web.js) resolved into its manifest. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.90" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
  </ItemGroup>

  <!-- The Windows host: a Windows Forms window around a WebView, the tray icon, and the
       single-instance and elevated-write entry points. Every page, component and stylesheet comes
       from DevToolbox.UI.Shared; this project adds none of its own. wwwroot/index.html is the
       WebView's host page, the one piece of markup a BlazorWebView needs from its host. -->
  <ItemGroup>
    <ProjectReference Include="..\DevToolbox.Services\DevToolbox.Services.csproj" />
    <ProjectReference Include="..\DevToolbox.Services.Windows\DevToolbox.Services.Windows.csproj" />
    <ProjectReference Include="..\DevToolbox.UI.Shared\DevToolbox.UI.Shared.csproj" />
  </ItemGroup>

  <!--
    Put blazor.web.js where the app can serve it.

    Microsoft.AspNetCore.App.Internal.Assets ships the script and has a target that
    registers it as a static web asset, but that target is gated on OutputType == 'Exe'
    and this project is WinExe, being a Windows app that happens to also serve itself.
    So the script never reached the manifest and /_framework/blazor.web.js 404'd, which
    leaves the browser view rendered but inert � no circuit, no interactivity.

    Copied into wwwroot rather than fought over in MSBuild: from there it is an ordinary
    static web asset of this project. It is generated, so .gitignore covers it.
  -->
  <Target Name="CopyBlazorWebScript"
          BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild"
          Condition="Exists('$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js')">
    <Copy SourceFiles="$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\_framework"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- The Tailwind build moved to DevToolbox.UI.Shared with the markup and stylesheets it reads. -->

  <ItemGroup>
    <Folder Include="Services\" />
  </ItemGroup>

  <ItemGroup>
  <Compile Update="MainWindow.Designer.cs">
    <DependentUpon>MainWindow.cs</DependentUpon>
  </Compile>
  <Compile Update="MainWindow.resx">
    <DependentUpon>MainWindow.cs</DependentUpon>
  </Compile>
  <Compile Update="Properties\Resources.Designer.cs">
    <DesignTime>True</DesignTime>
    <AutoGen>True</AutoGen>
    <DependentUpon>Resources.resx</DependentUpon>
  </Compile>
</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
