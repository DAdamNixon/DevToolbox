@using DevToolbox.Services.Models

<div class="mb-4">
    <label class="form-label mb-2">New Name</label>
    <input type="text" 
        class="form-control" 
        @bind="GroupName" 
        placeholder="Enter new name" />
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="invalid-feedback d-block mt-2">
            @ErrorMessage
        </div>
    }
</div>
<button class="btn btn-primary" 
        @onclick="HandleRename" 
        disabled="@string.IsNullOrEmpty(GroupName)">
    <i class="bi bi-check-lg me-2"></i>Rename
</button>

@code {
    [Parameter] public string GroupName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> GroupNameChanged { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback<string?> ErrorMessageChanged { get; set; }
    [Parameter] public WorkspaceGroup Group { get; set; } = null!;
    [Parameter] public List<WorkspaceGroup> AllGroups { get; set; } = new();

    /// <summary>
    /// The validated new name. This dialog no longer applies the rename itself: a hand-made group
    /// is renamed by editing the group and its workspaces, and a scanned group by editing the
    /// <c>group:</c> field of every smart folder feeding it — and either way the arrangement stored
    /// against the old name has to be carried across, which is not something a text box should be
    /// deciding.
    /// </summary>
    [Parameter] public EventCallback<string> OnRenameCompleted { get; set; }

    private async Task HandleRename()
    {
        var trimmed = GroupName?.Trim() ?? string.Empty;

        if (trimmed.Length == 0)
        {
            await ErrorMessageChanged.InvokeAsync("Please enter a name.");
            return;
        }

        if (AllGroups.Any(g => g.Name.Equals(trimmed, StringComparison.OrdinalIgnoreCase)
                               && !g.Name.Equals(Group.Name, StringComparison.OrdinalIgnoreCase)))
        {
            await ErrorMessageChanged.InvokeAsync("A group with this name already exists.");
            return;
        }

        await ErrorMessageChanged.InvokeAsync(null);
        await OnRenameCompleted.InvokeAsync(trimmed);
    }
    
    public void ResetForm()
    {
        ErrorMessageChanged.InvokeAsync(null);
    }
} 