@using DevToolbox.Services.Models

<div class="@(IsVisible ? "fixed inset-0 z-50 flex items-center justify-center" : "hidden")">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" @onclick="Cancel"></div>
    
    <!-- Modal -->
    @* bg-dark-surface, not bg-dark-card: there is no 'dark-card' colour in
       tailwind.config.js, so this panel had no background at all and the
       backdrop showed straight through it. *@
    <div class="relative bg-dark-surface border border-dark-border rounded-xl shadow-2xl w-full max-w-md mx-4 max-h-[80vh] overflow-y-auto">
        <!-- Header -->
        <div class="flex items-center justify-between p-6 border-b border-dark-border">
            <h3 class="text-xl font-semibold text-dark-text">
                @(IsEditMode ? "Edit Service" : "Add New Service")
            </h3>
            <button type="button" class="btn-ghost p-2" @onclick="Cancel">
                <i class="bi bi-x text-xl"></i>
            </button>
        </div>
        
        <!-- Body -->
        <div class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-medium text-dark-text mb-2">Service Name</label>
                <input type="text" class="input-modern w-full" @bind="ServiceName" placeholder="My API Service" />
            </div>
            
            <div>
                <label class="block text-sm font-medium text-dark-text mb-2">Endpoint URL</label>
                <input type="url" class="input-modern w-full" @bind="Endpoint" placeholder="https://api.example.com/health" />
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-dark-text mb-2">Ping Interval (seconds)</label>
                    <input type="number" class="input-modern w-full" @bind="PingIntervalSeconds" min="10" max="3600" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-dark-text mb-2">Timeout (seconds)</label>
                    <input type="number" class="input-modern w-full" @bind="TimeoutSeconds" min="5" max="120" />
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-dark-text mb-2">Environment</label>
                <select class="input-modern w-full" @bind="Environment">
                    <option value="">Select Environment</option>
                    <option value="Development">Development</option>
                    <option value="Testing">Testing</option>
                    <option value="Staging">Staging</option>
                    <option value="Production">Production</option>
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-dark-text mb-2">Description (optional)</label>
                <textarea class="input-modern w-full resize-none" rows="2" @bind="Description" 
                         placeholder="Brief description of this service"></textarea>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-dark-text mb-2">Tags (comma-separated)</label>
                <input type="text" class="input-modern w-full" @bind="TagsText" 
                       placeholder="api, web, critical" />
            </div>
            
            <div class="flex items-center space-x-3">
                <input type="checkbox" id="isEnabled" @bind="IsEnabled" class="w-4 h-4 text-accent-blue bg-dark-surface border-dark-border rounded focus:ring-accent-blue focus:ring-2" />
                <label for="isEnabled" class="text-sm text-dark-text">Enable monitoring for this service</label>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="flex items-center justify-end space-x-3 p-6 border-t border-dark-border">
            <button type="button" class="btn-secondary" @onclick="Cancel">Cancel</button>
            <button type="button" class="btn-primary" @onclick="Save" disabled="@(!IsValid)">
                @(IsEditMode ? "Update" : "Add") Service
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public ServiceEndpoint? ExistingService { get; set; }
    [Parameter] public EventCallback<ServiceEndpoint> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string ServiceName = "";
    private string Endpoint = "";
    private int PingIntervalSeconds = 30;
    private int TimeoutSeconds = 10;
    private string Environment = "";
    private string Description = "";
    private string TagsText = "";
    private bool IsEnabled = true;

    /// <summary>The dialog stays mounted while hidden, so "opened" is a change in <see cref="IsVisible"/>.</summary>
    private bool _wasVisible;

    private bool IsValid => !string.IsNullOrWhiteSpace(ServiceName) && 
                           !string.IsNullOrWhiteSpace(Endpoint) &&
                           Uri.TryCreate(Endpoint, UriKind.Absolute, out _);

    /// <summary>
    /// Seeds the form when the dialog opens, and at no other time.
    /// <para>
    /// It used to fill every field on every <c>OnParametersSet</c> — which runs on each re-render of
    /// the page, not each opening of the dialog. Service Pulse re-renders once a second to redraw its
    /// "3s ago" labels, and again on every health event, so a field committed on blur was overwritten
    /// within about a second: in add mode with an empty string, in edit mode with the stored value.
    /// That is the whole of "the text just keeps disappearing when you unfocus from it".
    /// </para>
    /// <para>
    /// Same shape as the Hosts dialogs, which already do this.
    /// </para>
    /// </summary>
    protected override void OnParametersSet()
    {
        if (IsVisible == _wasVisible) return;

        _wasVisible = IsVisible;
        if (!IsVisible) return;

        if (IsEditMode && ExistingService is not null)
        {
            ServiceName = ExistingService.Name;
            Endpoint = ExistingService.Endpoint;
            PingIntervalSeconds = ExistingService.PingIntervalSeconds;
            TimeoutSeconds = ExistingService.TimeoutSeconds;
            Environment = ExistingService.Environment ?? "";
            Description = ExistingService.Description ?? "";
            TagsText = string.Join(", ", ExistingService.Tags);
            IsEnabled = ExistingService.IsEnabled;
            return;
        }

        ServiceName = "";
        Endpoint = "";
        PingIntervalSeconds = 30;
        TimeoutSeconds = 10;
        Environment = "";
        Description = "";
        TagsText = "";
        IsEnabled = true;
    }

    private async Task Save()
    {
        if (!IsValid) return;

        // Edits mutate the existing endpoint rather than building a replacement.
        // A fresh ServiceEndpoint would silently drop expectStatus, degradedAboveMs
        // and details — the hand-authored YAML fields this dialog has no inputs for
        // — so opening a service and pressing Update deleted them.
        var service = IsEditMode && ExistingService is not null
            ? ExistingService
            : new ServiceEndpoint { Id = Guid.NewGuid().ToString() };

        service.Name = ServiceName.Trim();
        service.Endpoint = Endpoint.Trim();
        service.PingIntervalSeconds = PingIntervalSeconds;
        service.TimeoutSeconds = TimeoutSeconds;
        service.Environment = Environment;
        service.Description = string.IsNullOrWhiteSpace(Description) ? null : Description.Trim();
        service.Tags = TagsText.Split(',', StringSplitOptions.RemoveEmptyEntries)
                               .Select(t => t.Trim())
                               .Where(t => !string.IsNullOrEmpty(t))
                               .ToList();
        service.IsEnabled = IsEnabled;

        await OnSave.InvokeAsync(service);
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}