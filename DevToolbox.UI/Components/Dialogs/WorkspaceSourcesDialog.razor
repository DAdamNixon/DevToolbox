@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using System.IO
@inject IWorkspaceSourceService SourceService
@inject IUiSettingsService UiSettings
@inject IIconService IconService
@implements IDisposable

@* An (i) beside a field label, toggling the example underneath it. Declared here because a Razor
   templated delegate has to exist above its first use.

   The examples used to be permanent paragraphs under every field — four sentences on excludes, six
   on the name pattern — which is a wall of prose in a column 22rem wide, and the two lines that
   were actually load-bearing were somewhere in the middle of it. One short line stays visible per
   field; the worked example is a click away, for the one field you are currently stuck on. *@
@{
    RenderFragment<string> Info = key =>
    @<button type="button" class="ws-info @(info == key ? "is-on" : "")"
             title="@(info == key ? "Hide the example" : "Show an example")"
             @onclick="() => ToggleInfo(key)">
        <i class="bi bi-info-circle"></i>
    </button>;
}

@* Three columns: the smart folders down the left, the one being edited in the middle, and what
   it matches on the right. The matches were underneath the fields before, which meant the answer
   to "did that change help?" was below the fold of a dialog you were typing into — the two things
   you are comparing could not be on screen together. Now they are side by side and the matches
   scroll on their own.

   The left column collapses to a rail, because once you are working on one folder the list of the
   other eight is just width taken off the two columns that matter. *@
@if (config is null)
{
    <div class="ws-empty">Loading smart folders…</div>
}
else
{
    <div class="ws-sources @(listCollapsed ? "is-list-collapsed" : "")">
        <div class="ws-source-list">
            <button type="button" class="ws-list-toggle"
                    title="@(listCollapsed ? "Show the list of smart folders" : "Collapse the list")"
                    @onclick="() => listCollapsed = !listCollapsed">
                <i class="bi @(listCollapsed ? "bi-chevron-double-right" : "bi-chevron-double-left")"></i>
                @if (!listCollapsed)
                {
                    <span>@config.Sources.Count folders</span>
                }
            </button>

            @if (!listCollapsed)
            {
                @foreach (var source in config.Sources)
                {
                    <button type="button"
                            class="ws-source-item @(ReferenceEquals(source, selected) ? "is-active" : "") @(source.Enabled ? "" : "is-off")"
                            @onclick="() => Select(source)">
                        <span class="ws-source-item-name">@DisplayName(source)</span>
                        <span class="ws-source-item-meta">@Summary(source)</span>
                    </button>
                }

                <button type="button" class="ws-source-add" @onclick="Add">
                    <i class="bi bi-plus-circle"></i> Add smart folder
                </button>
            }
        </div>

        <div class="ws-source-editor">
            @if (selected is null)
            {
                <div class="ws-empty">
                    @if (config.Sources.Count == 0)
                    {
                        <span>
                            No smart folders yet. Point one at a directory of project files —
                            <span class="font-mono">*.code-workspace</span>, <span class="font-mono">*.sln</span>,
                            or the repo folders themselves — and they show up as cards.
                        </span>
                    }
                    else
                    {
                        <span>Pick a smart folder on the left to edit it.</span>
                    }
                </div>
            }
            else
            {
                <div class="ws-editor-head">
                    <label class="ws-check">
                        <input type="checkbox" checked="@selected.Enabled" @onchange="ToggleEnabled" />
                        <span>Enabled</span>
                    </label>
                    <button type="button" class="btn-ghost btn-sm" title="Remove this smart folder"
                            @onclick="() => Remove(selected)">
                        <i class="bi bi-trash"></i> Remove
                    </button>
                </div>

                @* Four sections, each answering one question, instead of eleven fields in a
                   two-column grid ordered by nothing. The old order interleaved them — name,
                   pattern, path, collect, excludes, group, location name — so reading it top to
                   bottom never finished a thought. *@

                <section class="ws-section">
                    <h4 class="ws-section-title">Name and target group</h4>
                    <div class="ws-source-grid">
                        <div class="ws-field">
                            <label class="ws-label">Name</label>
                            <input type="text" class="ws-input" @bind="selected.Name" @bind:event="oninput"
                                   @bind:after="SchedulePreview" placeholder="VS Code Workspaces" />
                            <span class="ws-hint">This rule, in the list on the left.</span>
                        </div>

                        <div class="ws-field">
                            <div class="ws-label-row">
                                <label class="ws-label">Target group</label>
                                @Info("group")
                            </div>
                            <input type="text" class="ws-input" @bind="selected.Group" @bind:event="oninput"
                                   @bind:after="SchedulePreview" placeholder="@GroupPlaceholder" />
                            <span class="ws-hint">The dashboard group these land in.</span>
                            @if (info == "group")
                            {
                                <div class="ws-info-box">
                                    Rules sharing a target group merge onto one set of cards. That is how a
                                    project living in two working copies ends up as one card with a
                                    <span class="font-mono">dev</span> and a <span class="font-mono">demo</span>
                                    location: one rule per copy, both pointed at the same group.
                                    @if (SiblingRules.Count > 0)
                                    {
                                        <div class="ws-info-note">
                                            Sharing <strong>@selected.GroupName</strong> with
                                            @string.Join(", ", SiblingRules).
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="ws-section">
                    <h4 class="ws-section-title">Search path</h4>
                    <div class="ws-source-grid">
                        <div class="ws-field ws-span">
                            <div class="ws-label-row">
                                <label class="ws-label">Folder to scan</label>
                                @Info("path")
                            </div>
                            <div class="ws-input-row">
                                <input type="text" class="ws-input" @bind="selected.Path" @bind:event="oninput"
                                       @bind:after="SchedulePreview" placeholder="C:\path\to\workspaces" />
                                <button type="button" class="btn-secondary btn-sm" title="Browse for a folder"
                                        @onclick="BrowseForFolder">
                                    <i class="bi bi-folder2-open"></i>
                                </button>
                            </div>
                            @if (info == "path")
                            {
                                <div class="ws-info-box">
                                    The top of the search. Environment variables are expanded, so
                                    <span class="font-mono">%USERPROFILE%\source\repos</span> works and stays
                                    right on another machine.
                                </div>
                            }
                        </div>

                        <div class="ws-field">
                            <div class="ws-label-row">
                                <label class="ws-label">Pattern</label>
                                @Info("pattern")
                            </div>
                            <input type="text" class="ws-input" @bind="selected.Pattern" @bind:event="oninput"
                                   @bind:after="SchedulePreview" placeholder="*.code-workspace" />
                            <span class="ws-hint">Wildcards, not a regex.</span>
                            @if (info == "pattern")
                            {
                                <div class="ws-info-box">
                                    <span class="font-mono">*.sln</span> every solution ·
                                    <span class="font-mono">*.code-workspace</span> VS Code workspaces ·
                                    <span class="font-mono">*.Demo.slnf</span> only the demo solution filters ·
                                    <span class="font-mono">*</span> everything.
                                    <div class="ws-info-note">
                                        Selecting here beats selecting in the name pattern below: a file this
                                        does not match is never picked up at all, where a name pattern that
                                        does not match still produces a card under the whole name.
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="ws-field">
                            <label class="ws-label">Collect</label>
                            <select class="ws-input" value="@selected.Scan" @onchange="SetScan">
                                <option value="@nameof(ScanKind.Files)">Files matching the pattern</option>
                                <option value="@nameof(ScanKind.Directories)">Subfolders matching the pattern</option>
                            </select>
                        </div>

                        @* Both checkboxes on their own row. A bare checkbox sharing a grid row with a
                           labelled field either centres against the label or needs a magic top margin
                           to line up with the input, and there were two of them to line up. *@
                        <div class="ws-check-row ws-span">
                            <label class="ws-check">
                                <input type="checkbox" checked="@selected.Recursive" @onchange="ToggleRecursive" />
                                <span>Search subfolders too</span>
                            </label>

                            @* The nine names every recursive source wants, behind one checkbox. Typed
                               out, they buried the one exclusion that said something about the source
                               — a single solution to skip — in a line of boilerplate. *@
                            <label class="ws-check">
                                <input type="checkbox" checked="@selected.ExcludeCommon" @onchange="ToggleExcludeCommon" />
                                <span>Skip build output and VCS folders</span>
                            </label>
                            @Info("common")
                        </div>

                        @if (info == "common")
                        {
                            <div class="ws-info-box ws-span">
                                Adds <span class="font-mono">@string.Join(", ", WorkspaceSource.CommonExcludes)</span>.
                                <div class="ws-info-note">
                                    Worth having on for anything recursive: a website working copy is 78,000
                                    folders, of which 3,900 are not build output — and the preview below
                                    re-runs on every keystroke.
                                </div>
                            </div>
                        }

                        <div class="ws-field ws-span">
                            <div class="ws-label-row">
                                <label class="ws-label">@ExcludeLabel</label>
                                @Info("exclude")
                            </div>
                            <input type="text" class="ws-input" value="@ExcludeText" @oninput="SetExclude"
                                   placeholder="@ExcludePlaceholder" />
                            <span class="ws-hint">Whatever this source in particular should skip.</span>
                            @if (info == "exclude")
                            {
                                <div class="ws-info-box">
                                    Same wildcards as the pattern, checked against every folder and file name on
                                    the way down — an excluded folder is never opened rather than filtered out
                                    afterwards.
                                    <div class="ws-info-note">
                                        Files count too: <span class="font-mono">Account.sln</span> skips exactly
                                        that solution, which is how one rule takes the plain solutions and
                                        another takes the filters beside them.
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="ws-section">
                    <h4 class="ws-section-title">Location names</h4>
                    <p class="ws-section-note">
                        One card per file, unless a pattern folds several files into one card with a
                        location each.
                    </p>

                    @* The regex and what it runs against, on one line. They are one decision: a
                       pattern written for the name is nonsense against the path and vice versa, and
                       reading them apart is how you end up with a preview full of fallbacks. *@
                    <div class="ws-source-grid">
                        <div class="ws-field ws-span">
                            <div class="ws-label-row">
                                <label class="ws-label">Name pattern (optional regex)</label>
                                @Info("regex")
                            </div>

                            @* Nobody writes one of these from scratch; they start from the one that is
                               nearly right. Each preset fills the field and the match-against beside it,
                               and the preview updates as it lands — so picking one is how you find out
                               what it does, not something to be read first. *@
                            <div class="ws-preset-row">
                                <label class="ws-label ws-preset-label">Start from</label>
                                <select class="ws-input" value="@presetKey" @onchange="ApplyPreset">
                                    <option value="">a pattern…</option>
                                    @foreach (var preset in Presets)
                                    {
                                        <option value="@preset.Key">@preset.Label</option>
                                    }
                                </select>
                            </div>

                            <div class="ws-input-row">
                                <input type="text" class="ws-input" @bind="selected.NameRegex" @bind:event="oninput"
                                       @bind:after="OnRegexTyped" placeholder="@RegexPlaceholder" />
                                <select class="ws-input ws-input-fit" value="@selected.MatchOn" @onchange="SetMatchOn">
                                    <option value="@nameof(NameMatch.Name)">over the name</option>
                                    <option value="@nameof(NameMatch.RelativePath)">over the path</option>
                                </select>
                            </div>
                            <span class="ws-hint">
                                Capture <span class="font-mono">workspace</span> and
                                <span class="font-mono">location</span> to merge entries into one card.
                            </span>

                            @if (info == "regex")
                            {
                                <div class="ws-info-box">
                                    @if (selected.MatchOn == NameMatch.RelativePath)
                                    {
                                        <text>
                                            Run over the path below the folder above, extension kept:
                                            <span class="font-mono">demo\wwwroot\Checkout.sln</span>.
                                            <div class="ws-info-note">
                                                <span class="font-mono">^(?&lt;location&gt;[^\\]+)\\.*?(?&lt;workspace&gt;[^\\]+)\.[^.\\]+$</span>
                                                turns that into a <strong>Checkout</strong> card with a
                                                <span class="font-mono">demo</span> location. For trees where every
                                                leaf has the same name and only the branch folder tells them apart.
                                            </div>
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            Run over the entry's own name, extension dropped:
                                            <span class="font-mono">demo-checkout</span>.
                                            <div class="ws-info-note">
                                                <span class="font-mono">^(?&lt;location&gt;[^-]+)-(?&lt;workspace&gt;.+)$</span>
                                                turns <span class="font-mono">dev-checkout</span> and
                                                <span class="font-mono">demo-checkout</span> into one
                                                <strong>checkout</strong> card with two locations. Switch to
                                                <em>over the path</em> when the branch is a parent folder instead.
                                            </div>
                                        </text>
                                    }
                                    <div class="ws-info-note">
                                        The captures are coloured in the matches beside this, so you can read what
                                        the pattern grabbed rather than infer it from the card names.
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="ws-field">
                            <label class="ws-label">Location name when there is none</label>
                            <input type="text" class="ws-input" @bind="selected.DefaultLocationName" @bind:event="oninput"
                                   @bind:after="SchedulePreview" placeholder="main" />
                            <span class="ws-hint">The chip on a card the pattern gave no location.</span>
                        </div>
                    </div>
                </section>

                <section class="ws-section">
                    <h4 class="ws-section-title">Card appearance</h4>
                    <div class="ws-source-grid">
                        @* The button on the end of each field is the picker and the preview at the
                           same time. Typing "bi-window-stack" into a box told you nothing about
                           what you were going to get until you saved and rescanned — and there are
                           two thousand Bootstrap icon names to guess between. The text box stays,
                           because any of those names is valid and only a few dozen are in the
                           catalogue. *@
                        <div class="ws-field">
                            <label class="ws-label">Group icon</label>
                            <div class="ws-input-row">
                                <input type="text" class="ws-input" @bind="selected.Icon" @bind:event="oninput"
                                       placeholder="bi-window-stack" />
                                <button type="button" class="ws-swatch @(picker == IconPicker ? "is-on" : "")"
                                        title="Pick an icon" @onclick="() => TogglePicker(IconPicker)">
                                    <i class="bi @PreviewIcon" style="color: @PreviewColor"></i>
                                </button>
                            </div>
                            <span class="ws-hint">The card's own picker overrides it.</span>

                            @if (picker == IconPicker)
                            {
                                <div class="icon-grid">
                                    @foreach (var icon in IconService.Catalog)
                                    {
                                        <button type="button" title="@icon"
                                                class="icon-choice @(icon == selected.Icon ? "is-selected" : "")"
                                                @onclick="() => selected.Icon = icon">
                                            <i class="bi @icon"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="ws-field">
                            <label class="ws-label">Group colour</label>
                            <div class="ws-input-row">
                                <input type="text" class="ws-input" @bind="selected.Color" @bind:event="oninput"
                                       placeholder="#06b6d4" />
                                <button type="button" class="ws-swatch is-fill @(picker == ColorPicker ? "is-on" : "")"
                                        style="background-color: @PreviewColor"
                                        title="Pick a colour" @onclick="() => TogglePicker(ColorPicker)"></button>
                            </div>

                            @if (picker == ColorPicker)
                            {
                                <div class="color-row">
                                    @foreach (var color in IconService.Palette)
                                    {
                                        <button type="button" title="@color"
                                                class="color-choice @(string.Equals(color, selected.Color, StringComparison.OrdinalIgnoreCase) ? "is-selected" : "")"
                                                style="background-color: @color"
                                                @onclick="() => selected.Color = color"></button>
                                    }

                                    @* For the one that is not in the palette. Its value has to be a
                                       six-digit hex or the control silently shows black, so a blank
                                       or named colour falls back to the palette's first entry. *@
                                    <input type="color" class="ws-color-native" title="Any colour"
                                           value="@HexColor" @onchange="SetColorFromWheel" />
                                </div>
                            }
                        </div>

                        <div class="ws-field ws-span">
                            <div class="ws-label-row">
                                <label class="ws-label">Card subtitle from</label>
                                @Info("subtitle")
                            </div>
                            <input type="text" class="ws-input" value="@DescriptionFromText" @oninput="SetDescriptionFrom"
                                   placeholder="settings.description, folders" />
                            <span class="ws-hint">Blank skips reading file contents.</span>
                            @if (info == "subtitle")
                            {
                                <div class="ws-info-box">
                                    Dotted JSON paths, tried in order, read only from JSON/JSONC entries —
                                    <span class="font-mono">settings.description, folders</span>.
                                    <div class="ws-info-note">
                                        A path landing on an array shows a count, so
                                        <span class="font-mono">folders</span> renders as "16 folders".
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
        </div>

        @* ---- the matches, their own column ---------------------------------------- *@
        <div class="ws-matches">
            @if (selected is not null)
            {
                <div class="ws-preview">
                    <div class="ws-preview-head">
                        <span class="ws-label">
                            Matches
                            @if (previewBusy)
                            {
                                <i class="bi bi-hourglass-split"></i>
                            }
                        </span>
                        @if (preview is not null && preview.PathExists && preview.Error is null)
                        {
                            <span class="ws-preview-stats">
                                @preview.EntriesFound@(preview.Truncated ? "+" : "") found
                                <i class="bi bi-arrow-right-short"></i>
                                @preview.WorkspaceCount card@(preview.WorkspaceCount == 1 ? "" : "s"),
                                @preview.LocationCount location@(preview.LocationCount == 1 ? "" : "s")
                                in <strong>@preview.GroupName</strong>
                            </span>
                        }
                    </div>

                    @* Iterate to zero. With 40 entries the three that fell through are the only
                       ones worth looking at, and they are scattered down the list. *@
                    @if (preview is not null && preview.Unmatched.Count > 0)
                    {
                        <label class="ws-check ws-only-unmatched">
                            <input type="checkbox" checked="@onlyUnmatched"
                                   @onchange="e => onlyUnmatched = (bool?)e.Value ?? false" />
                            <span>Only the @preview.Unmatched.Count the pattern missed</span>
                        </label>
                    }

                    @if (preview is null)
                    {
                        <div class="ws-preview-empty">Working it out…</div>
                    }
                    else if (preview.Error is not null)
                    {
                        <div class="ws-scan-note is-error">Could not read that folder: @preview.Error</div>
                    }
                    else if (!preview.PathExists)
                    {
                        <div class="ws-scan-note is-error">
                            Folder not found:
                            <span class="font-mono">@(string.IsNullOrEmpty(preview.ResolvedPath) ? selected.Path : preview.ResolvedPath)</span>
                        </div>
                    }
                    else
                    {
                        @if (preview.RegexError is not null)
                        {
                            @* The scan does not fail on a bad regex, it ignores it — which used to be
                               indistinguishable from a regex that matched nothing. *@
                            <div class="ws-scan-note is-error">
                                Name pattern ignored, it is not a valid regex: @preview.RegexError
                            </div>
                        }

                        @* No total: the walk stops at the cap rather than counting the rest, so
                           there is no honest "of N" to put here. *@
                        @if (preview.Truncated)
                        {
                            <div class="ws-scan-note">
                                Showing the first @preview.Workspaces.Sum(w => w.Locations.Count) entries — there
                                are more. A real scan takes all of them.
                            </div>
                        }

                        @if (preview.Workspaces.Count == 0)
                        {
                            <div class="ws-preview-empty">
                                Nothing in <span class="font-mono">@preview.ResolvedPath</span> matches
                                <span class="font-mono">@(string.IsNullOrWhiteSpace(selected.Pattern) ? "*" : selected.Pattern)</span>.
                            </div>
                        }
                        else
                        {
                            <div class="ws-preview-tree">
                                @foreach (var workspace in VisibleWorkspaces)
                                {
                                    <div class="ws-preview-ws">
                                        <div class="ws-preview-ws-head">
                                            <i class="bi bi-code-square"></i>
                                            <span class="ws-preview-ws-name">@workspace.Name</span>
                                            <span class="ws-group-meta">@workspace.Locations.Count</span>
                                        </div>
                                        @foreach (var location in workspace.Locations)
                                        {
                                            <div class="ws-preview-loc @(location.RegexMatched ? "" : "is-fallback")">
                                                <span class="ws-chip">@location.Name</span>

                                                @* The string the pattern was handed, with the captures
                                                   coloured where they landed. This is the difference
                                                   between reading what the pattern did and inferring
                                                   it backwards from the card names it produced. *@
                                                <span class="ws-capture" title="@location.Path">
                                                    @foreach (var segment in location.Segments)
                                                    {
                                                        <span class="@CaptureClass(segment.Role)">@segment.Text</span>
                                                    }
                                                </span>

                                                @if (!string.IsNullOrWhiteSpace(location.Description))
                                                {
                                                    <span class="ws-preview-loc-desc">@location.Description</span>
                                                }
                                                @if (!location.RegexMatched)
                                                {
                                                    <span class="ws-chip is-warn" title="The name pattern did not match, so the whole name became the card">
                                                        no match
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            @if (preview.Unmatched.Count > 0 && !onlyUnmatched)
                            {
                                <div class="ws-scan-note">
                                    @preview.Unmatched.Count entries did not match the name pattern and
                                    became a card each.
                                </div>
                            }

                            @if (LegendVisible)
                            {
                                <div class="ws-capture-legend">
                                    <span class="is-workspace">workspace</span>
                                    <span class="is-location">location</span>
                                    <span>not captured</span>
                                </div>
                            }
                        }
                    }
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="ws-error mt-3">@error</div>
    }

    @* Pinned to the bottom of the scrolling body. Both buttons used to follow the
       last source, so with a few sources configured they sat below the fold — and
       the panel itself could not scroll, which made Save unreachable outright. *@
    <div class="ws-sources-actions">
        <span class="ws-hint">Nothing is written until you save. Closing this discards the edits.</span>
        <button type="button" class="btn-primary" @onclick="Save">
            <i class="bi bi-check-lg"></i> Save and rescan
        </button>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>
    /// Source to open on, by name. Set when the dialog is opened from a scanned group's context
    /// menu; null opens on the first source, which is what the toolbar button wants.
    /// </summary>
    [Parameter] public string? InitialSourceName { get; set; }

    /// <summary>Left column collapsed to a rail, once you are working on one folder.</summary>
    private bool listCollapsed;

    /// <summary>Show only the entries the pattern missed, so you can iterate to zero.</summary>
    private bool onlyUnmatched;

    /// <summary>Which preset the dropdown shows. Cleared as soon as the regex is hand-edited.</summary>
    private string presetKey = string.Empty;

    /// <summary>
    /// Which field's example is showing, or null. One at a time: they are the length of a
    /// paragraph, and all of them open at once is the wall of prose these replaced.
    /// </summary>
    private string? info;

    private void ToggleInfo(string key) => info = info == key ? null : key;

    /// <summary>Which of the two appearance pickers is open, or null. One at a time.</summary>
    private string? picker;

    // Named rather than written inline, because Razor cannot parse a double-quoted string literal
    // inside a double-quoted attribute value: @onclick="() => TogglePicker("icon")" ends the
    // attribute at the second quote and hands TogglePicker no arguments at all.
    private const string IconPicker = "icon";
    private const string ColorPicker = "color";

    private void TogglePicker(string key) => picker = picker == key ? null : key;

    /// <summary>
    /// What the swatch shows. The group default rather than nothing when the field is blank, since
    /// blank is not "no icon" — it is "whatever the dashboard would pick".
    /// </summary>
    private string PreviewIcon =>
        string.IsNullOrWhiteSpace(selected?.Icon) ? "bi-folder2" : selected!.Icon!;

    private string PreviewColor =>
        string.IsNullOrWhiteSpace(selected?.Color) ? "rgb(var(--c-text-muted))" : selected!.Color!;

    /// <summary>
    /// The colour field as a six-digit hex, which is the only thing <c>input type=color</c>
    /// accepts — anything else and it silently shows black, which reads as "the colour is black".
    /// </summary>
    private string HexColor
    {
        get
        {
            var value = selected?.Color?.Trim();

            return value is not null
                   && System.Text.RegularExpressions.Regex.IsMatch(value, "^#[0-9a-fA-F]{6}$")
                ? value
                : IconService.Palette.FirstOrDefault() ?? "#3b82f6";
        }
    }

    private void SetColorFromWheel(ChangeEventArgs e)
    {
        if (selected is not null)
        {
            selected.Color = e.Value?.ToString();
        }
    }

    /// <summary>
    /// A starting pattern, and what to run it against. Most people never write one of these from
    /// scratch — they start from the one that is nearly right and adjust it, which is what these
    /// are for. Deliberately a short list of shapes that actually occur in this codebase rather
    /// than a regex tutorial.
    /// </summary>
    private sealed record Preset(string Key, string Label, string? Regex, NameMatch MatchOn);

    private static readonly Preset[] Presets =
    {
        new("none", "No pattern — one card per file", null, NameMatch.Name),

        new("prefix", "dev-thing, demo-thing → prefix is the location",
            @"^(?<location>[^-]+)-(?<workspace>.+)$", NameMatch.Name),

        new("suffix", "Thing.dev, Thing.demo → suffix is the location",
            @"^(?<workspace>.+)\.(?<location>[^.]+)$", NameMatch.Name),

        new("branchfolder", "development\\…\\Thing.sln → the branch folder is the location",
            @"^(?<location>[^\\]+)\\.*?(?<workspace>[^\\]+)\.[^.\\]+$", NameMatch.RelativePath),

        new("dropsuffix", "Thing.Development.slnf → drop the suffix, keep Thing",
            @"^(?<workspace>.+)\.[^.]+$", NameMatch.Name),

        new("folder", "…\\Thing\\anything.sln → the parent folder is the card",
            @"(?<workspace>[^\\]+)\\[^\\]+$", NameMatch.RelativePath),
    };

    private WorkspaceSourceConfig? config;
    private WorkspaceSource? selected;
    private string? error;

    private SourcePreview? preview;
    private bool previewBusy;

    /// <summary>Cancels the in-flight preview when another edit lands on top of it.</summary>
    private CancellationTokenSource? previewCts;

    /// <summary>
    /// How long an edit has to settle before the folder is read. Long enough that typing a path
    /// does not scan every prefix of it, short enough to feel like it is keeping up.
    /// </summary>
    private const int PreviewDebounceMs = 250;

    /// <summary>The "Default Workspace Location" from Settings, used as the path a new row starts on.</summary>
    private string defaultLocation = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        defaultLocation = (await UiSettings.GetAsync()).DefaultWorkspaceLocation;
        await LoadAsync();
    }

    /// <summary>Re-reads config so the dialog never shows edits abandoned last time it was open.</summary>
    public async Task LoadAsync()
    {
        error = null;
        var stored = await SourceService.GetConfigAsync();

        // Edit a copy: closing the dialog without saving must leave the live config alone.
        config = new WorkspaceSourceConfig
        {
            Sources = stored.Sources.Select(Clone).ToList()
        };

        // The source the caller asked for, else the first. Falls back rather than showing nothing
        // when the name no longer matches anything — the group was scanned by a source that has
        // since been renamed or removed, and an empty editor would look like a bug.
        selected = config.Sources.FirstOrDefault(
                       s => s.Name.Equals(InitialSourceName, StringComparison.OrdinalIgnoreCase))
                   ?? config.Sources.FirstOrDefault();

        SchedulePreview();
        StateHasChanged();
    }

    public void Dispose()
    {
        previewCts?.Cancel();
        previewCts?.Dispose();
    }

    private void Select(WorkspaceSource source)
    {
        selected = source;
        preview = null;

        // Per-source view state. The unmatched filter especially: carrying it to a folder that has
        // no unmatched entries would show an empty column and no reason why.
        onlyUnmatched = false;
        presetKey = string.Empty;
        info = null;
        picker = null;

        SchedulePreview();
    }

    // ---- the pattern helpers ---------------------------------------------------------------

    /// <summary>
    /// Fills the pattern from a preset, and the match-against with it — the two are one decision,
    /// and a pattern written for the name is nonsense against the path.
    /// </summary>
    private void ApplyPreset(ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? string.Empty;
        presetKey = key;

        if (selected is null || key.Length == 0)
        {
            return;
        }

        var preset = Presets.FirstOrDefault(p => p.Key == key);
        if (preset is null)
        {
            return;
        }

        selected.NameRegex = preset.Regex;
        selected.MatchOn = preset.MatchOn;
        SchedulePreview();
    }

    /// <summary>
    /// Typing in the pattern box drops the preset label: what is in the field is no longer the
    /// preset, and a dropdown still naming it would be lying about the state of the form.
    /// </summary>
    private void OnRegexTyped()
    {
        presetKey = string.Empty;
        SchedulePreview();
    }

    /// <summary>
    /// The cards shown, filtered to the ones with an entry the pattern missed when that toggle is
    /// on. Filtered here rather than in the service: it is a way of looking at one preview, not a
    /// different preview.
    /// </summary>
    private List<PreviewWorkspace> VisibleWorkspaces
    {
        get
        {
            if (preview is null)
            {
                return new List<PreviewWorkspace>();
            }

            if (!onlyUnmatched)
            {
                return preview.Workspaces;
            }

            return preview.Workspaces
                .Select(w => new PreviewWorkspace
                {
                    Name = w.Name,
                    Locations = w.Locations.Where(l => !l.RegexMatched).ToList()
                })
                .Where(w => w.Locations.Count > 0)
                .ToList();
        }
    }

    private static string CaptureClass(CaptureRole role) => role switch
    {
        CaptureRole.Workspace => "ws-cap is-workspace",
        CaptureRole.Location => "ws-cap is-location",
        _ => "ws-cap"
    };

    /// <summary>
    /// The legend is only worth the space once there is something coloured to explain.
    /// </summary>
    private bool LegendVisible => !string.IsNullOrWhiteSpace(selected?.NameRegex)
                                  && preview?.RegexError is null;

    /// <summary>What the list shows for a source, including one that has not been named yet.</summary>
    private static string DisplayName(WorkspaceSource source) =>
        string.IsNullOrWhiteSpace(source.Name) ? "(unnamed)" : source.Name;

    /// <summary>
    /// One line under each name in the list. The selected source reports from the live preview;
    /// the others from the last real scan, which is the most recent thing known about them.
    /// </summary>
    private string Summary(WorkspaceSource source)
    {
        if (!source.Enabled)
        {
            return "disabled";
        }

        if (ReferenceEquals(source, selected) && preview is not null)
        {
            if (preview.Error is not null) return "failed";
            if (!preview.PathExists) return "folder not found";

            // The preview stops at its entry cap, so on a big source this is a floor, not a count.
            // Saying "200 cards" beside a scan that found 380 reads as a disagreement rather than
            // as a sample.
            var more = preview.Truncated ? "+" : string.Empty;
            return $"{preview.WorkspaceCount}{more} card{(preview.WorkspaceCount == 1 ? "" : "s")}";
        }

        var scan = SourceService.LastScan.FirstOrDefault(r => r.SourceName == source.Name);
        if (scan is null)
        {
            return string.IsNullOrWhiteSpace(source.Pattern) ? "*" : source.Pattern;
        }

        if (scan.Error is not null) return "failed";
        if (!scan.PathExists) return "folder not found";
        return $"{scan.WorkspacesProduced} card{(scan.WorkspacesProduced == 1 ? "" : "s")}";
    }

    // ---- preview ---------------------------------------------------------------------------

    /// <summary>
    /// Debounced. Every keystroke cancels the previous attempt, so a path typed one character at
    /// a time results in one scan rather than one per character — and the token also stops a slow
    /// scan of an abandoned path from overwriting the results of the current one.
    /// </summary>
    private void SchedulePreview()
    {
        previewCts?.Cancel();
        previewCts?.Dispose();
        previewCts = null;

        if (selected is null)
        {
            preview = null;
            previewBusy = false;
            return;
        }

        var cts = new CancellationTokenSource();
        previewCts = cts;

        previewBusy = true;
        _ = RunPreviewAsync(Clone(selected), cts.Token);
    }

    /// <summary>
    /// Runs against a copy of the source. The scan happens on a thread pool thread while the UI
    /// thread is still taking keystrokes, and reading half-typed fields out from under it is a
    /// race with no upside.
    /// </summary>
    private async Task RunPreviewAsync(WorkspaceSource snapshot, CancellationToken token)
    {
        try
        {
            await Task.Delay(PreviewDebounceMs, token);

            var result = await SourceService.PreviewAsync(snapshot, token);

            token.ThrowIfCancellationRequested();

            preview = result;
            previewBusy = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a later edit. The one that superseded it owns the busy flag now.
        }
        catch (Exception ex)
        {
            preview = new SourcePreview { Error = ex.Message, GroupName = snapshot.GroupName };
            previewBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ---- editing ---------------------------------------------------------------------------

    private void Add()
    {
        if (config is null)
        {
            return;
        }

        var source = new WorkspaceSource
        {
            Name = "New source",
            Pattern = "*.code-workspace",

            // A new row starts at the default workspace location, which is nearly always the
            // parent of whatever is about to be scanned. Empty when no default is set, and the
            // placeholder says what belongs there.
            Path = defaultLocation,
            DefaultLocationName = "workspace",

            // On by default for anything new. The model defaults it off so a config written
            // before the flag existed scans exactly what it always scanned, but there is no
            // version of "a folder I just added" that wants to walk bin and obj.
            ExcludeCommon = true
        };

        config.Sources.Add(source);
        Select(source);
    }

    private void Remove(WorkspaceSource source)
    {
        config?.Sources.Remove(source);

        if (ReferenceEquals(source, selected))
        {
            selected = config?.Sources.FirstOrDefault();
            preview = null;
            SchedulePreview();
        }
    }

    private void ToggleEnabled(ChangeEventArgs e)
    {
        if (selected is not null)
        {
            selected.Enabled = (bool?)e.Value ?? false;
        }
    }

    private void ToggleRecursive(ChangeEventArgs e)
    {
        if (selected is null)
        {
            return;
        }

        selected.Recursive = (bool?)e.Value ?? false;
        SchedulePreview();
    }

    private void SetScan(ChangeEventArgs e)
    {
        if (selected is not null && Enum.TryParse<ScanKind>(e.Value?.ToString(), ignoreCase: true, out var kind))
        {
            selected.Scan = kind;
            SchedulePreview();
        }
    }

    private void SetMatchOn(ChangeEventArgs e)
    {
        if (selected is not null && Enum.TryParse<NameMatch>(e.Value?.ToString(), ignoreCase: true, out var match))
        {
            selected.MatchOn = match;
            SchedulePreview();
        }
    }

    /// <summary>An example of the right shape for whichever string the regex is being run against.</summary>
    private string RegexPlaceholder => selected?.MatchOn == NameMatch.RelativePath
        ? @"^(?<location>[^\\]+)\\.*\\(?<workspace>[^\\]+)\.sln$"
        : "^(?<location>dev|demo)-(?<workspace>.+)$";

    private string ExcludeText =>
        selected is null ? string.Empty : string.Join(", ", selected.Exclude);

    /// <summary>
    /// "Also skip" once the common ones are on, because the box is then the second half of a
    /// list rather than the whole of it.
    /// </summary>
    private string ExcludeLabel =>
        selected?.ExcludeCommon == true ? "Also skip these" : "Skip these folders";

    private string ExcludePlaceholder =>
        selected?.ExcludeCommon == true ? "Account.sln, LegacyTools" : "bin, obj, node_modules, .vs, .git";

    private void SetExclude(ChangeEventArgs e)
    {
        if (selected is null)
        {
            return;
        }

        selected.Exclude = (e.Value?.ToString() ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        SchedulePreview();
    }

    /// <summary>
    /// Ticking the box also clears whichever common names were typed into the manual box, so the
    /// two never say the same thing twice — the point of the checkbox is that the manual box goes
    /// back to holding only what is particular to this source. Unticking does not put them back:
    /// the box is not a store, and re-adding nine names nobody asked for would be worse.
    /// </summary>
    private void ToggleExcludeCommon(ChangeEventArgs e)
    {
        if (selected is null)
        {
            return;
        }

        selected.ExcludeCommon = (bool?)e.Value ?? false;

        if (selected.ExcludeCommon)
        {
            selected.Exclude = selected.Exclude
                .Where(x => !WorkspaceSource.CommonExcludes.Contains(x, StringComparer.OrdinalIgnoreCase))
                .ToList();
        }

        SchedulePreview();
    }

    /// <summary>
    /// What the group field shows when it is blank: the name it would fall back to, rather than a
    /// sentence explaining that it falls back.
    /// </summary>
    private string GroupPlaceholder =>
        string.IsNullOrWhiteSpace(selected?.Name) ? "Same as the name" : selected!.Name;

    /// <summary>
    /// The other rules landing on this rule's group. Four rules feeding one card is the intended
    /// arrangement here, and it was invisible from inside the rule doing it.
    /// </summary>
    private List<string> SiblingRules
    {
        get
        {
            if (config is null || selected is null)
            {
                return new List<string>();
            }

            return config.Sources
                .Where(s => !ReferenceEquals(s, selected)
                            && s.GroupName.Equals(selected.GroupName, StringComparison.OrdinalIgnoreCase))
                .Select(DisplayName)
                .ToList();
        }
    }

    private string DescriptionFromText =>
        selected is null ? string.Empty : string.Join(", ", selected.DescriptionFrom);

    private void SetDescriptionFrom(ChangeEventArgs e)
    {
        if (selected is null)
        {
            return;
        }

        selected.DescriptionFrom = (e.Value?.ToString() ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        SchedulePreview();
    }

    private void BrowseForFolder()
    {
        if (selected is null)
        {
            return;
        }

        try
        {
            using var dialog = new System.Windows.Forms.FolderBrowserDialog
            {
                Description = "Folder to scan for projects",
                UseDescriptionForTitle = true,
                ShowNewFolderButton = false,
                RootFolder = Environment.SpecialFolder.MyComputer
            };

            var current = Environment.ExpandEnvironmentVariables(selected.Path?.Trim() ?? string.Empty);
            if (current.Length > 0 && Directory.Exists(current))
            {
                dialog.SelectedPath = current;
            }

            if (dialog.ShowDialog() != System.Windows.Forms.DialogResult.OK)
            {
                return;
            }

            selected.Path = dialog.SelectedPath;
            SchedulePreview();
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            // No native window to parent to — the browser-hosted view. The field is still typeable.
            error = $"Could not open the folder picker: {ex.Message}";
        }
    }

    private async Task Save()
    {
        if (config is null)
        {
            return;
        }

        var named = config.Sources.Where(s => !string.IsNullOrWhiteSpace(s.Name)).ToList();
        if (named.Count != config.Sources.Count)
        {
            error = "Every source needs a name.";
            return;
        }

        if (named.GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1))
        {
            error = "Source names must be unique.";
            return;
        }

        error = null;
        await SourceService.SaveConfigAsync(config);
        await OnSaved.InvokeAsync();
    }

    private static WorkspaceSource Clone(WorkspaceSource s) => new()
    {
        Name = s.Name,
        Enabled = s.Enabled,
        Path = s.Path,
        Pattern = s.Pattern,
        Scan = s.Scan,
        Recursive = s.Recursive,
        ExcludeCommon = s.ExcludeCommon,
        Exclude = new List<string>(s.Exclude),
        Group = s.Group,
        Icon = s.Icon,
        Color = s.Color,
        NameRegex = s.NameRegex,
        MatchOn = s.MatchOn,
        DefaultLocationName = s.DefaultLocationName,
        DescriptionFrom = new List<string>(s.DescriptionFrom),
        OpenWith = s.OpenWith
    };
}
