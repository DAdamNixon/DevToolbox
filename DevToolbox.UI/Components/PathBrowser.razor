@using System.Windows.Forms
@using System.IO

<div class="space-y-2">
    <div class="flex space-x-2">
        <input type="text" class="input-modern flex-1" 
                value="@SelectedPath" 
                readonly 
                placeholder="Select a path..."
                @onclick="OpenFileBrowser" />

        @if (isFileSelector)
        {
            <button class="btn-secondary px-3" @onclick="OpenFileBrowser" title="Select a file">
                <i class="bi bi-file-earmark"></i>
            </button>
        }

        @if (isFolderSelector)
        {
            <button class="btn-secondary px-3" @onclick="OpenFolderBrowser" title="Select a folder">
                <i class="bi bi-folder2"></i>
            </button>
        }
    </div>
    
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4 flex items-start justify-between">
            <div class="flex items-start space-x-3">
                <i class="bi bi-exclamation-triangle text-red-400"></i>
                <span class="text-red-300 text-sm">@ErrorMessage</span>
            </div>
            <button type="button" class="btn-ghost p-1" @onclick="() => ErrorMessage = string.Empty">
                <i class="bi bi-x text-red-400"></i>
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public string SelectedPath { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnPathSelected { get; set; }

    [Parameter]
    public string Filter { get; set; } = "All Files (*.*)|*.*";

    [Parameter]
    public bool isFileSelector { get; set; } = true;

    [Parameter]
    public bool isFolderSelector { get; set; } = true;

    /// <summary>
    /// Where to open when nothing has been picked yet — the "Default Workspace Location" from
    /// Settings. Only ever a starting point: an unset or unreachable value falls back to the
    /// dialog's own default, which is what every picker did before.
    /// </summary>
    [Parameter]
    public string? StartIn { get; set; }

    private string ErrorMessage { get; set; } = string.Empty;

    /// <summary>
    /// The folder a dialog should open on: what is already selected, else the configured default.
    /// Checked for existence here so a stale path costs nothing — passing a missing directory to
    /// FolderBrowserDialog silently drops it, and to OpenFileDialog it lands you somewhere
    /// unrelated.
    /// </summary>
    private string? StartingDirectory()
    {
        var candidates = new[]
        {
            Directory.Exists(SelectedPath) ? SelectedPath : Path.GetDirectoryName(SelectedPath),
            StartIn
        };

        foreach (var candidate in candidates)
        {
            if (!string.IsNullOrWhiteSpace(candidate) && Directory.Exists(candidate)) return candidate;
        }

        return null;
    }

    private async Task OpenFileBrowser()
    {
        try
        {
            using var dialog = new OpenFileDialog
            {
                Title = "Select a file",
                Filter = Filter,
                CheckFileExists = true,
                CheckPathExists = true,
                InitialDirectory = StartingDirectory() ?? Environment.GetFolderPath(Environment.SpecialFolder.MyComputer)
            };

            if (dialog.ShowDialog() == DialogResult.OK)
            {
                await OnPathSelected.InvokeAsync(dialog.FileName);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error selecting file: {ex.Message}";
        }
    }

    private async Task OpenFolderBrowser()
    {
        try
        {
            using var dialog = new FolderBrowserDialog
            {
                Description = "Select a folder",
                UseDescriptionForTitle = true,
                ShowNewFolderButton = true,
                RootFolder = Environment.SpecialFolder.MyComputer
            };

            // What is already selected, else the configured default workspace location.
            if (StartingDirectory() is { } initialDir)
            {
                dialog.SelectedPath = initialDir;
            }

            if (dialog.ShowDialog() == DialogResult.OK)
            {
                await OnPathSelected.InvokeAsync(dialog.SelectedPath);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error selecting folder: {ex.Message}";
        }
    }
}