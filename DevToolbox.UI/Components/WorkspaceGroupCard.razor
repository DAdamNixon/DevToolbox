@using DevToolbox.UI.Components
@using DevToolbox.Services.Models
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Services
@using DevToolbox.UI.Services
@using DevToolbox.UI.Models
@using Microsoft.JSInterop
@using DevToolbox.UI.Components.Dialogs
@inject IJSRuntime JS
@inject CardStateService CardStateService
@inject MenuStateService Menu
@inject ViewModelFactory ViewModelFactory
@inject ModalStateService ModalStateService
@inject IIconService IconService
@inject IDashboardLayoutService Layout
@inject ISystemService SystemService
@implements IDisposable

@* Same as WorkspaceCard: the whole card is the target, and the regions that must not collapse it
   — the grip, the actions menu and the workspace grid — stop the click themselves.

   The drop handlers sit on the card rather than on a thin strip between cards. A gap you have to
   hit is a gap you miss, and "drop onto the card that should end up below you" is a rule that
   needs no target at all. dragover has to preventDefault or the browser refuses the drop. *@
@* Right-click anywhere on the row opens the same menu the ⋮ does, at the cursor. A group card is
   the full width of the window, so the ⋮ is a long way from wherever you happen to be pointing —
   and it is the one target on this screen you have to aim for. data-menu-anchor covers the card so
   menu.js's document listener leaves the right-click alone; see the chips in WorkspaceCard. *@
<div class="glow-card ws-group-card cursor-pointer @GroupStateClass"
     data-drag-card
     data-menu-anchor
     @onclick="ToggleExpand"
     @oncontextmenu="OpenContextMenu"
     @oncontextmenu:preventDefault="true"
     @ondragover:preventDefault="true"
     @ondragenter:preventDefault="true"
     @ondragover="() => OnDragEntered.InvokeAsync(GroupViewModel.Name)"
     @ondrop:preventDefault="true"
     @ondrop="() => OnDropped.InvokeAsync(GroupViewModel.Name)">
    <!-- Card Header -->
    <div class="ws-group-header">
        <div class="ws-group-title">
            @* draggable lives on the grip, not the card: the card is a click target for expanding,
               and a draggable card turns every one of those clicks into a half-started drag. *@
            <span class="ws-grip"
                  draggable="true"
                  data-drag-handle="@GroupViewModel.Name"
                  title="Drag to reorder"
                  @onclick:stopPropagation="true"
                  @ondragstart="() => OnDragStarted.InvokeAsync(GroupViewModel.Name)"
                  @ondragend="() => OnDragEnded.InvokeAsync()">
                <i class="bi bi-grip-vertical"></i>
            </span>

            <i class="bi @(GroupViewModel.IsExpanded ? "bi-chevron-down" : "bi-chevron-right") ws-chev"></i>
            <i class="bi @icon.Icon ws-icon" style="color: @icon.Color"></i>
            <h3 class="ws-group-name" title="@TitleTooltip">@GroupViewModel.Name</h3>
            <span class="ws-group-meta">@GroupViewModel.Workspaces.Count</span>
            @if (PinnedCount > 0)
            {
                <span class="ws-group-meta" title="@PinnedCount pinned">
                    <i class="bi bi-star-fill"></i> @PinnedCount
                </span>
            }
            @* The rule count, because a group fed by four smart folders looked exactly like one fed
               by a single folder — and four is the shape you end up with deliberately, once a
               project lives in two working copies with a solution filter in each. *@
            @if (IsFromSource)
            {
                <span class="ws-badge" title="@SourceTooltip">
                    <i class="bi bi-arrow-repeat"></i>
                    scanned · @RuleCount rule@(RuleCount == 1 ? "" : "s")
                </span>
            }

            @* Only ever visible while the toolbar's "hidden" toggle is on, since a hidden card is
               otherwise not rendered at all. *@
            @if (IsHidden)
            {
                <span class="ws-badge is-hidden-badge" title="Hidden from the dashboard">
                    <i class="bi bi-eye-slash"></i> hidden
                </span>
            }
        </div>

        <!-- Actions Menu -->
        <div class="ws-actions">
            <div class="ws-menu-anchor" data-menu-anchor @onclick:stopPropagation="true">
                <button type="button"
                    class="btn-ghost ws-icon-btn"
                    title="Group actions"
                    @onclick="ToggleActionsMenu">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>

                @if (Menu.IsOpen(GroupMenuId))
                {
                    @* One menu, two positions. Opened from the ⋮ it hangs off this anchor; opened
                       by right-click it is fixed at the cursor, which for a full-width card is
                       nowhere near the anchor. js/dashboard.js keeps either one on screen. *@
                    <div class="ws-menu @(atCursor ? "is-at-cursor" : "")"
                         style="@(atCursor ? $"left:{cursorX}px;top:{cursorY}px" : null)">
                        <button class="dropdown-item" @onclick="ShowIconModal">
                            <i class="bi bi-palette"></i>
                            <span>Change Icon</span>
                        </button>
                        <button class="dropdown-item" @onclick="ShowAliasModal">
                            <i class="bi bi-tags"></i>
                            <span>Search Aliases@(aliases.Count > 0 ? $" ({aliases.Count})" : "")</span>
                        </button>

                        @* Not in the danger block with Delete, and deliberately not next to it: the
                           whole point of hiding is that it is the reversible thing to reach for
                           instead. The toolbar keeps a count of what is hidden. *@
                        <button class="dropdown-item" @onclick="ToggleHidden">
                            <i class="bi @(IsHidden ? "bi-eye" : "bi-eye-slash")"></i>
                            <span>@(IsHidden ? "Show on Dashboard" : "Hide Group")</span>
                        </button>

                        @if (IsFromSource)
                        {
                            <div class="ws-menu-sep"></div>
                            <button class="dropdown-item" @onclick="EditSource">
                                <i class="bi bi-sliders"></i>
                                <span>Smart Folder Settings…</span>
                            </button>
                            <button class="dropdown-item" @onclick="Rescan">
                                <i class="bi bi-arrow-repeat"></i>
                                <span>Rescan Source</span>
                            </button>
                            <button class="dropdown-item" @onclick="OpenSourceFolder">
                                <i class="bi bi-folder2-open"></i>
                                <span>Open Source Folder</span>
                            </button>
                        }
                        else
                        {
                            <div class="ws-menu-sep"></div>
                            <button class="dropdown-item" @onclick="ShowAddWorkspaceModal">
                                <i class="bi bi-plus-circle"></i>
                                <span>Add Workspace</span>
                            </button>
                            <button class="dropdown-item" @onclick="ShowRenameModal">
                                <i class="bi bi-pencil"></i>
                                <span>Rename</span>
                            </button>
                            <div class="ws-menu-sep"></div>
                            <button class="dropdown-item danger" @onclick="OnDelete">
                                <i class="bi bi-trash"></i>
                                <span>Delete Group</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Card Body - Workspace Grid -->
    @if (GroupViewModel.IsExpanded)
    {
        @* contextmenu stops here too, or a right-click aimed at a workspace card would open the
           group's menu — the group card is underneath every one of them. *@
        <div class="ws-grid" @onclick:stopPropagation="true" @oncontextmenu:stopPropagation="true">
            @foreach (var workspaceViewModel in GroupViewModel.Workspaces)
            {
                <WorkspaceCard
                    @key="workspaceViewModel.StateKey"
                    WorkspaceViewModel="workspaceViewModel"
                    GlobalOptions="GlobalOptions"
                    AvailableScripts="AvailableScripts"
                    AvailableGroups="AllGroups.Where(g => g.Name != GroupViewModel.Name).ToList()"
                    AllGroups="AllGroups"
                    IsReadOnly="IsFromSource"
                    IsPinned="Layout.IsPinned(GroupViewModel.Name, workspaceViewModel.Name)"
                    QuickOpenCount="QuickOpenCount"
                    OnDeleteWorkspace="() => DeleteWorkspace(workspaceViewModel.Workspace)"
                    OnOpenWorkspaceLocation="OnOpenWorkspaceLocation"
                    OnOpenInExplorer="OnOpenInExplorer"
                    OnOpenInTerminal="OnOpenInTerminal"
                    OnOpenWithCustomApp="OnOpenWithCustomApp"
                    OnRunScriptOnLocation="OnRunScriptOnLocation"
                    OnAddLocation="SaveWorkspaces"
                    OnMoveToGroup="HandleMoveToGroup"
                    OnRename="OnAddWorkspace"
                    OnIconChanged="OnIconChanged"
                    OnTogglePin="() => OnTogglePin.InvokeAsync((GroupViewModel.Name, workspaceViewModel.Name))"
                    OnAliasesChanged="OnAliasesChanged" />
            }

            @if (IsFromSource)
            {
                @if (!GroupViewModel.Workspaces.Any())
                {
                    <div class="ws-empty">
                        Nothing matched this source's pattern.
                        Check the folder and pattern under <strong>Smart Folders</strong>.
                    </div>
                }
            }
            else
            {
                @* Was a tile the height of a real card with a 2xl icon centred in it, which made
                   the last row of every group half empty. It is one row now. *@
                <button type="button" class="ws-add-tile" @onclick="ShowAddWorkspaceModal">
                    <i class="bi bi-plus-circle"></i>
                    <span>Add Workspace</span>
                </button>
            }
        </div>
    }
</div>

<Modal @bind-IsVisible="IsAddWorkspaceModalVisible" Title="@AddWorkspaceModalTitle">
    <AddWorkspaceDialog
        WorkspaceName="@NewWorkspaceName"
        WorkspaceNameChanged="(name) => NewWorkspaceName = name"
        ErrorMessage="@GetModalError(AddWorkspaceModalKey)"
        ErrorMessageChanged="(msg) => ModalStateService.SetError(AddWorkspaceModalKey, msg)"
        GroupName="@GroupViewModel.Name"
        AllWorkspaces="AllWorkspaces"
        GroupWorkspaces="GroupViewModel.Group.Workspaces"
        OnWorkspaceCreated="HandleWorkspaceCreated" />
</Modal>

<Modal @bind-IsVisible="IsRenameModalVisible" Title="Rename Group">
    <RenameGroupDialog @ref="renameGroupDialog"
        GroupName="@NewGroupName"
        GroupNameChanged="(name) => NewGroupName = name"
        ErrorMessage="@GetModalError(RenameModalKey)"
        ErrorMessageChanged="(msg) => ModalStateService.SetError(RenameModalKey, msg)"
        Group="GroupViewModel.Group"
        AllGroups="AllGroups"
        OnRenameCompleted="HandleRenameCompleted" />
</Modal>

<Modal @bind-IsVisible="IsIconModalVisible" Title="@IconModalTitle">
    <IconPickerDialog @ref="iconPicker"
        Scope="IconScope.Group"
        Name="@GroupViewModel.Name"
        Current="icon"
        OnSaved="HandleIconSaved" />
</Modal>

<Modal @bind-IsVisible="IsAliasModalVisible" Title="@AliasModalTitle">
    <AliasDialog Scope="AliasScope.Group"
        Name="@GroupViewModel.Name"
        OnSaved="HandleAliasesSaved" />
</Modal>

@code {
    [Parameter] public WorkspaceGroupViewModel GroupViewModel { get; set; } = null!;
    [Parameter] public GlobalCustomOpenOptions GlobalOptions { get; set; } = null!;
    [Parameter] public List<ScriptInfo> AvailableScripts { get; set; } = null!;
    [Parameter] public List<WorkspaceGroup> AllGroups { get; set; } = null!;
    [Parameter] public List<Workspace> AllWorkspaces { get; set; } = new();

    /// <summary>How many one-click Open buttons each collapsed card in this group gets.</summary>
    [Parameter] public int QuickOpenCount { get; set; } = 3;

    /// <summary>True while this card is the one being dragged.</summary>
    [Parameter] public bool IsDragging { get; set; }

    /// <summary>True while a drop here would land the dragged card in this card's place.</summary>
    [Parameter] public bool IsDropTarget { get; set; }

    /// <summary>
    /// Hidden from the dashboard. A hidden card only renders at all while the toolbar's toggle is
    /// showing them, and then it renders dimmed with an unhide in its menu.
    /// </summary>
    [Parameter] public bool IsHidden { get; set; }

    /// <summary>Hide or unhide this group, by name. Persisted in dashboardLayout.yaml.</summary>
    [Parameter] public EventCallback<string> OnToggleHidden { get; set; }

    [Parameter] public EventCallback<Workspace> OnDeleteWorkspace { get; set; }
    [Parameter] public EventCallback<WorkspaceGroup> OnDeleteGroup { get; set; }
    [Parameter] public EventCallback<(Workspace, WorkspaceLocation)> OnOpenWorkspaceLocation { get; set; }
    [Parameter] public EventCallback<WorkspaceLocation> OnOpenInExplorer { get; set; }
    [Parameter] public EventCallback<WorkspaceLocation> OnOpenInTerminal { get; set; }
    [Parameter] public EventCallback<(Workspace, WorkspaceLocation, CustomOpenOption)> OnOpenWithCustomApp { get; set; }
    [Parameter] public EventCallback<(ScriptInfo, Workspace, WorkspaceLocation)> OnRunScriptOnLocation { get; set; }
    [Parameter] public EventCallback<(Workspace, string)> OnMoveToGroup { get; set; }
    [Parameter] public EventCallback OnAddWorkspace { get; set; }
    [Parameter] public EventCallback OnIconChanged { get; set; }

    /// <summary>Group name plus workspace name — the pair the pin is stored under.</summary>
    [Parameter] public EventCallback<(string, string)> OnTogglePin { get; set; }

    /// <summary>Raised after any alias edit, so the search box starts honouring it at once.</summary>
    [Parameter] public EventCallback OnAliasesChanged { get; set; }

    [Parameter] public EventCallback<string> OnDragStarted { get; set; }
    [Parameter] public EventCallback<string> OnDragEntered { get; set; }
    [Parameter] public EventCallback<string> OnDropped { get; set; }
    [Parameter] public EventCallback OnDragEnded { get; set; }

    /// <summary>Rescan request for a group that came from a workspace source.</summary>
    [Parameter] public EventCallback OnRescan { get; set; }

    /// <summary>
    /// Open Smart Folders on this group's source. Carries the source name, so the dialog opens on
    /// the row the user was looking at rather than on whichever source happens to be first.
    /// </summary>
    [Parameter] public EventCallback<string?> OnEditSource { get; set; }

    private string NewWorkspaceName = string.Empty;
    private string NewGroupName = string.Empty;
    private IconStyle icon = new();
    private IReadOnlyList<string> aliases = Array.Empty<string>();

    // Where a right-click opened the menu. Reset by the ⋮, which wants the menu on its anchor.
    private bool atCursor;
    private double cursorX;
    private double cursorY;

    private bool IsFromSource => GroupViewModel.Group.IsFromSource;

    private int PinnedCount =>
        GroupViewModel.Workspaces.Count(w => Layout.IsPinned(GroupViewModel.Name, w.Name));

    /// <summary>
    /// Smart folders with rows on this group. Falls back to 1 rather than 0 for a scanned group
    /// that arrived without the list — the group exists, so something scanned it.
    /// </summary>
    private int RuleCount => Math.Max(GroupViewModel.Group.SourceNames.Count, 1);

    private string SourceTooltip
    {
        get
        {
            var names = GroupViewModel.Group.SourceNames;
            var by = names.Count > 0
                ? $"Scanned by {string.Join(", ", names)}"
                : "Scanned from a smart folder";

            return string.IsNullOrWhiteSpace(GroupViewModel.Group.SourcePath)
                ? by
                : $"{by} — {GroupViewModel.Group.SourcePath}";
        }
    }

    private string GroupStateClass
    {
        get
        {
            var classes = new List<string>();

            if (GroupViewModel.IsExpanded) classes.Add("is-expanded");
            if (IsDragging) classes.Add("is-dragging");
            if (IsDropTarget) classes.Add("is-drop-target");
            if (IsHidden) classes.Add("is-hidden-group");

            return string.Join(' ', classes);
        }
    }

    /// <summary>
    /// The aliases go in the tooltip. They are otherwise invisible, and an alias you have
    /// forgotten setting is an alias you cannot tell from a bug in the search box.
    /// </summary>
    private string TitleTooltip => aliases.Count > 0
        ? $"{GroupViewModel.Name} — also found as: {string.Join(", ", aliases)}"
        : GroupViewModel.Name;

    // Modal keys for ModalStateService
    private string AddWorkspaceModalKey => ModalStateService.GetModalKey("addWorkspace", GroupViewModel.Group.Name);
    private string RenameModalKey => ModalStateService.GetModalKey("renameGroup", GroupViewModel.Group.Name);
    private string IconModalKey => ModalStateService.GetModalKey("groupIcon", GroupViewModel.Group.Name);
    private string AliasModalKey => ModalStateService.GetModalKey("groupAlias", GroupViewModel.Group.Name);

    // Properties for binding to Modal components
    private bool IsAddWorkspaceModalVisible
    {
        get => ModalStateService.IsModalVisible(AddWorkspaceModalKey);
        set
        {
            if (value) ModalStateService.ShowModal(AddWorkspaceModalKey);
            else ModalStateService.HideModal(AddWorkspaceModalKey);
        }
    }

    private bool IsRenameModalVisible
    {
        get => ModalStateService.IsModalVisible(RenameModalKey);
        set
        {
            if (value) ModalStateService.ShowModal(RenameModalKey);
            else ModalStateService.HideModal(RenameModalKey);
        }
    }

    private bool IsIconModalVisible
    {
        get => ModalStateService.IsModalVisible(IconModalKey);
        set
        {
            if (value) ModalStateService.ShowModal(IconModalKey);
            else ModalStateService.HideModal(IconModalKey);
        }
    }

    private bool IsAliasModalVisible
    {
        get => ModalStateService.IsModalVisible(AliasModalKey);
        set
        {
            if (value) ModalStateService.ShowModal(AliasModalKey);
            else ModalStateService.HideModal(AliasModalKey);
        }
    }

    private string? GetModalError(string modalKey) => ModalStateService.GetError(modalKey);
    private string AddWorkspaceModalTitle => $"Add Workspace to {GroupViewModel.Name}";
    private string IconModalTitle => $"Icon for {GroupViewModel.Name}";
    private string AliasModalTitle => $"Search aliases for {GroupViewModel.Name}";

    // Component references for forms
    private RenameGroupDialog? renameGroupDialog;
    private IconPickerDialog? iconPicker;

    // Menu identity, not menu state — which menu is open is owned by MenuStateService, so opening
    // one closes every other and the backdrop can close whichever it is.
    private string GroupMenuId => $"group:{GroupViewModel.Group.Name}";

    protected override void OnInitialized() => Menu.Changed += OnMenuChanged;

    // The click that closes this card's menu usually lands somewhere else entirely.
    private void OnMenuChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Menu.Changed -= OnMenuChanged;

    protected override void OnParametersSet()
    {
        // Ensure the view model's expanded state is updated from CardStateService
        ViewModelFactory.UpdateGroupExpandedState(GroupViewModel);

        // A source's own icon acts as the fallback, so a scanned group looks right
        // before anyone opens the picker.
        icon = IconService.Resolve(IconScope.Group, GroupViewModel.Name, GroupViewModel.Group.SourceIcon);

        aliases = Layout.AliasesFor(AliasScope.Group, GroupViewModel.Name);
    }

    private void ToggleExpand()
    {
        CardStateService.ToggleExpand("group", GroupViewModel.Group.Name);
        GroupViewModel.IsExpanded = !GroupViewModel.IsExpanded;
        Menu.Close();
    }

    /// <summary>
    /// Right-click anywhere on the row. Open rather than Toggle: right-clicking a second place on
    /// a card whose menu is already up should move the menu there, not dismiss it.
    /// </summary>
    private void OpenContextMenu(MouseEventArgs e)
    {
        cursorX = e.ClientX;
        cursorY = e.ClientY;
        atCursor = true;
        Menu.Open(GroupMenuId);
    }

    private void ShowAddWorkspaceModal()
    {
        NewWorkspaceName = string.Empty;
        IsAddWorkspaceModalVisible = true;
        Menu.Close();
    }

    private void ShowRenameModal()
    {
        NewGroupName = GroupViewModel.Name;
        IsRenameModalVisible = true;
        Menu.Close();
    }

    private void ShowIconModal()
    {
        iconPicker?.ResetForm();
        IsIconModalVisible = true;
        Menu.Close();
    }

    private void ShowAliasModal()
    {
        IsAliasModalVisible = true;
        Menu.Close();
    }

    private async Task HandleIconSaved()
    {
        IsIconModalVisible = false;
        icon = IconService.Resolve(IconScope.Group, GroupViewModel.Name, GroupViewModel.Group.SourceIcon);
        await OnIconChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task HandleAliasesSaved()
    {
        IsAliasModalVisible = false;
        aliases = Layout.AliasesFor(AliasScope.Group, GroupViewModel.Name);
        await OnAliasesChanged.InvokeAsync();
        StateHasChanged();
    }

    private void ToggleActionsMenu()
    {
        // Back to hanging off the anchor, whatever a previous right-click set.
        atCursor = false;
        Menu.Toggle(GroupMenuId);
    }

    /// <summary>
    /// Opens Smart Folders on the source this group came from. A group can be fed by more than one
    /// source — the dev and demo checkouts of one site both carry the same group name — and
    /// <see cref="WorkspaceGroup.SourceName"/> is whichever got there first. The dialog lists the
    /// rest down its left side, so landing on one of them is a starting point rather than a guess
    /// that has to be right.
    /// </summary>
    private async Task EditSource()
    {
        Menu.Close();
        await OnEditSource.InvokeAsync(GroupViewModel.Group.SourceName);
    }

    private async Task ToggleHidden()
    {
        Menu.Close();
        await OnToggleHidden.InvokeAsync(GroupViewModel.Name);
    }

    private async Task Rescan()
    {
        Menu.Close();
        await OnRescan.InvokeAsync();
    }

    private async Task OpenSourceFolder()
    {
        Menu.Close();
        if (!string.IsNullOrWhiteSpace(GroupViewModel.Group.SourcePath))
        {
            var result = await SystemService.OpenInExplorerAsync(GroupViewModel.Group.SourcePath);
            if (!result.Success)
            {
                Console.WriteLine(result.Error);
            }
        }
    }

    private async Task HandleWorkspaceCreated(Workspace workspace)
    {
        GroupViewModel.Group.Workspaces.Add(workspace);

        // Add to the view model as well
        var workspaceViewModel = ViewModelFactory.CreateWorkspaceViewModel(workspace, GroupViewModel.Name);
        GroupViewModel.Workspaces.Add(workspaceViewModel);

        await OnAddWorkspace.InvokeAsync();

        IsAddWorkspaceModalVisible = false;
        NewWorkspaceName = string.Empty;
        StateHasChanged();
    }

    private async Task DeleteWorkspace(Workspace workspace)
    {
        // Remove from domain model
        GroupViewModel.Group.Workspaces.Remove(workspace);

        // Remove from view model
        var workspaceViewModel = GroupViewModel.Workspaces.FirstOrDefault(vm => vm.Workspace.Id == workspace.Id);
        if (workspaceViewModel != null)
        {
            GroupViewModel.Workspaces.Remove(workspaceViewModel);
        }

        await OnAddWorkspace.InvokeAsync();
        StateHasChanged();
    }

    private async Task HandleMoveToGroup((Workspace workspace, string groupName) args)
    {
        // Remove from view model
        var workspaceViewModel = GroupViewModel.Workspaces.FirstOrDefault(vm => vm.Workspace.Id == args.workspace.Id);
        if (workspaceViewModel != null)
        {
            GroupViewModel.Workspaces.Remove(workspaceViewModel);
        }

        // Remove from domain model
        GroupViewModel.Group.Workspaces.Remove(args.workspace);

        // Update workspace's group name
        args.workspace.GroupName = args.groupName;

        // Add workspace to new group in domain model
        var targetGroup = AllGroups.FirstOrDefault(g => g.Name == args.groupName);
        if (targetGroup != null)
        {
            targetGroup.Workspaces.Add(args.workspace);
        }

        await OnMoveToGroup.InvokeAsync(args);
        StateHasChanged();
    }

    private async Task OnDelete()
    {
        await OnDeleteGroup.InvokeAsync(GroupViewModel.Group);
        Menu.Close();
    }

    private async Task SaveWorkspaces()
    {
        await OnAddWorkspace.InvokeAsync();
    }

    private async Task HandleRenameCompleted()
    {
        IsRenameModalVisible = false;
        NewGroupName = string.Empty;
        renameGroupDialog?.ResetForm();
        await OnAddWorkspace.InvokeAsync();
        StateHasChanged();
    }
}
