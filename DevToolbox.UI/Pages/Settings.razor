@page "/settings"
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using DevToolbox.Services.Services
@using DevToolbox.UI.Web
@using Microsoft.JSInterop
@inject IUiSettingsService UiSettings
@inject IYamlStorageService YamlStorage
@inject IEnumerable<ICachedConfig> CachedConfigs
@inject IJSRuntime JS
@inject WebPreviewInfo WebPreview

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold text-gradient">Settings</h1>
    <p class="text-dark-text-muted mt-2">Configure application preferences and settings to customize your experience.</p>
</div>

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Appearance Settings -->
    <div class="modern-card">
        <div class="border-b border-dark-border pb-4 mb-6">
            <h2 class="text-2xl font-semibold text-dark-text flex items-center space-x-2">
                <i class="bi bi-palette text-accent-purple"></i>
                <span>Appearance</span>
            </h2>
        </div>
        
        <div class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-dark-text">Theme</label>
                    @* Seasonal themes are listed only inside their own window unless "Show all
                       themes" is on. The exception is one that is already saved: it stays in the
                       list year-round, because a select whose value matches no option displays the
                       first one instead and would quietly misreport the setting. *@
                    <select class="input-modern w-full" value="@selectedTheme" @onchange="OnThemeChangedAsync">
                        @foreach (var theme in offered.Where(t => !t.IsSeasonal))
                        {
                            <option value="@theme.Id">@theme.Label</option>
                        }
                        @if (offered.Any(t => t.IsSeasonal))
                        {
                            <optgroup label="Seasonal">
                                @foreach (var theme in offered.Where(t => t.IsSeasonal))
                                {
                                    <option value="@theme.Id">@OptionLabel(theme)</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <p class="text-xs text-dark-text-muted">Choose your preferred color scheme</p>
                    @if (WaitingFor is { } season)
                    {
                        <p class="text-xs text-warning">
                            Saved, but out of season, so the app is showing your system theme until
                            @season. Turn on "Show all themes" below to use it now.
                        </p>
                    }
                    @if (UnseenEffect is { } effect)
                    {
                        <p class="text-xs text-dark-text-muted">
                            This theme animates @effect. Turn on "Theme animations" below to see it.
                        </p>
                    }
                    @if (themeError is not null)
                    {
                        <p class="text-xs text-danger">@themeError</p>
                    }
                </div>
                
                <div class="space-y-2">
                    <div class="theme-preview bg-dark-surface border border-dark-border rounded-lg overflow-hidden h-32">
                        <div class="h-6 bg-gradient-to-r from-accent-blue to-accent-purple"></div>
                        <div class="flex h-26">
                            <div class="w-1/4 bg-dark-bg"></div>
                            <div class="w-3/4 bg-dark-surface p-3">
                                <div class="space-y-2">
                                    <div class="h-2 bg-dark-text rounded w-3/4"></div>
                                    <div class="h-2 bg-dark-text-muted rounded w-1/2"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            @* Both of these are applied on change rather than on Save, for the same reason the
               theme is: the only way to judge snow is to watch it. *@
            <div class="flex items-center justify-between p-4 bg-dark-surface rounded-lg">
                <div>
                    <label for="theme-animations" class="text-sm font-medium text-dark-text cursor-pointer">Theme animations</label>
                    <p class="text-xs text-dark-text-muted">
                        Let a seasonal theme animate: leaves for Fall and Thanksgiving, snow for
                        Winter and both Christmases, bats for Halloween, and the twinkling lights
                        on (Better)Christmas's garlands. Windows' own "reduce motion" setting
                        overrides this either way.
                    </p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="theme-animations" class="sr-only peer"
                           checked="@themeAnimations" @onchange="OnAnimationsChangedAsync" />
                    <div class="w-11 h-6 bg-dark-border peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-accent-blue/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-accent-blue"></div>
                </label>
            </div>

            <div class="flex items-center justify-between p-4 bg-dark-surface rounded-lg">
                <div>
                    <label for="show-all-themes" class="text-sm font-medium text-dark-text cursor-pointer">Show all themes</label>
                    <p class="text-xs text-dark-text-muted">
                        Offer every seasonal theme year-round. Off by default, so they arrive on
                        their own when the date comes round.
                    </p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="show-all-themes" class="sr-only peer"
                           checked="@showAllThemes" @onchange="OnShowAllChangedAsync" />
                    <div class="w-11 h-6 bg-dark-border peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-accent-blue/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-accent-blue"></div>
                </label>
            </div>

            <div class="flex items-center justify-between p-4 bg-dark-surface rounded-lg">
                <div>
                    <label for="auto-save" class="text-sm font-medium text-dark-text cursor-pointer">Auto-save</label>
                    <p class="text-xs text-dark-text-muted">Automatically save changes as you work</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="auto-save" class="sr-only peer" checked />
                    <div class="w-11 h-6 bg-dark-border peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-accent-blue/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-accent-blue"></div>
                </label>
            </div>
        </div>
    </div>

    <!-- Workspace Settings -->
    <div class="modern-card">
        <div class="border-b border-dark-border pb-4 mb-6">
            <h2 class="text-2xl font-semibold text-dark-text flex items-center space-x-2">
                <i class="bi bi-folder text-accent-blue"></i>
                <span>Workspace Settings</span>
            </h2>
        </div>
        
        <div class="space-y-4">
            <div class="space-y-2">
                <label for="default-workspace" class="block text-sm font-medium text-dark-text">Default Workspace Location</label>
                <div class="flex space-x-2">
                    <input type="text" id="default-workspace" value="C:\Projects" class="input-modern flex-1" />
                    <button class="btn-secondary flex items-center space-x-2">
                        <i class="bi bi-folder"></i>
                        <span>Browse</span>
                    </button>
                </div>
                <p class="text-xs text-dark-text-muted">Default location for new workspaces and projects</p>
            </div>
        </div>
    </div>

    <!-- Bundled configuration -->
    @* An upgrade never overwrites a config file you already have, which is the right default and
       also means there was no way to undo an experiment. This is the way back. *@
    <div class="modern-card">
        <div class="border-b border-dark-border pb-4 mb-6">
            <h2 class="text-2xl font-semibold text-dark-text flex items-center space-x-2">
                <i class="bi bi-arrow-counterclockwise text-accent-purple"></i>
                <span>Bundled Configuration</span>
            </h2>
            <p class="text-sm text-dark-text-muted mt-2">
                Configuration shipped with this install. Yours is never replaced automatically —
                restoring is always deliberate, and always keeps a dated backup of what it replaced.
            </p>
        </div>

        @if (bundled.Count == 0)
        {
            <p class="text-sm text-dark-text-muted">
                This build has no bundled configuration, so there is nothing to restore from. That is
                normal when running from source rather than from an installed package.
            </p>
        }
        else
        {
            <div class="space-y-1">
                @foreach (var file in bundled)
                {
                    <div class="flex items-center justify-between gap-4 py-2 px-3 rounded-lg hover:bg-dark-surface">
                        <span class="font-mono text-sm text-dark-text truncate" title="@file.Name">@file.Name</span>

                        <div class="flex items-center gap-3 flex-shrink-0">
                            <span class="text-xs @StateClass(file.State)">@StateLabel(file.State)</span>
                            <button class="btn-secondary btn-sm"
                                    disabled="@(file.State == ConfigRestore.State.Unchanged || isRestoring)"
                                    @onclick="() => RestoreOneAsync(file.Name)">
                                Restore
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="flex items-center justify-between mt-6 pt-4 border-t border-dark-border">
                <span class="text-xs text-dark-text-muted">
                    @RestorableCount of @bundled.Count differ from the shipped copy.
                </span>
                <button class="btn-ghost flex items-center space-x-2"
                        disabled="@(RestorableCount == 0 || isRestoring)"
                        @onclick="RestoreAllAsync">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Restore all @RestorableCount</span>
                </button>
            </div>

            @if (restoreMessage is not null)
            {
                <p class="text-xs mt-3 @(restoreFailed ? "text-danger" : "text-dark-text-muted")">@restoreMessage</p>
            }
        }
    </div>

    <!-- Browser view -->
    @* The same UI, served to a real browser while the app runs. Useful for a second
       monitor, for devtools the WebView does not give you, and for anyone who would
       rather keep a tab open than a window. *@
    <div class="modern-card">
        <div class="border-b border-dark-border pb-4 mb-6">
            <h2 class="text-2xl font-semibold text-dark-text flex items-center space-x-2">
                <i class="bi bi-browser-chrome text-accent-blue"></i>
                <span>Browser View</span>
            </h2>
        </div>

        @if (WebPreview.IsRunning)
        {
            <div class="flex items-center justify-between gap-4">
                <div class="min-w-0">
                    <div class="flex items-center space-x-2">
                        <div class="status-indicator status-online"></div>
                        <span class="text-sm text-dark-text">Serving at</span>
                        <span class="text-sm font-mono text-dark-text break-all">@WebPreview.Url</span>
                    </div>
                    <p class="text-xs text-dark-text-muted mt-2">
                        Bound to localhost only, and available for as long as DevToolbox is running.
                        Anything you do there acts on this machine, exactly as it does in this window.
                    </p>
                </div>
                <button class="btn-primary flex items-center space-x-2 flex-none" @onclick="OpenInBrowser">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Open in Browser</span>
                </button>
            </div>
        }
        else
        {
            <div class="flex items-start space-x-2">
                <div class="status-indicator status-offline mt-1.5"></div>
                <div>
                    <div class="text-sm text-dark-text">Not running</div>
                    <p class="text-xs text-dark-text-muted mt-1">
                        @(WebPreview.Error ?? "The browser view did not start with the app.")
                    </p>
                </div>
            </div>
        }
    </div>

    <!-- About -->
    @* Here rather than in a dialog because the first thing a bug report needs is the version, and
       the second is where the config it is complaining about actually lives. *@
    <div class="modern-card">
        <div class="border-b border-dark-border pb-4 mb-6">
            <h2 class="text-2xl font-semibold text-dark-text flex items-center space-x-2">
                <i class="bi bi-info-circle text-accent-blue"></i>
                <span>About</span>
            </h2>
        </div>

        <div class="space-y-4 text-sm">
            <div class="flex items-center justify-between">
                <span class="text-dark-text-muted">Version</span>
                <span class="text-dark-text font-medium">
                    @AppVersion.Display
                    @if (AppVersion.ChannelLabel is string channel)
                    {
                        <span class="ml-2 px-1.5 py-0.5 text-xs rounded bg-accent-purple/20 text-accent-purple uppercase tracking-wide">@channel</span>
                    }
                </span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-dark-text-muted">Package version</span>
                <span class="text-dark-text font-mono">@AppVersion.Package</span>
            </div>
            <div class="flex items-start justify-between gap-4">
                <span class="text-dark-text-muted whitespace-nowrap">Configuration</span>
                <span class="text-dark-text font-mono text-xs break-all text-right">@ConfigDirectory</span>
            </div>
        </div>

        @if (AppVersion.ReleaseChannel is not AppVersion.Channel.Release)
        {
            <p class="text-xs text-dark-text-muted mt-6 pt-4 border-t border-dark-border">
                This is a pre-release build. Configuration files in the folder above are yours — an
                upgrade never overwrites one that already exists.
            </p>
        }
    </div>

    <!-- Action Buttons -->
    <div class="flex justify-between items-center p-6 bg-dark-surface rounded-lg border border-dark-border">
        <div class="text-sm @(statusIsError ? "text-danger" : "text-dark-text-muted")">
            @(statusMessage ?? "Changes are saved automatically")
        </div>
        <div class="flex space-x-3">
            <button class="btn-ghost flex items-center space-x-2" @onclick="ResetToDefaults">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>Reset to Defaults</span>
            </button>
            <button class="btn-primary flex items-center space-x-2" @onclick="SaveSettings">
                <i class="bi bi-check-circle"></i>
                <span>Save Settings</span>
            </button>
        </div>
    </div>
</div>

@code {

    /// <summary>
    /// Hands the URL to Windows so it opens in the default browser.
    /// <para>
    /// UseShellExecute is required for a URL: with it false, CreateProcess would look
    /// for an executable literally named "http://localhost:5218" and fail.
    /// </para>
    /// </summary>
    private void OpenInBrowser()
    {
        if (WebPreview.Url is not { } url) return;

        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = url,
                UseShellExecute = true
            });
        }
        catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException)
        {
            statusMessage = $"Could not open a browser: {ex.Message}";
            statusIsError = true;
        }
    }
    private string ConfigDirectory => YamlStorage.StorageDirectory;

    private List<ConfigRestore.Comparison> bundled = new();
    private bool isRestoring;
    private string? restoreMessage;
    private bool restoreFailed;

    private int RestorableCount => bundled.Count(f => f.State != ConfigRestore.State.Unchanged);

    private static string StateLabel(ConfigRestore.State state) => state switch
    {
        ConfigRestore.State.Unchanged => "matches shipped",
        ConfigRestore.State.Missing => "not on this machine",
        _ => "changed",
    };

    private static string StateClass(ConfigRestore.State state) => state switch
    {
        ConfigRestore.State.Unchanged => "text-dark-text-muted",
        ConfigRestore.State.Missing => "text-accent-blue",
        _ => "text-accent-purple",
    };

    private void RefreshBundled() =>
        bundled = ConfigRestore.Compare(ConfigDefaults.SourceDirectory, ConfigDirectory).ToList();

    private async Task RestoreOneAsync(string name)
    {
        isRestoring = true;
        try
        {
            // One timestamp per action, so restoring several files groups their backups together.
            var backup = ConfigRestore.Restore(name, ConfigDefaults.SourceDirectory, ConfigDirectory, DateTime.Now);
            SetRestoreResult(
                backup is null
                    ? $"Restored {name}. There was nothing to back up."
                    : $"Restored {name}. Your copy was kept as {Path.GetFileName(backup)}.",
                failed: false);

            DropCachedCopy(name);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            SetRestoreResult($"Could not restore {name}: {ex.Message}", failed: true);
        }
        finally
        {
            isRestoring = false;
        }

        await Task.CompletedTask;
    }

    private async Task RestoreAllAsync()
    {
        isRestoring = true;
        try
        {
            var stamp = DateTime.Now;
            var restored = 0;
            var backups = 0;

            foreach (var file in bundled.Where(f => f.State != ConfigRestore.State.Unchanged).ToList())
            {
                var backup = ConfigRestore.Restore(file.Name, ConfigDefaults.SourceDirectory, ConfigDirectory, stamp);
                restored++;
                if (backup is not null) backups++;

                DropCachedCopy(file.Name);
            }

            SetRestoreResult(
                $"Restored {restored} file(s); {backups} replaced copy(ies) kept as .bak-{stamp:yyyy-MM-dd-HHmmss}.",
                failed: false);
        }
        finally
        {
            isRestoring = false;
        }

        await Task.CompletedTask;
    }

    /// <summary>
    /// Tells whichever service holds this file in memory to forget it, so the restored copy is the
    /// one read next.
    /// <para>
    /// Restoring writes over the live file directly rather than going through the service that owns
    /// it, so without this the service keeps serving the snapshot it loaded at startup. That is not
    /// hypothetical: a restored <c>openHandlers.yaml</c> reported success and changed nothing,
    /// because <c>OpenHandlerService</c> loads once and only when what it holds is null. Reopening
    /// the tab did not help — it returned the same cached copy — so the restore looked broken while
    /// having worked perfectly.
    /// </para>
    /// <para>
    /// Called even when the restore failed. Dropping a cache costs one re-read of a file that did
    /// not change, and getting it wrong in the other direction is what this exists to fix.
    /// </para>
    /// </summary>
    private void DropCachedCopy(string fileName)
    {
        var key = Path.GetFileNameWithoutExtension(fileName);

        foreach (var cached in CachedConfigs.Where(c => string.Equals(c.ConfigKey, key, StringComparison.OrdinalIgnoreCase)))
        {
            cached.Invalidate();
        }
    }

    // The cache each restored file lives in has just been dropped, so "reopen the tab" is now
    // true rather than wishful: the page reads the restored copy on its next initialisation.
    private void SetRestoreResult(string message, bool failed)
    {
        restoreMessage = failed ? message : message + " Reopen the affected tab to see the change.";
        restoreFailed = failed;
        RefreshBundled();
    }

    private string selectedTheme = ThemeOptions.System;
    private bool themeAnimations = true;
    private bool showAllThemes;
    private string? themeError;
    private string? statusMessage;
    private bool statusIsError;

    // The themes in the dropdown. A field rather than a property because the markup walks it three
    // times per render, and because it only ever changes on an event.
    private List<ThemeDefinition> offered = new();

    // Read once per refresh instead of per call, so a render that straddles midnight on 30 November
    // cannot show Fall in the list and call it out of season in the same breath.
    private DateOnly today = DateOnly.FromDateTime(DateTime.Now);

    /// <summary>
    /// The season a saved-but-dormant theme is waiting for, or null when the choice is live. This is
    /// the case worth spelling out: the file says christmas, the window is grey, and nothing is
    /// broken.
    /// </summary>
    private string? WaitingFor =>
        ThemeCatalog.Find(selectedTheme) is { Season: { } season } && !ThemeCatalog.IsActive(selectedTheme, today, showAllThemes)
            ? season.Describe()
            : null;

    /// <summary>An animation the chosen theme has but the animation toggle is suppressing.</summary>
    private string? UnseenEffect =>
        !themeAnimations && ThemeCatalog.Find(selectedTheme)?.Effect is { } effect
            ? ThemeCatalog.DescribeEffect(effect)
            : null;

    private string OptionLabel(ThemeDefinition theme)
    {
        if (theme.Season is null) return theme.Label;

        // The window is worth showing whenever it is not self-evident: with "show all themes" on
        // nothing else says when Halloween would normally appear, and a dormant saved theme needs
        // to say what it is waiting for.
        return showAllThemes || !theme.IsAvailableOn(today)
            ? $"{theme.Label} ({theme.Season.Describe()})"
            : theme.Label;
    }

    private void RefreshOffered()
    {
        today = DateOnly.FromDateTime(DateTime.Now);
        offered = ThemeCatalog.Offered(today, showAllThemes).ToList();

        // Keep a saved theme selectable even out of season; see the comment on the select.
        if (ThemeCatalog.Find(selectedTheme) is { } saved && !offered.Contains(saved))
        {
            offered.Add(saved);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        RefreshBundled();

        // Once before the first await, so the select is never rendered empty in the frame between
        // the component initializing and ui_settings.yaml coming back off disk.
        RefreshOffered();

        var settings = await UiSettings.GetAsync();
        selectedTheme = settings.Theme;
        themeAnimations = settings.ThemeAnimations;
        showAllThemes = settings.ShowAllThemes;
        RefreshOffered();

        // A malformed ui_settings.yaml leaves the dropdown showing defaults that
        // are not what is in the file. Say so, rather than letting the next save
        // quietly overwrite whatever the user was editing.
        themeError = UiSettings.LoadError is null
            ? null
            : $"ui_settings.yaml could not be read, so defaults are shown: {UiSettings.LoadError}";
    }

    // Applied and persisted on selection rather than on Save — the theme is the
    // one setting here where seeing it is the only way to judge it.
    private async Task OnThemeChangedAsync(ChangeEventArgs e)
    {
        selectedTheme = ThemeOptions.Normalize(e.Value?.ToString());
        await ApplyAndSaveThemeAsync();
    }

    private async Task OnAnimationsChangedAsync(ChangeEventArgs e)
    {
        themeAnimations = e.Value is true;
        await ApplyAndSaveThemeAsync();
    }

    private async Task OnShowAllChangedAsync(ChangeEventArgs e)
    {
        showAllThemes = e.Value is true;
        await ApplyAndSaveThemeAsync();
    }

    private async Task SaveSettings() => await ApplyAndSaveThemeAsync();

    private async Task ResetToDefaults()
    {
        var defaults = new UiSettings();
        selectedTheme = defaults.Theme;
        themeAnimations = defaults.ThemeAnimations;
        showAllThemes = defaults.ShowAllThemes;
        await ApplyAndSaveThemeAsync();
    }

    private async Task ApplyAndSaveThemeAsync()
    {
        // The dropdown's own contents depend on these values, so the list is rebuilt before the
        // paint: turning "show all themes" off has to remove the options it added.
        RefreshOffered();

        // Paint first so the change is instant even if the write is slow, then
        // persist. If the write fails the screen and the file disagree, which is
        // exactly what the error message needs to say.
        await JS.InvokeVoidAsync("devtoolboxTheme.apply", selectedTheme, themeAnimations, showAllThemes);

        try
        {
            var settings = await UiSettings.GetAsync();
            settings.Theme = selectedTheme;
            settings.ThemeAnimations = themeAnimations;
            settings.ShowAllThemes = showAllThemes;
            await UiSettings.SaveAsync(settings);

            themeError = null;
            SetStatus("Settings saved", isError: false);
        }
        catch (InvalidOperationException ex)
        {
            SetStatus($"Theme applied but not saved: {ex.Message}", isError: true);
        }
    }

    private void SetStatus(string message, bool isError)
    {
        statusMessage = message;
        statusIsError = isError;
    }
}
