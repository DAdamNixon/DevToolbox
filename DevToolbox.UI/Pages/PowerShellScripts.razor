@page "/powershell"
@namespace DevToolbox.UI.Pages

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold text-gradient">PowerShell Scripts</h1>
    <p class="text-dark-text-muted mt-2">Create, edit, and execute PowerShell scripts with built-in validation.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6 h-[calc(100vh-200px)]">
    <!-- Left Sidebar -->
    <div class="lg:col-span-1">
        <div class="modern-card h-full flex flex-col">
            <div class="p-6 border-b border-dark-border">
                <div class="relative">
                    <input type="text" 
                        @bind-value="searchText" 
                        @bind-value:event="oninput" 
                        placeholder="Search scripts..." 
                        class="input-modern w-full pl-10" />
                    <i class="bi bi-search absolute left-3 top-1/2 transform -translate-y-1/2 text-dark-text-muted"></i>
                </div>
            </div>
            
            <div class="flex-1 p-4 overflow-y-auto">
                <div class="space-y-2 mb-4">
                    @foreach (var script in FilteredScripts)
                    {
                        <button class="w-full text-left px-4 py-3 rounded-lg text-sm font-medium transition-colors @(script.Name == selectedScript ? "bg-accent-blue text-white" : "text-dark-text hover:bg-dark-surface")"
                            @onclick="() => LoadScript(script.Name)">
                            <i class="bi bi-file-earmark-code mr-2"></i>
                            @script.Name
                        </button>
                    }
                </div>
                
                <button class="btn-primary w-full flex items-center justify-center space-x-2" @onclick="CreateNewScript">
                    <i class="bi bi-plus-circle"></i>
                    <span>New Script</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="lg:col-span-3">
        <div class="modern-card h-full">
            @if (!string.IsNullOrEmpty(selectedScript))
            {
                <div class="p-6 h-full flex flex-col">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-2xl font-semibold text-dark-text flex items-center space-x-2">
                            <i class="bi bi-file-earmark-code text-accent-blue"></i>
                            <span>@selectedScript</span>
                        </h2>
                        
                        <div class="flex items-center space-x-4">
                            <label class="flex items-center space-x-2 cursor-pointer">
                                <input type="checkbox" id="enableValidation" @bind="enableScriptValidation" class="checkbox-modern">
                                <span class="text-sm text-dark-text">Enable Script Validation</span>
                            </label>
                            <button class="btn-secondary flex items-center space-x-2" @onclick="ValidateCurrentScript">
                                <i class="bi bi-shield-check"></i>
                                <span>Validate Script</span>
                            </button>
                        </div>
                    </div>
                    
                    @if (showValidationResults)
                    {
                        <div class="mb-4 space-y-3">
                            @if (validationErrors.Any())
                            {
                                <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4">
                                    <div class="flex items-start space-x-3">
                                        <i class="bi bi-exclamation-triangle text-red-400 text-lg"></i>
                                        <div>
                                            <h5 class="font-medium text-red-400 mb-2">Validation Errors:</h5>
                                            <ul class="text-red-300 text-sm space-y-1 list-disc list-inside">
                                                @foreach (var error in validationErrors)
                                                {
                                                    <li>@error</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                            
                            @if (validationWarnings.Any())
                            {
                                <div class="bg-yellow-500/10 border border-yellow-500/20 rounded-lg p-4">
                                    <div class="flex items-start space-x-3">
                                        <i class="bi bi-exclamation-triangle text-yellow-400 text-lg"></i>
                                        <div>
                                            <h5 class="font-medium text-yellow-400 mb-2">Validation Warnings:</h5>
                                            <ul class="text-yellow-300 text-sm space-y-1 list-disc list-inside">
                                                @foreach (var warning in validationWarnings)
                                                {
                                                    <li>@warning</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="flex-1 flex flex-col space-y-4">
                        @* The pane is a flex column and the textarea flexes inside it.
                           It used to be h-full, which is 100% of the pane on top of the
                           label above it — so the editor overflowed its own section by
                           the label's height and ran over the Path field below. *@
                        <div class="flex-1 ps-editor-pane">
                            <label class="block text-sm font-medium text-dark-text mb-2">Script Editor</label>
                            @* No whitespace before the closing tag: a textarea's content is
                               its initial value, so a newline and indentation here is a
                               blank first line in every script. *@
                            <textarea @bind="scriptText"
                                rows="15"
                                class="input-modern w-full font-mono text-sm resize-none"
                                placeholder="Enter your PowerShell script here..."></textarea>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-dark-text mb-2">
                                Path to run against
                                @if (RequiredParameters.Any())
                                {
                                    <span class="font-normal text-dark-text-muted">
                                        &mdash; this script requires @string.Join(", ", RequiredParameters)
                                    </span>
                                }
                            </label>
                            <input type="text" @bind="projectPath"
                                   class="input-modern w-full"
                                   placeholder="C:\TFS\Tools\DevToolbox" />
                            <p class="text-xs text-dark-text-muted mt-1">
                                Passed to the script as <span class="font-mono">-ProjectPath</span>, the same way the
                                Run Script menu on a workspace location passes it.
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4">
                                <div class="flex items-start space-x-3">
                                    <i class="bi bi-exclamation-circle text-red-400 text-lg"></i>
                                    <div>
                                        <h5 class="font-medium text-red-400 mb-2">Error:</h5>
                                        <div class="text-red-300 text-sm font-mono whitespace-pre-wrap">@error</div>
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(output))
                        {
                            <div class="bg-green-500/10 border border-green-500/20 rounded-lg p-4">
                                <div class="flex items-start space-x-3">
                                    <i class="bi bi-check-circle text-green-400 text-lg"></i>
                                    <div class="flex-1">
                                        <h5 class="font-medium text-green-400 mb-2">Output:</h5>
                                        <pre class="text-green-300 text-sm font-mono whitespace-pre-wrap bg-dark-surface rounded-lg p-3 max-h-48 overflow-y-auto">@output</pre>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="flex flex-wrap gap-2 pt-4 border-t border-dark-border">
                            <button class="btn-primary flex items-center space-x-2" @onclick="SaveScript" disabled="@isExecuting">
                                <i class="bi bi-save"></i>
                                <span>Save</span>
                            </button>
                            @* One Run button, not two. "Run Script" and "Run With Parameters" differed only in
                               whether the path was passed, and the one that did not pass it could never work:
                               every bundled script declares ProjectPath as mandatory. *@
                            <button class="btn-secondary flex items-center space-x-2" @onclick="ExecuteScript" disabled="@isExecuting">
                                <i class="bi bi-play"></i>
                                <span>@(isExecuting ? "Running..." : "Run Script")</span>
                            </button>
                            <button class="btn-danger flex items-center space-x-2" @onclick="DeleteScript" disabled="@isExecuting">
                                <i class="bi bi-trash"></i>
                                <span>Delete</span>
                            </button>
                            <button class="btn-ghost flex items-center space-x-2" @onclick="ClearOutput" disabled="@isExecuting">
                                <i class="bi bi-eraser"></i>
                                <span>Clear Output</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center h-full text-center p-8">
                    <div class="w-20 h-20 bg-dark-surface rounded-full flex items-center justify-center mb-4">
                        <i class="bi bi-file-earmark-code text-3xl text-dark-text-muted"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-dark-text mb-2">No Script Selected</h3>
                    <p class="text-dark-text-muted mb-6">Select a script from the sidebar or create a new one to get started.</p>
                    <button class="btn-primary flex items-center space-x-2" @onclick="CreateNewScript">
                        <i class="bi bi-plus-circle"></i>
                        <span>Create New Script</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>