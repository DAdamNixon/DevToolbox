@page "/logs"
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using System.Threading
@inject ILogFileService LogFileService
@inject IYamlStorageService YamlStorage
@inject IJSRuntime JS
@implements IDisposable

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold text-gradient">Log Viewer</h1>
    <p class="text-dark-text-muted mt-2">View and analyze application logs with powerful search and filtering capabilities.</p>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4 mb-6 flex items-start justify-between">
        <div class="flex items-start space-x-3">
            <i class="bi bi-exclamation-triangle text-red-400 text-xl"></i>
            <div>
                <div class="font-medium text-red-400">Error</div>
                <div class="text-red-300 text-sm">@errorMessage</div>
            </div>
        </div>
        <button type="button" class="btn-ghost p-2" @onclick="ClearError">
            <i class="bi bi-x text-red-400"></i>
        </button>
    </div>
}

<!-- Search / Filters -->
<div class="modern-card mb-6">
    <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
        <div>
            <label for="templateSelect" class="block text-sm font-medium text-dark-text mb-2">Template</label>
            <select id="templateSelect" class="input-modern w-full" @bind="selectedTemplateName" @bind:after="OnTemplateChanged">
                @foreach (var template in availableTemplates)
                {
                    <option value="@template.Name">@template.Name</option>
                }
            </select>
        </div>
        <div class="md:col-span-2 relative">
            <label class="block text-sm font-medium text-dark-text mb-2">Location</label>
            <button type="button" class="input-modern w-full text-left flex items-center justify-between" @onclick="ToggleLocationMenu">
                <span class="truncate">@LocationSummary</span>
                <i class="bi bi-chevron-down text-dark-text-muted ml-2"></i>
            </button>
            @if (showLocationMenu)
            {
                <div class="absolute z-20 mt-1 w-full bg-dark-surface border border-dark-border rounded-lg shadow-lg max-h-64 overflow-auto">
                    <label class="flex items-center space-x-2 px-3 py-2 hover:bg-dark-surface-hover cursor-pointer border-b border-dark-border">
                        <input type="checkbox" checked="@AllLocationsSelected" @onchange="ToggleAllLocations" />
                        <span class="text-sm text-dark-text font-medium">Select all</span>
                    </label>
                    @foreach (var location in logLocations)
                    {
                        <label class="flex items-center space-x-2 px-3 py-2 hover:bg-dark-surface-hover cursor-pointer">
                            <input type="checkbox" checked="@IsLocationSelected(location)" @onchange="() => ToggleLocation(location)" />
                            <span class="text-sm text-dark-text">@location.Name</span>
                        </label>
                    }
                </div>
            }
        </div>
        <div>
            <label for="startDate" class="block text-sm font-medium text-dark-text mb-2">Start Date</label>
            <input id="startDate" type="date" class="input-modern w-full" @bind="startDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="endDate" class="block text-sm font-medium text-dark-text mb-2">End Date</label>
            <input id="endDate" type="date" class="input-modern w-full" @bind="endDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="logFile" class="block text-sm font-medium text-dark-text mb-2">Log File</label>
            <input id="logFile" class="input-modern w-full" list="logFiles" placeholder="Log file..." @bind="logFile" />
            <datalist id="logFiles">
                @foreach (var file in availableLogFiles)
                {
                    <option value="@file"></option>
                }
            </datalist>
        </div>
    </div>
    
    <div class="flex items-end gap-4 mt-6">
        <button class="btn-primary flex items-center space-x-2" @onclick="Search" disabled="@isLoading" aria-describedby="searchHelp">
            @if (isLoading)
            {
                <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
            }
            else
            {
                <i class="bi bi-search"></i>
            }
            <span>Search</span>
        </button>
        <button class="btn-secondary flex items-center space-x-2" @onclick="DownloadCsv" disabled="@(isLoading || filteredLogLines.Count == 0)" title="Download as CSV">
            <i class="bi bi-download"></i>
            <span>CSV</span>
        </button>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
        <div>
            <label for="tableSearch" class="block text-sm font-medium text-dark-text mb-2">Search in results</label>
            <input id="tableSearch" type="text" class="input-modern w-full" @bind="tableSearch" @bind:event="oninput" @onkeypress="OnSearchKeyPress" placeholder="Search table..." />
            <div class="text-xs text-dark-text-muted mt-1">Press Enter or wait 500ms to search</div>
        </div>
        <div class="flex items-end">
            @if (isLoading)
            {
                <div class="flex items-center space-x-2 text-dark-text-muted">
                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-accent-blue"></div>
                    <span>Loading logs...</span>
                </div>
            }
            else if (filteredLogLines.Count > 0)
            {
                <div class="text-dark-text-muted">
                    Showing <span class="text-accent-blue font-medium">@filteredLogLines.Count</span> of <span class="text-accent-blue font-medium">@totalRecords</span> records
                </div>
            }
        </div>
    </div>

    <!-- Advanced / keyword-group search -->
    <div class="mt-6 border-t border-dark-border pt-4">
        <div class="flex items-center justify-between mb-3">
            <label class="flex items-center space-x-2 cursor-pointer">
                <input type="checkbox" @bind="advancedRawMode" />
                <span class="text-sm font-medium text-dark-text">Advanced query mode</span>
            </label>
            <span class="text-xs text-dark-text-muted">Contains-based. Rows combine with AND / OR / NOT.</span>
        </div>

        @if (advancedRawMode)
        {
            <div>
                <label for="advExpr" class="block text-sm font-medium text-dark-text mb-2">Advanced expression</label>
                <textarea id="advExpr" rows="2" class="input-modern w-full font-mono text-sm"
                          placeholder='"error" AND ("timeout" OR "retry") AND NOT "debug"'
                          @bind="advancedExpression"></textarea>
                <div class="text-xs text-dark-text-muted mt-1">Quoted terms with AND, OR, NOT and parentheses. Each term is matched as "contains" across all columns.</div>
            </div>
        }
        else
        {
            <div class="space-y-2">
                @for (int i = 0; i < keywordRows.Count; i++)
                {
                    var index = i;
                    var row = keywordRows[index];
                    <div class="flex items-center space-x-2">
                        @if (index == 0)
                        {
                            <span class="w-20 text-xs text-dark-text-muted text-center">where</span>
                        }
                        else
                        {
                            <select class="input-modern w-20" @bind="row.Gate">
                                <option value="AND">AND</option>
                                <option value="OR">OR</option>
                                <option value="NOT">NOT</option>
                            </select>
                        }
                        <input class="input-modern flex-1" placeholder="Interchangeable terms (any match), comma-separated" @bind="row.Text" />
                        <button type="button" class="btn-ghost p-2" title="Remove group" @onclick="() => RemoveKeywordRow(index)" disabled="@(keywordRows.Count == 1)">
                            <i class="bi bi-x-lg text-dark-text-muted"></i>
                        </button>
                    </div>
                }
                <button type="button" class="btn-secondary flex items-center space-x-2" @onclick="AddKeywordRow">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add Group</span>
                </button>
            </div>
        }
    </div>
</div>

@if (isLoading)
{
    <div class="modern-card text-center py-16">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-accent-blue mx-auto"></div>
        <p class="mt-4 text-dark-text-muted">Loading logs, please wait...</p>
    </div>
}
else if (filteredLogLines.Count == 0 && !hasSearched)
{
    <div class="modern-card text-center py-16">
        <i class="bi bi-search text-6xl text-dark-text-muted"></i>
        <p class="text-dark-text-muted mt-4">Enter your search criteria and click "Search" to view logs.</p>
    </div>
}
else if (filteredLogLines.Count == 0)
{
    <div class="modern-card text-center py-16">
        <i class="bi bi-inbox text-6xl text-dark-text-muted"></i>
        <p class="text-dark-text-muted mt-4">No logs found matching your criteria. Try adjusting your filters or date range.</p>
    </div>
}
else
{
    <div class="modern-card">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-semibold text-dark-text flex items-center space-x-2">
                <i class="bi bi-table text-accent-blue"></i>
                <span>Log Results</span>
            </h2>
            <div class="flex items-center space-x-2">
                <button class="btn-secondary flex items-center space-x-2" @onclick="CopyResults" title="Copy visible rows as tab-separated text">
                    <i class="bi bi-clipboard"></i>
                    <span>Copy</span>
                </button>
                <label class="text-sm text-dark-text-muted">Page size:</label>
                <select class="input-modern w-auto" @bind="pageSize" @bind:after="OnPageSizeChanged">
                    <option value="100">100</option>
                    <option value="250">250</option>
                    <option value="500">500</option>
                    <option value="1000">1000</option>
                </select>
            </div>
        </div>
        
        <div class="border border-dark-border rounded-lg overflow-hidden">
            <div style="max-height: 600px; overflow: auto;" tabindex="0" role="region" aria-label="Log table">
                <table id="logResultsTable" class="w-full select-text" style="table-layout: fixed; min-width: 1200px;">
                    <colgroup>
                        @foreach (var col in tableColumns)
                        {
                            <col style="width: 160px;" />
                        }
                    </colgroup>
                    <thead class="bg-dark-surface border-b border-dark-border sticky top-0 z-10">
                        <tr>
                            @foreach (var col in tableColumns)
                            {
                                var sortEntry = activeSorts.FirstOrDefault(s => s.Column == col);
                                var sortIndex = activeSorts.FindIndex(s => s.Column == col);
                                <th class="relative px-4 py-3 text-left text-xs font-medium text-dark-text uppercase tracking-wider border-r border-dark-border cursor-pointer hover:bg-dark-surface-hover transition-colors"
                                    style="width: 160px;"
                                    @onclick="(e) => SortByColumn(col, e.ShiftKey)"
                                    @onkeypress="@(async (e) => { if (e.Key == "Enter" || e.Key == " ") await SortByColumn(col, false); })"
                                    tabindex="0"
                                    role="button"
                                    title="Click to sort, Shift+Click to add a secondary sort"
                                    aria-label="Sort by @col">
                                    <div class="flex items-center justify-between pr-2">
                                        <span class="truncate">@col</span>
                                        <span class="w-6 h-4 flex items-center justify-center">
                                            @if (sortEntry != null)
                                            {
                                                <i class="bi @(sortEntry.Direction == "desc" ? "bi-chevron-down" : "bi-chevron-up") text-accent-blue"></i>
                                                @if (activeSorts.Count > 1)
                                                {
                                                    <span class="text-[10px] text-accent-blue ml-0.5">@(sortIndex + 1)</span>
                                                }
                                            }
                                            else
                                            {
                                                <i class="bi bi-chevron-expand text-dark-text-muted opacity-0 hover:opacity-100"></i>
                                            }
                                        </span>
                                    </div>
                                    <span class="col-resizer" style="position:absolute; top:0; right:0; width:6px; height:100%; cursor:col-resize;"></span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody class="bg-dark-bg">
                        <Virtualize Items="@filteredLogLines" ItemSize="32" OverscanCount="10">
                            <ItemContent Context="logLine">
                                <tr class="border-b border-dark-border hover:bg-dark-surface/50 transition-colors" role="row">
                                    @foreach (var col in tableColumns)
                                    {
                                        <td class="px-4 py-3 text-sm text-dark-text border-r border-dark-border overflow-hidden text-ellipsis whitespace-nowrap select-text"
                                            title="@logLine.GetValueOrDefault(col, "")" role="cell">
                                            @logLine.GetValueOrDefault(col, "")
                                        </td>
                                    }
                                </tr>
                            </ItemContent>
                            <Placeholder>
                                <tr class="border-b border-dark-border">
                                    @for (int i = 0; i < tableColumns.Count; i++)
                                    {
                                        <td class="px-4 py-3 border-r border-dark-border">
                                            <div class="animate-pulse">
                                                <div class="h-4 bg-dark-surface rounded w-3/4"></div>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            </Placeholder>
                        </Virtualize>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="flex justify-between items-center mt-6" role="navigation" aria-label="Pagination">
            <button class="btn-secondary flex items-center space-x-2" @onclick="PrevPage" disabled="@(isLoading || currentPage == 0)" aria-label="Previous page">
                <i class="bi bi-chevron-left"></i>
                <span>Previous</span>
            </button>

            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-2">
                    <label for="pageInput" class="text-sm text-dark-text-muted">Page:</label>
                    <input id="pageInput"
                           type="number"
                           class="input-modern w-20 text-center"
                           min="1"
                           max="@totalPages"
                           @bind="pageInput"
                           @bind:event="oninput"
                           @onkeypress="OnPageKeyPress" />
                    <button class="btn-secondary px-3 py-1" @onclick="JumpToPage" disabled="@isLoading">Go</button>
                </div>
                <span class="text-sm text-dark-text">
                    of <span class="font-semibold text-accent-blue">@totalPages</span> 
                    (<span class="font-semibold text-accent-blue">@totalRecords</span> total)
                </span>
            </div>

            <button class="btn-secondary flex items-center space-x-2" @onclick="NextPage" disabled="@(isLoading || !hasMorePages)" aria-label="Next page">
                <span>Next</span>
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
}


@code {
    // State management
    private List<LogLocation> logLocations = new();
    private List<LogLocation> selectedLocations = new();
    private bool showLocationMenu = false;
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private string logFile = string.Empty;
    private string tableSearch = string.Empty;
    private List<string> availableLogFiles = new();
    private List<LogTemplateIndexEntry> availableTemplates = new();
    private string selectedTemplateName = "";
    private List<Dictionary<string, string>> originalLogLines = new();
    private List<Dictionary<string, string>> filteredLogLines = new();
    private List<string> tableColumns = new();
    private bool isLoading = false;
    private List<SortColumn> activeSorts = new();
    private bool hasSearched = false;
    private string errorMessage = "";

    // Advanced / keyword-group search
    private class KeywordRow { public string Gate { get; set; } = "AND"; public string Text { get; set; } = ""; }
    private List<KeywordRow> keywordRows = new() { new KeywordRow() };
    private bool advancedRawMode = false;
    private string advancedExpression = "";
    private LogFilePresetConfig? presetConfig;
    
    // Pagination state
    private int currentPage = 0;
    private int pageSize = 500;
    private bool hasMorePages = true;
    private int pageInput = 1;
    private int totalPages = 0;
    private int totalRecords = 0;
    
    // Debouncing
    private System.Threading.Timer? _searchDebounceTimer;
    private CancellationTokenSource? _cancellationTokenSource;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            isLoading = true;
            
            var locationsTask = LogFileService.GetLogLocationsAsync();
            var templatesTask = LogFileService.GetAvailableLogFileTemplatesAsync();
            
            await Task.WhenAll(locationsTask, templatesTask);
            
            logLocations = await locationsTask ?? new List<LogLocation>();
            availableTemplates = await templatesTask ?? new List<LogTemplateIndexEntry>();
            
            presetConfig = await YamlStorage.LoadAsync<LogFilePresetConfig>("log_file_presets");

            selectedTemplateName = availableTemplates.FirstOrDefault()?.Name ?? string.Empty;
            selectedLocations = logLocations.Take(1).ToList();
            
            if (!string.IsNullOrEmpty(selectedTemplateName))
            {
                ApplyPresetsForTemplate();
                await UpdateTableColumnsAsync();
            }
        }
        catch (Exception ex)
        {
            SetError($"Failed to load initial data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnTemplateChanged()
    {
        ApplyPresetsForTemplate();
        await UpdateTableColumnsAsync();
        ResetPagination();
    }

    private void ToggleLocationMenu() => showLocationMenu = !showLocationMenu;

    private string LocationSummary => selectedLocations.Count switch
    {
        0 => "Select location(s)...",
        1 => selectedLocations[0].Name,
        _ => $"{selectedLocations.Count} locations selected"
    };

    private bool AllLocationsSelected => logLocations.Count > 0 && selectedLocations.Count == logLocations.Count;

    private bool IsLocationSelected(LogLocation location) =>
        selectedLocations.Any(l => l.Path == location.Path);

    private void ToggleLocation(LogLocation location)
    {
        var existing = selectedLocations.FirstOrDefault(l => l.Path == location.Path);
        if (existing != null)
            selectedLocations.Remove(existing);
        else
            selectedLocations.Add(location);
        ResetPagination();
    }

    private void ToggleAllLocations()
    {
        if (AllLocationsSelected)
            selectedLocations.Clear();
        else
            selectedLocations = new List<LogLocation>(logLocations);
        ResetPagination();
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 0;
        pageInput = 1;
        
        if (hasSearched)
        {
            await LoadPageAsync();
        }
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CancelSearch();
            await PerformTableSearch();
        }
        else
        {
            DebounceTableSearch();
        }
    }

    private async Task OnPageKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await JumpToPage();
        }
    }

    private void DebounceTableSearch()
    {
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new Timer(async _ => 
        {
            await InvokeAsync(PerformTableSearch);
        }, null, TimeSpan.FromMilliseconds(500), Timeout.InfiniteTimeSpan);
    }

    private async Task PerformTableSearch()
    {
        _searchDebounceTimer?.Dispose();
        ResetPagination();
        
        if (hasSearched)
        {
            await LoadPageAsync();
        }
    }

    private void ResetPagination()
    {
        currentPage = 0;
        pageInput = 1;
        totalPages = 0;
        totalRecords = 0;
        hasMorePages = true;
    }

    private void CancelSearch()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = new CancellationTokenSource();
    }

    private void SetError(string message)
    {
        errorMessage = message;
        StateHasChanged();
    }

    private void ClearError()
    {
        errorMessage = "";
        StateHasChanged();
    }

    private async Task Search()
    {
        ClearError();
        CancelSearch();
        
        if (string.IsNullOrWhiteSpace(selectedTemplateName))
        {
            SetError("Please select a template.");
            return;
        }
        
        if (selectedLocations.Count == 0)
        {
            SetError("Please select at least one location.");
            return;
        }
        
        if (startDate > endDate)
        {
            SetError("Start date cannot be after end date.");
            return;
        }

        ResetPagination();
        hasSearched = true;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        if (isLoading || _cancellationTokenSource?.Token.IsCancellationRequested == true) 
            return;

        isLoading = true;
        StateHasChanged();

        try
        {
            var token = _cancellationTokenSource?.Token ?? CancellationToken.None;
            
            var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
            if (templateEntry == null)
            {
                SetError($"Template '{selectedTemplateName}' not found.");
                return;
            }

            // Load count and data in parallel
            var sorts = activeSorts.Count > 0 ? activeSorts : null;
            var criteria = BuildCriteria();
            var criteriaArg = criteria.HasContent ? criteria : null;
            var countTask = LogFileService.CountLogEntriesAsync(logFile, selectedLocations, startDate, endDate, templateEntry.Name, tableSearch, criteriaArg);
            var dataTask = LogFileService.SearchLogFilesPageAsync(logFile, selectedLocations, startDate, endDate, templateEntry.Name, tableSearch, currentPage, pageSize, sorts, criteriaArg);

            await Task.WhenAll(countTask, dataTask);
            
            if (token.IsCancellationRequested) return;

            totalRecords = await countTask;
            totalPages = (int)Math.Ceiling(totalRecords / (double)pageSize);
            
            var pageData = await dataTask;
            originalLogLines = pageData ?? new List<Dictionary<string, string>>();
            filteredLogLines = originalLogLines;

            // Update columns from actual data
            if (pageData?.Any() == true)
            {
                tableColumns = pageData.OrderByDescending(l => l.Count).FirstOrDefault()?.Keys.ToList() ?? new List<string>();
            }

            hasMorePages = pageData?.Count == pageSize && (currentPage + 1) < totalPages;
            pageInput = currentPage + 1;
        }
        catch (OperationCanceledException)
        {
            // Search was cancelled, ignore
            return;
        }
        catch (Exception ex)
        {
            SetError($"Search failed: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task JumpToPage()
    {
        if (pageInput < 1) pageInput = 1;
        if (pageInput > totalPages) pageInput = totalPages;

        var newPage = pageInput - 1;
        if (newPage != currentPage)
        {
            currentPage = newPage;
            await LoadPageAsync();
        }
    }

    private async Task NextPage()
    {
        if (hasMorePages && currentPage < totalPages - 1)
        {
            currentPage++;
            await LoadPageAsync();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 0)
        {
            currentPage--;
            await LoadPageAsync();
        }
    }

    private async Task SortByColumn(string column, bool append)
    {
        if (isLoading || !hasSearched) return;

        var existing = activeSorts.FirstOrDefault(s => s.Column == column);
        if (append)
        {
            // Shift+Click builds a multi-column sort.
            if (existing != null)
                existing.Direction = existing.Direction == "asc" ? "desc" : "asc";
            else
                activeSorts.Add(new SortColumn { Column = column, Direction = "asc" });
        }
        else if (existing != null && activeSorts.Count == 1)
        {
            existing.Direction = existing.Direction == "asc" ? "desc" : "asc";
        }
        else
        {
            activeSorts = new List<SortColumn> { new SortColumn { Column = column, Direction = "asc" } };
        }

        currentPage = 0;
        pageInput = 1;
        await LoadPageAsync();
    }

    private async Task UpdateTableColumnsAsync()
    {
        try
        {
            var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
            if (templateEntry != null)
            {
                var template = await LogFileService.LoadTemplateAsync(templateEntry.File);
                tableColumns = template?.Columns ?? new List<string>();
            }
        }
        catch (Exception ex)
        {
            SetError($"Failed to update table columns: {ex.Message}");
        }
    }

    private LogSearchCriteria BuildCriteria()
    {
        var criteria = new LogSearchCriteria { UseAdvanced = advancedRawMode };
        if (advancedRawMode)
        {
            criteria.AdvancedExpression = advancedExpression;
        }
        else
        {
            foreach (var row in keywordRows)
            {
                var terms = (row.Text ?? string.Empty)
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToList();
                if (terms.Count == 0) continue;
                criteria.Groups.Add(new KeywordGroup { Gate = row.Gate, Terms = terms });
            }
        }
        return criteria;
    }

    private void AddKeywordRow() => keywordRows.Add(new KeywordRow());

    private void RemoveKeywordRow(int index)
    {
        if (keywordRows.Count > 1 && index >= 0 && index < keywordRows.Count)
            keywordRows.RemoveAt(index);
    }

    private void ApplyPresetsForTemplate()
    {
        var group = presetConfig?.Presets?
            .FirstOrDefault(p => string.Equals(p.Template, selectedTemplateName, StringComparison.OrdinalIgnoreCase));
        availableLogFiles = group?.Files ?? new List<string>();
        if (!string.IsNullOrWhiteSpace(group?.DefaultFile))
            logFile = group!.DefaultFile!;
    }

    private async Task CopyResults()
    {
        if (filteredLogLines.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join("\t", tableColumns));
        foreach (var line in filteredLogLines)
        {
            var cells = tableColumns.Select(c =>
                (line.GetValueOrDefault(c, "") ?? "").Replace('\t', ' ').Replace('\r', ' ').Replace('\n', ' '));
            sb.AppendLine(string.Join("\t", cells));
        }

        try
        {
            await JS.InvokeVoidAsync("logTools.copyToClipboard", sb.ToString());
        }
        catch (Exception ex)
        {
            SetError($"Copy failed: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && filteredLogLines.Count > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("logTools.initColumnResize", "logResultsTable");
            }
            catch
            {
                // Non-fatal: column resizing is a progressive enhancement.
            }
        }
    }

    private async Task DownloadCsv()
    {
        if (isLoading || !hasSearched) return;

        var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
        if (templateEntry == null)
        {
            SetError("No template selected for CSV download.");
            return;
        }

        var originalLoading = isLoading;
        isLoading = true;
        StateHasChanged();

        try
        {
            var sorts = activeSorts.Count > 0 ? activeSorts : null;
            var criteria = BuildCriteria();
            var criteriaArg = criteria.HasContent ? criteria : null;

            var filePath = await LogFileService.DownloadLogCsvAsync(
                logFile,
                selectedLocations,
                startDate,
                endDate,
                templateEntry.Name,
                tableSearch,
                sorts,
                null,
                criteriaArg);

            // Open the file location in Explorer (for Blazor Hybrid/WinForms)
            if (!string.IsNullOrWhiteSpace(filePath) && File.Exists(filePath))
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"/select,\"{filePath}\"",
                    UseShellExecute = true
                };
                System.Diagnostics.Process.Start(psi);
            }
        }
        catch (Exception ex)
        {
            SetError($"CSV download failed: {ex.Message}");
        }
        finally
        {
            isLoading = originalLoading;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _searchDebounceTimer?.Dispose();
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}