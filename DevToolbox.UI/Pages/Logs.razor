@page "/logs"
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using System.Threading
@inject ILogFileService LogFileService
@implements IDisposable

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold text-gradient">Log Viewer</h1>
    <p class="text-dark-text-muted mt-2">View and analyze application logs with powerful search and filtering capabilities.</p>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4 mb-6 flex items-start justify-between">
        <div class="flex items-start space-x-3">
            <i class="bi bi-exclamation-triangle text-red-400 text-xl"></i>
            <div>
                <div class="font-medium text-red-400">Error</div>
                <div class="text-red-300 text-sm">@errorMessage</div>
            </div>
        </div>
        <button type="button" class="btn-ghost p-2" @onclick="ClearError">
            <i class="bi bi-x text-red-400"></i>
        </button>
    </div>
}

<!-- Search / Filters -->
<div class="modern-card mb-6">
    <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
        <div>
            <label for="templateSelect" class="block text-sm font-medium text-dark-text mb-2">Template</label>
            <select id="templateSelect" class="input-modern w-full" @bind="selectedTemplateName" @bind:after="OnTemplateChanged">
                @foreach (var template in availableTemplates)
                {
                    <option value="@template.Name">@template.Name</option>
                }
            </select>
        </div>
        <div class="md:col-span-2">
            <label for="locationSelect" class="block text-sm font-medium text-dark-text mb-2">Location</label>
            <select id="locationSelect" class="input-modern w-full" @bind="logLocationPath" @bind:after="OnLocationChanged">
                @foreach (var location in logLocations)
                {
                    <option value="@location.Path">@location.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="startDate" class="block text-sm font-medium text-dark-text mb-2">Start Date</label>
            <input id="startDate" type="date" class="input-modern w-full" @bind="startDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="endDate" class="block text-sm font-medium text-dark-text mb-2">End Date</label>
            <input id="endDate" type="date" class="input-modern w-full" @bind="endDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="logFile" class="block text-sm font-medium text-dark-text mb-2">Log File</label>
            <input id="logFile" class="input-modern w-full" list="logFiles" placeholder="Log file..." @bind="logFile" />
            <datalist id="logFiles">
                @foreach (var file in availableLogFiles)
                {
                    <option value="@file"></option>
                }
            </datalist>
        </div>
    </div>
    
    <div class="flex items-end gap-4 mt-6">
        <button class="btn-primary flex items-center space-x-2" @onclick="Search" disabled="@isLoading" aria-describedby="searchHelp">
            @if (isLoading)
            {
                <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
            }
            else
            {
                <i class="bi bi-search"></i>
            }
            <span>Search</span>
        </button>
        <button class="btn-secondary flex items-center space-x-2" @onclick="DownloadCsv" disabled="@(isLoading || filteredLogLines.Count == 0)" title="Download as CSV">
            <i class="bi bi-download"></i>
            <span>CSV</span>
        </button>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
        <div>
            <label for="tableSearch" class="block text-sm font-medium text-dark-text mb-2">Search in results</label>
            <input id="tableSearch" type="text" class="input-modern w-full" @bind="tableSearch" @bind:event="oninput" @onkeypress="OnSearchKeyPress" placeholder="Search table..." />
            <div class="text-xs text-dark-text-muted mt-1">Press Enter or wait 500ms to search</div>
        </div>
        <div class="flex items-end">
            @if (isLoading)
            {
                <div class="flex items-center space-x-2 text-dark-text-muted">
                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-accent-blue"></div>
                    <span>Loading logs...</span>
                </div>
            }
            else if (filteredLogLines.Count > 0)
            {
                <div class="text-dark-text-muted">
                    Showing <span class="text-accent-blue font-medium">@filteredLogLines.Count</span> of <span class="text-accent-blue font-medium">@totalRecords</span> records
                </div>
            }
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="modern-card text-center py-16">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-accent-blue mx-auto"></div>
        <p class="mt-4 text-dark-text-muted">Loading logs, please wait...</p>
    </div>
}
else if (filteredLogLines.Count == 0 && !hasSearched)
{
    <div class="modern-card text-center py-16">
        <i class="bi bi-search text-6xl text-dark-text-muted"></i>
        <p class="text-dark-text-muted mt-4">Enter your search criteria and click "Search" to view logs.</p>
    </div>
}
else if (filteredLogLines.Count == 0)
{
    <div class="modern-card text-center py-16">
        <i class="bi bi-inbox text-6xl text-dark-text-muted"></i>
        <p class="text-dark-text-muted mt-4">No logs found matching your criteria. Try adjusting your filters or date range.</p>
    </div>
}
else
{
    <div class="modern-card">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-semibold text-dark-text flex items-center space-x-2">
                <i class="bi bi-table text-accent-blue"></i>
                <span>Log Results</span>
            </h2>
            <div class="flex items-center space-x-2">
                <label class="text-sm text-dark-text-muted">Page size:</label>
                <select class="input-modern w-auto" @bind="pageSize" @bind:after="OnPageSizeChanged">
                    <option value="100">100</option>
                    <option value="250">250</option>
                    <option value="500">500</option>
                    <option value="1000">1000</option>
                </select>
            </div>
        </div>
        
        <div class="border border-dark-border rounded-lg overflow-hidden">
            <div style="max-height: 600px; overflow: auto;" tabindex="0" role="region" aria-label="Log table">
                <table class="w-full" style="min-width: 1200px;">
                    <thead class="bg-dark-surface border-b border-dark-border sticky top-0 z-10">
                        <tr>
                            @foreach (var col in tableColumns)
                            {
                                <th class="px-4 py-3 text-left text-xs font-medium text-dark-text uppercase tracking-wider border-r border-dark-border cursor-pointer hover:bg-dark-surface-hover transition-colors"
                                    @onclick="() => SortByColumn(col)"
                                    @onkeypress="@(async (e) => { if (e.Key == "Enter" || e.Key == " ") await SortByColumn(col); })"
                                    tabindex="0"
                                    role="button"
                                    aria-label="Sort by @col">
                                    <div class="flex items-center justify-between">
                                        <span>@col</span>
                                        <span class="w-4 h-4 flex items-center justify-center">
                                            @if (sortColumn == col)
                                            {
                                                <i class="bi @(sortAscending ? "bi-chevron-up" : "bi-chevron-down") text-accent-blue"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-chevron-expand text-dark-text-muted opacity-0 hover:opacity-100"></i>
                                            }
                                        </span>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody class="bg-dark-bg">
                        <Virtualize Items="@filteredLogLines" ItemSize="32" OverscanCount="10">
                            <ItemContent Context="logLine">
                                <tr class="border-b border-dark-border hover:bg-dark-surface/50 transition-colors" role="row">
                                    @foreach (var col in tableColumns)
                                    {
                                        <td class="px-4 py-3 text-sm text-dark-text border-r border-dark-border max-w-xs overflow-hidden text-ellipsis whitespace-nowrap"
                                            title="@logLine.GetValueOrDefault(col, "")" role="cell">
                                            @logLine.GetValueOrDefault(col, "")
                                        </td>
                                    }
                                </tr>
                            </ItemContent>
                            <Placeholder>
                                <tr class="border-b border-dark-border">
                                    @for (int i = 0; i < tableColumns.Count; i++)
                                    {
                                        <td class="px-4 py-3 border-r border-dark-border">
                                            <div class="animate-pulse">
                                                <div class="h-4 bg-dark-surface rounded w-3/4"></div>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            </Placeholder>
                        </Virtualize>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="flex justify-between items-center mt-6" role="navigation" aria-label="Pagination">
            <button class="btn-secondary flex items-center space-x-2" @onclick="PrevPage" disabled="@(isLoading || currentPage == 0)" aria-label="Previous page">
                <i class="bi bi-chevron-left"></i>
                <span>Previous</span>
            </button>

            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-2">
                    <label for="pageInput" class="text-sm text-dark-text-muted">Page:</label>
                    <input id="pageInput"
                           type="number"
                           class="input-modern w-20 text-center"
                           min="1"
                           max="@totalPages"
                           @bind="pageInput"
                           @bind:event="oninput"
                           @onkeypress="OnPageKeyPress" />
                    <button class="btn-secondary px-3 py-1" @onclick="JumpToPage" disabled="@isLoading">Go</button>
                </div>
                <span class="text-sm text-dark-text">
                    of <span class="font-semibold text-accent-blue">@totalPages</span> 
                    (<span class="font-semibold text-accent-blue">@totalRecords</span> total)
                </span>
            </div>

            <button class="btn-secondary flex items-center space-x-2" @onclick="NextPage" disabled="@(isLoading || !hasMorePages)" aria-label="Next page">
                <span>Next</span>
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
}


@code {
    // State management
    private string logLocationPath = string.Empty;
    private List<LogLocation> logLocations = new();
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private string logFile = string.Empty;
    private string tableSearch = string.Empty;
    private List<string> availableLogFiles = new();
    private List<LogTemplateIndexEntry> availableTemplates = new();
    private string selectedTemplateName = "";
    private List<Dictionary<string, string>> originalLogLines = new();
    private List<Dictionary<string, string>> filteredLogLines = new();
    private List<string> tableColumns = new();
    private bool isLoading = false;
    private string sortColumn = "";
    private bool sortAscending = true;
    private bool hasSearched = false;
    private string errorMessage = "";
    
    // Pagination state
    private int currentPage = 0;
    private int pageSize = 500;
    private bool hasMorePages = true;
    private int pageInput = 1;
    private int totalPages = 0;
    private int totalRecords = 0;
    
    // Debouncing
    private System.Threading.Timer? _searchDebounceTimer;
    private CancellationTokenSource? _cancellationTokenSource;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            isLoading = true;
            
            var locationsTask = LogFileService.GetLogLocationsAsync();
            var templatesTask = LogFileService.GetAvailableLogFileTemplatesAsync();
            
            await Task.WhenAll(locationsTask, templatesTask);
            
            logLocations = await locationsTask ?? new List<LogLocation>();
            availableTemplates = await templatesTask ?? new List<LogTemplateIndexEntry>();
            
            selectedTemplateName = availableTemplates.FirstOrDefault()?.Name ?? string.Empty;
            logLocationPath = logLocations.FirstOrDefault()?.Path ?? string.Empty;
            
            if (!string.IsNullOrEmpty(selectedTemplateName))
            {
                await UpdateTableColumnsAsync();
            }
        }
        catch (Exception ex)
        {
            SetError($"Failed to load initial data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnTemplateChanged()
    {
        await UpdateTableColumnsAsync();
        ResetPagination();
    }

    private Task OnLocationChanged()
    {
        // Could load available log files for this location
        ResetPagination();
        return Task.CompletedTask;
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 0;
        pageInput = 1;
        
        if (hasSearched)
        {
            await LoadPageAsync();
        }
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CancelSearch();
            await PerformTableSearch();
        }
        else
        {
            DebounceTableSearch();
        }
    }

    private async Task OnPageKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await JumpToPage();
        }
    }

    private void DebounceTableSearch()
    {
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new Timer(async _ => 
        {
            await InvokeAsync(PerformTableSearch);
        }, null, TimeSpan.FromMilliseconds(500), Timeout.InfiniteTimeSpan);
    }

    private async Task PerformTableSearch()
    {
        _searchDebounceTimer?.Dispose();
        ResetPagination();
        
        if (hasSearched)
        {
            await LoadPageAsync();
        }
    }

    private void ResetPagination()
    {
        currentPage = 0;
        pageInput = 1;
        totalPages = 0;
        totalRecords = 0;
        hasMorePages = true;
    }

    private void CancelSearch()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = new CancellationTokenSource();
    }

    private void SetError(string message)
    {
        errorMessage = message;
        StateHasChanged();
    }

    private void ClearError()
    {
        errorMessage = "";
        StateHasChanged();
    }

    private async Task Search()
    {
        ClearError();
        CancelSearch();
        
        if (string.IsNullOrWhiteSpace(selectedTemplateName))
        {
            SetError("Please select a template.");
            return;
        }
        
        if (string.IsNullOrWhiteSpace(logLocationPath))
        {
            SetError("Please select a log location.");
            return;
        }
        
        if (startDate > endDate)
        {
            SetError("Start date cannot be after end date.");
            return;
        }

        ResetPagination();
        hasSearched = true;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        if (isLoading || _cancellationTokenSource?.Token.IsCancellationRequested == true) 
            return;

        isLoading = true;
        StateHasChanged();

        try
        {
            var token = _cancellationTokenSource?.Token ?? CancellationToken.None;
            
            var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
            if (templateEntry == null)
            {
                SetError($"Template '{selectedTemplateName}' not found.");
                return;
            }

            // Load count and data in parallel
            var countTask = LogFileService.CountLogEntriesAsync(logFile, logLocationPath, startDate, endDate, templateEntry.Name, tableSearch);
            var sortColumn = new SortColumn { Column = this.sortColumn, Direction = sortAscending ? "asc" : "desc" };
            var dataTask = LogFileService.SearchLogFilesPageAsync(logFile, logLocationPath, startDate, endDate, templateEntry.Name, tableSearch, currentPage, pageSize, sortColumn);

            await Task.WhenAll(countTask, dataTask);
            
            if (token.IsCancellationRequested) return;

            totalRecords = await countTask;
            totalPages = (int)Math.Ceiling(totalRecords / (double)pageSize);
            
            var pageData = await dataTask;
            originalLogLines = pageData ?? new List<Dictionary<string, string>>();
            filteredLogLines = originalLogLines;

            // Update columns from actual data
            if (pageData?.Any() == true)
            {
                tableColumns = pageData.OrderByDescending(l => l.Count).FirstOrDefault()?.Keys.ToList() ?? new List<string>();
            }

            hasMorePages = pageData?.Count == pageSize && (currentPage + 1) < totalPages;
            pageInput = currentPage + 1;
        }
        catch (OperationCanceledException)
        {
            // Search was cancelled, ignore
            return;
        }
        catch (Exception ex)
        {
            SetError($"Search failed: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task JumpToPage()
    {
        if (pageInput < 1) pageInput = 1;
        if (pageInput > totalPages) pageInput = totalPages;

        var newPage = pageInput - 1;
        if (newPage != currentPage)
        {
            currentPage = newPage;
            await LoadPageAsync();
        }
    }

    private async Task NextPage()
    {
        if (hasMorePages && currentPage < totalPages - 1)
        {
            currentPage++;
            await LoadPageAsync();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 0)
        {
            currentPage--;
            await LoadPageAsync();
        }
    }

    private async Task SortByColumn(string column)
    {
        if (isLoading || !hasSearched) return;

        // Toggle sort direction if the same column, otherwise default to ascending
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        // Reset to first page when sorting changes
        currentPage = 0;
        pageInput = 1;
        
        await LoadPageAsync();
    }

    private async Task UpdateTableColumnsAsync()
    {
        try
        {
            var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
            if (templateEntry != null)
            {
                var template = await LogFileService.LoadTemplateAsync(templateEntry.File);
                tableColumns = template?.Columns ?? new List<string>();
            }
        }
        catch (Exception ex)
        {
            SetError($"Failed to update table columns: {ex.Message}");
        }
    }

    private async Task DownloadCsv()
    {
        if (isLoading || !hasSearched) return;

        var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
        if (templateEntry == null)
        {
            SetError("No template selected for CSV download.");
            return;
        }

        var originalLoading = isLoading;
        isLoading = true;
        StateHasChanged();

        try
        {
            var sort = new SortColumn
            {
                Column = sortColumn,
                Direction = sortAscending ? "asc" : "desc"
            };

            var filePath = await LogFileService.DownloadLogCsvAsync(
                logFile,
                logLocationPath,
                startDate,
                endDate,
                templateEntry.Name,
                tableSearch,
                sort);

            // Open the file location in Explorer (for Blazor Hybrid/WinForms)
            if (!string.IsNullOrWhiteSpace(filePath) && File.Exists(filePath))
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"/select,\"{filePath}\"",
                    UseShellExecute = true
                };
                System.Diagnostics.Process.Start(psi);
            }
        }
        catch (Exception ex)
        {
            SetError($"CSV download failed: {ex.Message}");
        }
        finally
        {
            isLoading = originalLoading;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _searchDebounceTimer?.Dispose();
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}