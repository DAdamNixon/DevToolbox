@page "/logs"
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using DevToolbox.UI.Services
@using DevToolbox.UI.Components.Dialogs
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using System.Threading
@using DevToolbox.Services.Services
@inject ILogFileService LogFileService
@inject IYamlStorageService YamlStorage
@inject IJSRuntime JS
@inject LogSearchStateService State
@inject ISystemService SystemService
@inject IOpenHandlerService OpenHandlers
@implements IDisposable

@* No page header at all: the nav bar already names the active tab, and every
   pixel of chrome here comes out of the results table. *@

@if (!string.IsNullOrWhiteSpace(State.ErrorMessage))
{
    <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4 mb-6 flex items-start justify-between">
        <div class="flex items-start space-x-3">
            <i class="bi bi-exclamation-triangle text-red-400 text-xl"></i>
            <div>
                <div class="font-medium text-red-400">Error</div>
                <div class="text-red-300 text-sm">@State.ErrorMessage</div>
            </div>
        </div>
        <button type="button" class="btn-ghost p-2" @onclick="State.ClearError">
            <i class="bi bi-x text-red-400"></i>
        </button>
    </div>
}

<!-- Search source. Collapses to a one-line summary after a search so the
     results get the screen; the filter bar below stays out because it is the
     part you keep touching while reading them. -->
<div class="modern-card mb-4 @(State.SourceCollapsed ? "log-card-compact" : null)">
    @if (State.SourceCollapsed)
    {
        <div class="log-source-summary">
            <span class="log-source-summary-text"><strong>Source:</strong> @State.SourceSummary</span>
            <button class="btn-primary flex items-center space-x-2" @onclick="Search" disabled="@State.IsLoading" title="Read these files in again">
                @if (State.IsLoading)
                {
                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-down"></i>
                }
                <span>Load Logs</span>
            </button>
            @if (State.IsLoading)
            {
                <button class="btn-danger flex items-center space-x-2" @onclick="CancelSearch" disabled="@State.IsCancelling" title="Stop the running search">
                    <span>@(State.IsCancelling ? "Cancelling…" : "Cancel")</span>
                </button>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
            <div>
                @* The gear sits on the label rather than off in a settings page: a template that
                   parses the file wrongly is discovered right here, with the wrong columns on
                   screen. It is a *sibling* of the label rather than inside it, because a button
                   within a label carrying `for` has its click forwarded to the control as well. *@
                <div class="log-field-head">
                    <label for="templateSelect" class="text-sm font-medium text-dark-text">Template</label>
                    <button type="button" class="log-config-open" title="Add, edit or remove templates"
                            @onclick="OpenTemplateConfig">
                        <i class="bi bi-sliders"></i>
                    </button>
                </div>
                <select id="templateSelect" class="input-modern w-full" @bind="State.SelectedTemplateName" @bind:after="OnTemplateChanged">
                    @foreach (var template in State.AvailableTemplates)
                    {
                        <option value="@template.Name">@template.Name</option>
                    }
                </select>
            </div>
            <div class="md:col-span-2 relative">
                <div class="log-field-head">
                    <span class="text-sm font-medium text-dark-text">Location</span>
                    <button type="button" class="log-config-open" title="Add or remove locations"
                            @onclick="OpenLocationConfig">
                        <i class="bi bi-sliders"></i>
                    </button>
                </div>
                <button type="button" class="input-modern w-full text-left flex items-center justify-between" @onclick="ToggleLocationMenu">
                    <span class="truncate">@State.LocationSummary</span>
                    <i class="bi bi-chevron-down text-dark-text-muted ml-2"></i>
                </button>
                @if (State.ShowLocationMenu)
                {
                    <div class="absolute z-20 mt-1 w-full bg-dark-surface border border-dark-border rounded-lg shadow-lg max-h-64 overflow-auto">
                        <label class="flex items-center space-x-2 px-3 py-2 hover:bg-dark-surface-hover cursor-pointer border-b border-dark-border">
                            <input type="checkbox" checked="@State.AllLocationsSelected" @onchange="_ => State.ToggleAllLocationsAsync()" />
                            <span class="text-sm text-dark-text font-medium">Select all</span>
                        </label>
                        @foreach (var location in State.LogLocations)
                        {
                            <label class="flex items-center space-x-2 px-3 py-2 hover:bg-dark-surface-hover cursor-pointer">
                                <input type="checkbox" checked="@State.IsLocationSelected(location)" @onchange="_ => State.ToggleLocationAsync(location)" />
                                <span class="text-sm text-dark-text">@location.Name</span>
                            </label>
                        }
                    </div>
                }
            </div>
            <div>
                <label for="startDate" class="block text-sm font-medium text-dark-text mb-2">Start Date</label>
                <input id="startDate" type="date" class="input-modern w-full" @bind="State.StartDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label for="endDate" class="block text-sm font-medium text-dark-text mb-2">End Date</label>
                <input id="endDate" type="date" class="input-modern w-full" @bind="State.EndDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label for="logFile" class="flex items-center justify-between text-sm font-medium text-dark-text mb-2">
                    <span>Log File</span>
                    @if (State.IsDiscoveringLogFiles)
                    {
                        <span class="flex items-center gap-1 text-xs font-normal text-dark-text-muted">
                            <span class="animate-spin rounded-full h-3 w-3 border-b-2 border-accent-blue"></span>
                            finding
                        </span>
                    }
                    else if (State.LogFilesWereDiscovered)
                    {
                        <span class="text-xs font-normal text-dark-text-muted">@State.AvailableLogFiles.Count found</span>
                    }
                </label>
                @* Still an input with a datalist rather than a select: the discovered
                   list is a convenience, and typing a name that is not on it — because
                   a share is offline, or the location has no name pattern — has to keep
                   working exactly as before. *@
                <input id="logFile" class="input-modern w-full" list="logFiles" placeholder="Log file..." @bind="State.LogFile" />
                <datalist id="logFiles">
                    @foreach (var file in State.AvailableLogFiles)
                    {
                        @* The count rides in the option label, which browsers show
                           beside the value; the value itself stays the bare name. *@
                        <option value="@file" label="@DescribeFileOption(file)"></option>
                    }
                </datalist>
            </div>
        </div>

        @* "Load Logs", not "Search": this button reads the files off disk into the table, and the
           filter bar below is what searches them. Called Search, it read as the last step of the
           form — people typed their keywords first and clicked it expecting results, which is a
           different and much slower thing than what it does. *@
        <div class="flex items-end gap-4 mt-6">
            <button class="btn-primary flex items-center space-x-2" @onclick="Search" disabled="@State.IsLoading"
                    title="Read the matching files into the table, then filter them below">
                @if (State.IsLoading)
                {
                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
                }
                else
                {
                    <i class="bi bi-box-arrow-in-down"></i>
                }
                <span>Load Logs</span>
            </button>
            @if (State.IsLoading)
            {
                <button class="btn-danger flex items-center space-x-2" @onclick="CancelSearch" disabled="@State.IsCancelling" title="Stop the running search">
                    <i class="bi bi-x-circle"></i>
                    <span>@(State.IsCancelling ? "Cancelling…" : "Cancel")</span>
                </button>
            }
        </div>

        @if (State.IsLoading)
        {
            <div class="mt-4">
                <div class="flex items-center justify-between text-sm text-dark-text-muted mb-2">
                    <span class="flex items-center space-x-2 min-w-0">
                        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-accent-blue flex-none"></div>
                        <span class="truncate">@ProgressHeadline()</span>
                    </span>
                    <span class="flex-none ml-4">@ProgressEta()</span>
                </div>

                @* Determinate whenever there is something to be determinate about. The
                   indeterminate stripe is for the gap before the first report arrives
                   and for the final query, which has no measurable size. *@
                <div class="w-full bg-dark-surface rounded-full h-2 overflow-hidden">
                    @if (State.Progress is { } p && p.PercentComplete > 0)
                    {
                        <div class="bg-accent-blue h-2 rounded-full transition-all duration-200"
                             style="width: @p.PercentComplete.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    }
                    else
                    {
                        <div class="bg-accent-blue h-2 rounded-full w-1/3 animate-pulse"></div>
                    }
                </div>

                @if (State.Progress?.CurrentFile is { Length: > 0 } current)
                {
                    <p class="text-xs text-dark-text-muted mt-1 truncate font-mono">@current</p>
                }
            </div>
        }
    }

    @* The bottom edge of the card is the expand/collapse control. Only offered
       once a search has run — before that there is nothing worth collapsing to,
       and a card that folds away its own empty form is just a trap. *@
    @if (State.HasSearched)
    {
        <div class="log-source-lip" role="button" tabindex="0"
             aria-expanded="@(!State.SourceCollapsed)"
             title="@(State.SourceCollapsed ? "Show the search source" : "Collapse the search source")"
             @onclick="ToggleSourceCollapsed"
             @onkeypress="@(e => { if (e.Key == "Enter" || e.Key == " ") ToggleSourceCollapsed(); })">
            <i class="bi @(State.SourceCollapsed ? "bi-chevron-down" : "bi-chevron-up")"></i>
            <span>@(State.SourceCollapsed ? "Edit search" : "Collapse")</span>
        </div>
    }
</div>

<!-- Filter bar. Always visible: keyword groups re-query the ingested table
     live, so they belong next to the results, not folded away with the source. -->
<div class="modern-card log-card-compact mb-4">
    <div class="flex items-center justify-between mb-3">
        <label class="flex items-center space-x-2 cursor-pointer">
            <input type="checkbox" @bind="State.AdvancedRawMode" @bind:after="OnAdvancedToggled" />
            <span class="text-sm font-medium text-dark-text">Advanced query mode (SQL)</span>
        </label>
        <span class="text-xs text-dark-text-muted">@(State.AdvancedRawMode ? "Full SQL against the table named logs." : "Filters the loaded rows as you type (Enter or 500ms). Rows combine with AND / OR / NOT.")</span>
    </div>

    @if (State.AdvancedRawMode)
    {
        <div>
            <label for="advExpr" class="block text-sm font-medium text-dark-text mb-2">Custom SQL query</label>
            <textarea id="advExpr" rows="3" class="input-modern w-full font-mono text-sm"
                      placeholder="SELECT LEFT(DateTime,4) AS Year, COUNT(*) AS Hits FROM logs GROUP BY Year"
                      @bind="State.AdvancedExpression" @bind:event="oninput" @bind:after="OnCriteriaInput"></textarea>
            <div class="text-xs text-dark-text-muted mt-1">Full SQL against the table <code>logs</code>, which holds whatever was last loaded. Sorting and keyword groups are ignored in this mode. Runs as you type (500ms) or on Enter.</div>
        </div>
    }
    else
    {
        <div class="space-y-2">
            @for (int i = 0; i < State.KeywordRows.Count; i++)
            {
                var index = i;
                var row = State.KeywordRows[index];
                <div class="flex items-center space-x-2">
                    @if (index == 0)
                    {
                        <span class="w-20 text-xs text-dark-text-muted text-center">where</span>
                    }
                    else
                    {
                        <select class="input-modern w-20" @bind="row.Gate" @bind:after="RunLiveQueryAsync">
                            <option value="AND">AND</option>
                            <option value="OR">OR</option>
                            <option value="NOT">NOT</option>
                        </select>
                    }
                    <input class="input-modern flex-1" placeholder="Interchangeable terms (any match), comma-separated"
                           @bind="row.Text" @bind:event="oninput" @bind:after="OnCriteriaInput" @onkeypress="OnCriteriaKeyPress" />
                    <button type="button" class="btn-ghost p-2"
                            title="@(State.KeywordRows.Count == 1 ? "Clear" : "Remove group")"
                            @onclick="() => RemoveKeywordRow(index)"
                            disabled="@(State.KeywordRows.Count == 1 && string.IsNullOrEmpty(row.Text))">
                        <i class="bi bi-x-lg text-dark-text-muted"></i>
                    </button>
                    @if (index == State.KeywordRows.Count - 1)
                    {
                        <button type="button" class="btn-ghost p-2" title="Add group" @onclick="AddKeywordRow">
                            <i class="bi bi-plus-lg text-dark-text-muted"></i>
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@if (State.IsLoading)
{
    <div class="modern-card text-center py-16">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-accent-blue mx-auto"></div>
        <p class="mt-4 text-dark-text">@ProgressHeadline()</p>
        @if (State.Progress is { } p && p.Phase != LogIngestPhase.Listing)
        {
            @* Separator keyed off the rendered text, not off Eta having a value:
               the querying phase has an Eta but deliberately renders nothing for
               it, which left a dangling "·" at the end of the line. *@
            var eta = ProgressEta();
            <p class="mt-1 text-sm text-dark-text-muted">
                @p.RowsIngested.ToString("N0") rows so far@(eta.Length == 0 ? "" : $" · {eta}")
            </p>
        }
        <button class="btn-secondary mt-6" @onclick="CancelSearch" disabled="@State.IsCancelling">
            @(State.IsCancelling ? "Cancelling…" : "Cancel")
        </button>
    </div>
}
else if (State.FilteredLogLines.Count == 0 && !State.HasSearched)
{
    <div class="modern-card text-center py-16">
        <i class="bi bi-box-arrow-in-down text-6xl text-dark-text-muted"></i>
        <p class="text-dark-text-muted mt-4">Pick a template, location and date range, then click <strong>Load Logs</strong>.</p>
        <p class="text-dark-text-muted text-sm mt-1">Keywords filter the rows once they are loaded.</p>
    </div>
}
else if (State.FilteredLogLines.Count == 0)
{
    <div class="modern-card text-center py-16">
        <i class="bi bi-inbox text-6xl text-dark-text-muted"></i>
        <p class="text-dark-text-muted mt-4">No logs found matching your criteria. Try adjusting your filters or date range.</p>
    </div>
}
else
{
    EnsureColumnMetrics();

    <div class="modern-card log-results-card @(State.ResultsFullscreen ? "is-fullscreen" : null)">
        <div class="log-toolbar">
            <div class="log-toolbar-group">
                <i class="bi bi-table text-accent-blue"></i>
                <span class="log-page-range">Showing <strong>@PageRangeStart().ToString("N0")–@PageRangeEnd().ToString("N0")</strong> of <strong>@State.TotalRecords.ToString("N0")</strong></span>
            </div>
            <div class="log-toolbar-group">
                <div class="log-segmented" role="group" aria-label="Results view">
                    <button type="button" class="@(!State.PlainTextView ? "active" : null)" @onclick="() => SetPlainTextView(false)" aria-pressed="@(!State.PlainTextView)">
                        <i class="bi bi-table"></i> Table
                    </button>
                    <button type="button" class="@(State.PlainTextView ? "active" : null)" @onclick="() => SetPlainTextView(true)" aria-pressed="@State.PlainTextView">
                        <i class="bi bi-text-left"></i> Text
                    </button>
                </div>
                @if (State.PlainTextView)
                {
                    <div class="log-segmented" role="group" aria-label="Line wrapping">
                        <button type="button" class="@(State.PlainTextWrap ? "active" : null)" @onclick="ToggleTextWrap" aria-pressed="@State.PlainTextWrap" title="Wrap long lines">
                            <i class="bi bi-arrow-return-left"></i> Wrap
                        </button>
                    </div>
                }
                else if (_emptyColumns.Count > 0)
                {
                    <div class="log-segmented" role="group" aria-label="Empty columns">
                        <button type="button" class="@(State.ShowEmptyColumns ? "active" : null)" @onclick="ToggleEmptyColumns" aria-pressed="@State.ShowEmptyColumns"
                                title="@_emptyColumns.Count columns hold nothing on this page">
                            <i class="bi bi-eye"></i> @_emptyColumns.Count empty
                        </button>
                    </div>
                }
            </div>
            <div class="log-toolbar-group">
                <span class="log-toolbar-label">Split by</span>
                <div class="log-segmented" role="group" aria-label="Split results">
                    @foreach (var option in SplitOptions)
                    {
                        <button type="button"
                                class="@(State.SplitMode == option.Mode ? "active" : null)"
                                @onclick="() => State.SetSplitModeAsync(option.Mode)"
                                disabled="@State.IsLoading"
                                aria-pressed="@(State.SplitMode == option.Mode)">
                            @option.Label
                        </button>
                    }
                </div>
            </div>
            <div class="log-toolbar-group">
                <span class="log-toolbar-label">Page size</span>
                <select class="input-modern w-auto" @bind="State.PageSize" @bind:after="OnPageSizeChanged">
                    <option value="100">100</option>
                    <option value="250">250</option>
                    <option value="500">500</option>
                    <option value="1000">1000</option>
                </select>
                @* Beside page size and CSV: the controls that decide how much you see
                   at once, rather than off with the row counts. *@
                <button type="button" class="btn-secondary flex items-center space-x-2" @onclick="ToggleResultsFullscreen"
                        title="@(State.ResultsFullscreen ? "Exit full screen (Esc)" : "Fill the window with the results")"
                        aria-pressed="@State.ResultsFullscreen">
                    <i class="bi @(State.ResultsFullscreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
                </button>
                <button class="btn-secondary flex items-center space-x-2" @onclick="DownloadCsv" disabled="@(State.IsLoading || State.FilteredLogLines.Count == 0)" title="Download the current view as CSV">
                    <i class="bi bi-download"></i>
                    <span>CSV</span>
                </button>
            </div>
        </div>

        @* Tab strip. Only shown when splitting is on — with one "All" tab it would
           be pure decoration. *@
        @if (State.SplitMode != LogSplitMode.None && State.Tabs.Count > 1)
        {
            <div class="flex items-end gap-1 mb-4 overflow-x-auto border-b border-dark-border" role="tablist">
                @for (var i = 0; i < State.Tabs.Count; i++)
                {
                    var index = i;
                    var tab = State.Tabs[i];
                    var isActive = index == State.ActiveTabIndex;
                    <button type="button"
                            role="tab"
                            aria-selected="@isActive"
                            class="flex-none px-4 py-2 text-sm whitespace-nowrap border-b-2 -mb-px transition-colors @(isActive ? "border-accent-blue text-accent-blue font-medium" : "border-transparent text-dark-text-muted hover:text-dark-text")"
                            @onclick="() => State.SelectTabAsync(index)"
                            disabled="@State.IsLoading"
                            title="@tab.Label">
                        @tab.Label
                        <span class="ml-2 text-xs text-dark-text-muted">@tab.RowCount.ToString("N0")</span>
                    </button>
                }
            </div>
        }

        <div class="border border-dark-border rounded-lg overflow-hidden log-results-frame">
            @if (State.PlainTextView)
            {
                @* The same rows, template order, rejoined with the template's own
                   delimiter — as close to the file's raw lines as the parse allows.
                   Filtering, sorting, tabs and paging all still apply because this
                   is just another rendering of FilteredLogLines. *@
                <div class="log-results-scroll log-textview @(State.PlainTextWrap ? "log-textview-wrap" : null)" tabindex="0" role="region" aria-label="Log text">
                    <Virtualize Items="@State.FilteredLogLines" ItemSize="18" OverscanCount="20">
                        <ItemContent Context="logLine">
                            <span class="log-textline @(IsContextRow(logLine) ? "log-row-context" : null)"
                                  @oncontextmenu="e => ShowContextMenu(e, logLine)"
                                  @oncontextmenu:preventDefault="true"
                                  title="Right-click for actions">@PlainTextLine(logLine)</span>
                        </ItemContent>
                    </Virtualize>
                </div>
            }
            else
            {
                <div class="log-results-scroll" tabindex="0" role="region" aria-label="Log table">
                    <table id="logResultsTable" class="log-table-dense select-text" style="min-width: @(TableMinWidth)px;">
                        <colgroup>
                            <col style="width: 1.75rem;" />
                            @foreach (var col in VisibleColumns)
                            {
                                @if (col == _flexColumn)
                                {
                                    <col />
                                }
                                else
                                {
                                    <col style="width: @(ColumnWidth(col))px;" />
                                }
                            }
                        </colgroup>
                        <thead class="border-b border-dark-border">
                            <tr>
                                <th aria-label="Expand row"></th>
                                @foreach (var col in VisibleColumns)
                                {
                                    var sortEntry = State.ActiveSorts.FirstOrDefault(s => s.Column == col);
                                    var sortIndex = State.ActiveSorts.FindIndex(s => s.Column == col);
                                    <th class="relative px-4 py-3 text-left text-xs font-medium text-dark-text uppercase tracking-wider border-r border-dark-border cursor-pointer hover:bg-dark-surface-hover transition-colors"
                                        @onclick="(e) => SortByColumn(col, e.ShiftKey)"
                                        @onkeypress="@(async (e) => { if (e.Key == "Enter" || e.Key == " ") await SortByColumn(col, false); })"
                                        tabindex="0"
                                        role="button"
                                        title="Click to sort, Shift+Click to add a secondary sort"
                                        aria-label="Sort by @col">
                                        <div class="flex items-center justify-between pr-2">
                                            <span class="truncate">@col</span>
                                            <span class="w-6 h-4 flex items-center justify-center">
                                                @if (sortEntry != null)
                                                {
                                                    <i class="bi @(sortEntry.Direction == "desc" ? "bi-chevron-down" : "bi-chevron-up") text-accent-blue"></i>
                                                    @if (State.ActiveSorts.Count > 1)
                                                    {
                                                        <span class="text-[10px] text-accent-blue ml-0.5">@(sortIndex + 1)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <i class="bi bi-chevron-expand text-dark-text-muted opacity-0 hover:opacity-100"></i>
                                                }
                                            </span>
                                        </div>
                                        <span class="col-resizer" style="position:absolute; top:0; right:0; width:6px; height:100%; cursor:col-resize;"></span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody class="bg-dark-bg">
                            <Virtualize Items="@State.FilteredLogLines" ItemSize="24" OverscanCount="15">
                                <ItemContent Context="logLine">
                                    @* Right-click opens the row menu. Left click is left alone so
                                       selecting and copying text still works, and the chevron cell
                                       stays as the quick way to expand without the menu. *@
                                    <tr class="border-b border-dark-border transition-colors @(IsRowExpanded(logLine) ? "log-row-expanded" : null) @(IsContextRow(logLine) ? "log-row-context" : null)" role="row"
                                        @oncontextmenu="e => ShowContextMenu(e, logLine)"
                                        @oncontextmenu:preventDefault="true"
                                        title="Right-click for actions">
                                        <td class="log-expander" role="cell"
                                            title="@(IsRowExpanded(logLine) ? "Collapse this row" : "Show this row's full content")"
                                            @onclick="() => ToggleRowExpanded(logLine)">
                                            <i class="bi @(IsRowExpanded(logLine) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                        </td>
                                        @foreach (var col in VisibleColumns)
                                        {
                                            <td class="select-text" role="cell" title="@logLine.GetValueOrDefault(col, "")">@logLine.GetValueOrDefault(col, "")</td>
                                        }
                                    </tr>
                                </ItemContent>
                                <Placeholder>
                                    <tr class="border-b border-dark-border">
                                        <td class="log-expander"></td>
                                        @for (int i = 0; i < VisibleColumns.Count(); i++)
                                        {
                                            <td>
                                                <div class="animate-pulse">
                                                    <div class="h-4 bg-dark-surface rounded w-3/4"></div>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                </Placeholder>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="log-pagination" role="navigation" aria-label="Pagination">
            <div class="log-toolbar-group">
                <button class="btn-secondary" @onclick="FirstPage" disabled="@(State.IsLoading || State.CurrentPage == 0)" aria-label="First page" title="First page">
                    <i class="bi bi-chevron-double-left"></i>
                </button>
                <button class="btn-secondary flex items-center space-x-2" @onclick="PrevPage" disabled="@(State.IsLoading || State.CurrentPage == 0)" aria-label="Previous page">
                    <i class="bi bi-chevron-left"></i>
                    <span>Previous</span>
                </button>
            </div>

            <div class="log-toolbar-group">
                <label for="pageInput" class="log-toolbar-label">Page</label>
                @* No Go button: typing a page number jumps after a beat, Enter jumps
                   at once. Nothing fires while the box is empty mid-edit. *@
                <input id="pageInput"
                       type="number"
                       class="input-modern w-20 text-center"
                       min="1"
                       max="@State.TotalPages"
                       @bind="State.PageInput"
                       @bind:event="oninput"
                       @bind:after="OnPageInputChanged"
                       @onkeypress="OnPageKeyPress" />
                <span class="log-toolbar-label">of <strong class="text-accent-blue">@State.TotalPages.ToString("N0")</strong></span>
            </div>

            <div class="log-toolbar-group">
                <button class="btn-secondary flex items-center space-x-2" @onclick="NextPage" disabled="@(State.IsLoading || !State.HasMorePages)" aria-label="Next page">
                    <span>Next</span>
                    <i class="bi bi-chevron-right"></i>
                </button>
                <button class="btn-secondary" @onclick="LastPage" disabled="@(State.IsLoading || State.CurrentPage >= State.TotalPages - 1)" aria-label="Last page" title="Last page">
                    <i class="bi bi-chevron-double-right"></i>
                </button>
            </div>
        </div>
    </div>
}


@* Row actions. Rendered at the page level rather than inside the table: it is
   positioned from the pointer, and the results container scrolls and clips, which
   would cut the menu off at its edge. The backdrop is what closes it on the next
   click anywhere. *@
@if (_contextRow is not null)
{
    <div class="log-context-backdrop" @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault="true"></div>
    <div class="log-context-menu" style="left: @(_contextX)px; top: @(_contextY)px;" role="menu">
        <div class="log-context-heading">@ContextRowSummary()</div>

        @if (!State.PlainTextView)
        {
            <button type="button" class="dropdown-item" role="menuitem" @onclick="ToggleContextRowExpanded">
                <i class="bi @(IsRowExpanded(_contextRow) ? "bi-arrows-collapse" : "bi-arrows-expand")"></i>
                <span>@(IsRowExpanded(_contextRow) ? "Collapse row" : "Expand row")</span>
            </button>
        }

        <button type="button" class="dropdown-item" role="menuitem"
                @onclick="OpenContextRowSource" disabled="@(!ContextRowHasSource())"
                title="@(ContextRowHasSource() ? null : "This row has no source file recorded. Run the search again.")">
            <i class="bi bi-box-arrow-up-right"></i>
            <span>Open in editor</span>
        </button>

        <button type="button" class="dropdown-item" role="menuitem" @onclick="CopyContextRow">
            <i class="bi bi-clipboard"></i>
            <span>Copy line</span>
        </button>
    </div>
}

<LogSourceConfigDialog IsVisible="_sourceConfigVisible"
                       IsVisibleChanged="OnSourceConfigVisibleChanged"
                       OpenOn="@_sourceConfigTab"
                       OnSaved="OnSourceConfigSaved" />

@code {

    // --- template and location editor ---

    private bool _sourceConfigVisible;
    private string _sourceConfigTab = "templates";

    private void OpenTemplateConfig() => OpenSourceConfig("templates");

    private void OpenLocationConfig() => OpenSourceConfig("locations");

    private void OpenSourceConfig(string tab)
    {
        _sourceConfigTab = tab;
        _sourceConfigVisible = true;

        // The location dropdown is a hand-rolled panel with no outside-click handler of its own, so
        // it would sit over the dialog's backdrop.
        State.ShowLocationMenu = false;
    }

    private void OnSourceConfigVisibleChanged(bool visible) => _sourceConfigVisible = visible;

    /// <summary>
    /// The config was written, so the lists this page has been holding since startup are stale.
    /// Called on every save rather than on close: the dialog stays open across several saves, and the
    /// picker behind it should already agree with what was just saved.
    /// </summary>
    private async Task OnSourceConfigSaved() => await State.ReloadConfigAsync();

    // --- full-screen results ---

    private DotNetObjectReference<Logs>? _self;

    private void ToggleResultsFullscreen() => State.ResultsFullscreen = !State.ResultsFullscreen;

    /// <summary>Called from the document keydown listener; see wwwroot/js/logTools.js.</summary>
    [JSInvokable]
    public Task ExitFullscreen()
    {
        // Only a state change when there is something to exit, so Escape elsewhere on
        // the page does not cost a render.
        if (!State.ResultsFullscreen) return Task.CompletedTask;

        State.ResultsFullscreen = false;
        return InvokeAsync(StateHasChanged);
    }

    // --- row context menu ---

    /// <summary>The row the menu was opened on, and null when no menu is open.</summary>
    private Dictionary<string, string>? _contextRow;
    private double _contextX;
    private double _contextY;

    private bool IsContextRow(Dictionary<string, string> row) => ReferenceEquals(_contextRow, row);

    /// <summary>
    /// Opens the row menu at the pointer. Client coordinates, because the menu is
    /// position:fixed — page coordinates would be off by the scroll offset.
    /// <para>
    /// Nudged back from the right and bottom edges so a right-click near either does
    /// not put half the menu off-screen. The sizes are the panel's own min-width and
    /// its rough height at three items; being approximate is fine, since the only cost
    /// of being wrong is a menu that sits slightly inside the edge instead of against it.
    /// </para>
    /// </summary>
    private async Task ShowContextMenu(MouseEventArgs e, Dictionary<string, string> row)
    {
        const double menuWidth = 208;
        const double menuHeight = 160;

        _contextRow = row;
        _contextX = e.ClientX;
        _contextY = e.ClientY;

        try
        {
            var viewport = await JS.InvokeAsync<Viewport>("logTools.viewportSize");
            _contextX = Math.Max(4, Math.Min(e.ClientX, viewport.Width - menuWidth));
            _contextY = Math.Max(4, Math.Min(e.ClientY, viewport.Height - menuHeight));
        }
        catch (JSException)
        {
            // Keep the raw pointer position: a menu that might overhang an edge beats
            // no menu at all.
        }
    }

    private sealed record Viewport(double Width, double Height);

    private void CloseContextMenu() => _contextRow = null;

    private void ToggleContextRowExpanded()
    {
        if (_contextRow is { } row) ToggleRowExpanded(row);
        CloseContextMenu();
    }

    private bool ContextRowHasSource() =>
        _contextRow is { } row && !string.IsNullOrWhiteSpace(row.GetValueOrDefault(DbLogService.SourcePathColumn, ""));

    private async Task OpenContextRowSource()
    {
        var row = _contextRow;
        CloseContextMenu();
        if (row is not null) await OpenRowSource(row);
    }

    /// <summary>The row as one delimited line, on the clipboard.</summary>
    private async Task CopyContextRow()
    {
        var row = _contextRow;
        CloseContextMenu();
        if (row is null) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", PlainTextLine(row));
        }
        catch (JSException ex)
        {
            // Clipboard access can be refused, and a failed copy must not look like it worked.
            State.SetError($"Could not copy the line: {ex.Message}");
        }
    }

    /// <summary>What the menu shows at the top, so it is obvious which row it acts on.</summary>
    private string ContextRowSummary()
    {
        if (_contextRow is not { } row) return "";

        var line = PlainTextLine(row);
        return line.Length <= 60 ? line : line[..60] + "…";
    }
    private System.Threading.Timer? _searchDebounceTimer;
    private System.Threading.Timer? _pageDebounceTimer;

    // --- column metrics, computed per page of results ---

    /// <summary>The page of rows the widths below were measured against.</summary>
    private List<Dictionary<string, string>>? _measuredRows;
    private readonly Dictionary<string, int> _columnWidths = new();
    private readonly HashSet<string> _emptyColumns = new();
    private string? _flexColumn;
    private HashSet<Dictionary<string, string>> _expandedRows = new();

    /// <summary>
    /// The columns the table actually renders: everything, minus the ones that
    /// hold nothing on this page unless the user asked to see those too.
    /// </summary>
    private IEnumerable<string> VisibleColumns =>
        State.ShowEmptyColumns ? State.TableColumns : State.TableColumns.Where(c => !_emptyColumns.Contains(c));

    /// <summary>Sum of the fixed column widths plus room for the flex column.</summary>
    private int TableMinWidth =>
        28 + VisibleColumns.Where(c => c != _flexColumn).Sum(c => ColumnWidth(c)) + 280;

    /// <summary>
    /// Sizes each column to its content instead of a flat 160px each. Widths come
    /// from the longest value on the current page (capped), the column with the
    /// longest content — almost always the message — flexes to take whatever
    /// space is left, and columns that hold nothing at all are noted so the
    /// table can drop them. Re-measured only when the page of rows changes.
    /// </summary>
    private void EnsureColumnMetrics()
    {
        if (ReferenceEquals(_measuredRows, State.FilteredLogLines)) return;
        _measuredRows = State.FilteredLogLines;
        _expandedRows = new HashSet<Dictionary<string, string>>();
        _columnWidths.Clear();
        _emptyColumns.Clear();
        _flexColumn = null;

        // Every row, not a sample: a column with its one value on row 900 must
        // not be dropped as empty. Length checks over a 1000-row page are cheap.
        var maxLengths = State.TableColumns.ToDictionary(c => c, c => 0);
        foreach (var row in State.FilteredLogLines)
        {
            foreach (var col in State.TableColumns)
            {
                var length = row.GetValueOrDefault(col, "").Length;
                if (length > maxLengths[col]) maxLengths[col] = length;
            }
        }

        foreach (var (col, length) in maxLengths)
        {
            if (length == 0) _emptyColumns.Add(col);
            // ~7.2px per character of 12px mono, plus cell padding; the header
            // needs room for its own name too.
            _columnWidths[col] = Math.Clamp((int)(Math.Max(length, col.Length) * 7.2) + 20, 72, 480);
            if (length > 0 && (_flexColumn is null || length > maxLengths[_flexColumn])) _flexColumn = col;
        }
    }

    private int ColumnWidth(string col) => _columnWidths.GetValueOrDefault(col, 160);

    private bool IsRowExpanded(Dictionary<string, string> row) => _expandedRows.Contains(row);

    private void ToggleRowExpanded(Dictionary<string, string> row)
    {
        if (!_expandedRows.Remove(row)) _expandedRows.Add(row);
    }

    // --- plain text mode ---

    /// <summary>
    /// Columns DbLogService appends about where a row came from, as opposed to
    /// what the file said. Text mode leaves them out so the line reads like the
    /// file; the table keeps them because sorting by SourceFile is useful.
    /// </summary>
    private static readonly IReadOnlyList<string> ProvenanceColumns = LogProvenanceColumns.Visible;

    /// <summary>
    /// The row rejoined with the template's delimiter — as close to the original
    /// line as the parse allows: provenance columns left out, trailing empty
    /// fields trimmed rather than rendered as a run of delimiters.
    /// </summary>
    private string PlainTextLine(Dictionary<string, string> logLine)
    {
        var values = State.TableColumns
            .Where(c => !ProvenanceColumns.Contains(c))
            .Select(c => logLine.GetValueOrDefault(c, ""))
            .ToList();
        while (values.Count > 0 && string.IsNullOrEmpty(values[^1])) values.RemoveAt(values.Count - 1);
        return string.Join(State.TemplateDelimiter, values);
    }

    private void SetPlainTextView(bool plainText) => State.PlainTextView = plainText;

    private void ToggleTextWrap() => State.PlainTextWrap = !State.PlainTextWrap;

    private void ToggleEmptyColumns() => State.ShowEmptyColumns = !State.ShowEmptyColumns;

    private void ToggleSourceCollapsed() => State.SourceCollapsed = !State.SourceCollapsed;

    // --- pagination helpers ---

    private int PageRangeStart() =>
        State.TotalRecords == 0 ? 0 : State.CurrentPage * State.PageSize + 1;

    private int PageRangeEnd() =>
        Math.Min((State.CurrentPage + 1) * State.PageSize, State.TotalRecords);

    private async Task FirstPage()
    {
        State.PageInput = 1;
        await State.JumpToPageAsync();
    }

    private async Task LastPage()
    {
        State.PageInput = State.TotalPages;
        await State.JumpToPageAsync();
    }

    /// <summary>
    /// Typed page numbers jump on their own after a beat — no Go button. Values
    /// below 1 mean the box is empty mid-edit, so they schedule nothing.
    /// </summary>
    private void OnPageInputChanged()
    {
        _pageDebounceTimer?.Dispose();
        if (State.PageInput < 1) return;

        _pageDebounceTimer = new Timer(async _ =>
        {
            await InvokeAsync(State.JumpToPageAsync);
        }, null, TimeSpan.FromMilliseconds(600), Timeout.InfiniteTimeSpan);
    }

    private async Task OnPageKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _pageDebounceTimer?.Dispose();
            await State.JumpToPageAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += HandleStateChanged;
        await State.InitializeAsync();
    }

    // Marshal state-change notifications from background threads back to the Blazor sync context
    private async void HandleStateChanged() => await InvokeAsync(StateHasChanged);

    private void ToggleLocationMenu() => State.ShowLocationMenu = !State.ShowLocationMenu;

    private async Task OnTemplateChanged() => await State.OnTemplateChangedAsync();

    private async Task OnPageSizeChanged() => await State.OnPageSizeChangedAsync();

    private void DebounceQuery()
    {
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new Timer(async _ =>
        {
            await InvokeAsync(State.RunLiveQueryAsync);
        }, null, TimeSpan.FromMilliseconds(500), Timeout.InfiniteTimeSpan);
    }

    // Typing in a keyword group or the SQL box re-queries the existing table (no re-ingest).
    private void OnCriteriaInput()
    {
        if (!State.HasSearched) return;
        DebounceQuery();
    }

    private async Task OnCriteriaKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _searchDebounceTimer?.Dispose();
            await State.RunLiveQueryAsync();
        }
    }

    private async Task OnAdvancedToggled() => await State.OnAdvancedToggledAsync();

    private async Task RunLiveQueryAsync() => await State.RunLiveQueryAsync();

    private async Task Search() => await State.SearchAsync();

    private void CancelSearch() => State.CancelSearch();

    /// <summary>
    /// The Split by choices. "File" rather than "Source file" only because the
    /// segmented control sits beside the page-size picker and the row is tight.
    /// </summary>
    private static readonly (LogSplitMode Mode, string Label)[] SplitOptions =
    {
        (LogSplitMode.None, "None"),
        (LogSplitMode.Location, "Location"),
        (LogSplitMode.File, "File"),
    };

    /// <summary>
    /// Opens the file a row came from, at that row's line.
    /// <para>
    /// Which program that is comes from openHandlers.yaml, the same config the
    /// Projects tab uses — so pointing log files at Notepad++ or Sublime instead of
    /// VS Code is a config edit, not a code change. With no handler configured this
    /// falls back to the Windows file association, which for a .txt is usually
    /// Notepad and cannot jump to a line; that is still better than nothing.
    /// </para>
    /// </summary>
    private async Task OpenRowSource(Dictionary<string, string> logLine)
    {
        var path = logLine.GetValueOrDefault(DbLogService.SourcePathColumn, "");
        if (string.IsNullOrWhiteSpace(path))
        {
            // Rows ingested before SourcePath existed, i.e. results still on screen
            // from a search that ran under the previous build.
            State.SetError("This row has no source file recorded. Run the search again.");
            return;
        }

        if (!File.Exists(path))
        {
            State.SetError($"The source file is no longer reachable: {path}");
            return;
        }

        int.TryParse(logLine.GetValueOrDefault("Sequence", ""), out var line);

        await OpenHandlers.GetConfigAsync();
        var handler = OpenHandlers.HandlerFor(path);

        var result = handler is null
            ? await SystemService.OpenLocationAsync(path)
            : await SystemService.OpenWithCustomAppAsync(path, handler, line);

        if (!result.Success) State.SetError(result.Error ?? "Could not open the source file.");
    }

    /// <summary>"Checkout — 412 files", or just the name when nothing was counted.</summary>
    private string DescribeFileOption(string file) =>
        State.LogFileCounts.TryGetValue(file, out var count)
            ? $"{file} — {count:N0} file{(count == 1 ? "" : "s")}"
            : file;

    /// <summary>
    /// One line saying what is happening and how far in. Reads as
    /// "Reading 142 of 380 files · 1.2 GB of 3.4 GB".
    /// </summary>
    private string ProgressHeadline()
    {
        if (State.Progress is not { } p) return "Preparing search…";

        if (p.Phase == LogIngestPhase.Querying) return "Querying results…";

        // Listing has no denominator — the directory size is unknown until the walk
        // ends — so it reports what it has looked at instead of a fraction.
        if (p.Phase == LogIngestPhase.Listing)
        {
            var where = string.IsNullOrEmpty(p.CurrentFile) ? "" : $" in {p.CurrentFile}";
            return p.ItemsExamined == 0
                ? $"Listing files{where}…"
                : $"Listing files{where} — {p.ItemsExamined:N0} checked, {p.FilesDone:N0} matched";
        }

        var verb = p.Phase == LogIngestPhase.Scanning ? "Scanning" : "Reading";
        if (p.FilesTotal == 0) return $"{verb}…";

        var text = $"{verb} {p.FilesDone:N0} of {p.FilesTotal:N0} files";
        if (p.BytesTotal > 0) text += $" · {FormatBytes(p.BytesDone)} of {FormatBytes(p.BytesTotal)}";
        return text;
    }

    private string ProgressEta()
    {
        if (State.Progress is not { } p) return "";
        // Listing has no total to work towards, so it gets no estimate — the other
        // phases now do, including Scanning, which measures itself in files.
        if (p.Phase is LogIngestPhase.Querying or LogIngestPhase.Listing) return "";

        // Null means the reporter does not yet have enough evidence. Saying so is
        // better than showing a number that is about to change by minutes.
        return p.Eta is not { } eta ? "estimating…" : $"~{FormatDuration(eta)} left";
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }
        return unit == 0 ? $"{bytes} B" : $"{value:0.#} {units[unit]}";
    }

    private static string FormatDuration(TimeSpan span)
    {
        if (span.TotalSeconds < 5) return "a few seconds";
        if (span.TotalMinutes < 1) return $"{(int)span.TotalSeconds}s";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m {span.Seconds}s";
        return $"{(int)span.TotalHours}h {span.Minutes}m";
    }

    private async Task NextPage() => await State.NextPageAsync();

    private async Task PrevPage() => await State.PrevPageAsync();

    private async Task SortByColumn(string column, bool append) =>
        await State.SortByColumnAsync(column, append);

    private async Task AddKeywordRow() => await State.AddKeywordRowAsync();

    private async Task RemoveKeywordRow(int index) => await State.RemoveKeywordRowAsync(index);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("logTools.watchEscape", _self, nameof(ExitFullscreen));
            }
            catch (JSException)
            {
                // Non-fatal: the toolbar button still leaves full screen.
            }
        }

        if (!State.IsLoading && !State.PlainTextView && State.FilteredLogLines.Count > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("logTools.initColumnResize", "logResultsTable");
            }
            catch
            {
                // Non-fatal: column resizing is a progressive enhancement.
            }
        }
    }

    private async Task DownloadCsv()
    {
        if (State.IsLoading || !State.HasSearched) return;

        var templateEntry = State.AvailableTemplates.FirstOrDefault(t => t.Name == State.SelectedTemplateName);
        if (templateEntry == null)
        {
            State.SetError("No template selected for CSV download.");
            return;
        }

        var wasLoading = State.IsLoading;
        State.IsLoading = true;
        StateHasChanged();

        try
        {
            var sorts = State.AdvancedRawMode ? null : (State.ActiveSorts.Count > 0 ? State.ActiveSorts : null);
            var criteria = State.BuildCriteria();
            var criteriaArg = criteria.HasContent ? criteria : null;

            // Exports the active tab, not the whole table — the CSV should hold
            // what the grid is showing.
            var filePath = await LogFileService.DownloadLogCsvAsync(
                State.CurrentTableName,
                templateEntry.Name,
                sorts,
                criteriaArg,
                null,
                State.CurrentSplitFilter);

            // Open the file location in Explorer (Blazor Hybrid/WinForms)
            if (!string.IsNullOrWhiteSpace(filePath) && File.Exists(filePath))
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"/select,\"{filePath}\"",
                    UseShellExecute = true
                };
                System.Diagnostics.Process.Start(psi);
            }
        }
        catch (Exception ex)
        {
            State.SetError($"CSV download failed: {ex.Message}");
        }
        finally
        {
            State.IsLoading = wasLoading;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        // Unsubscribe only — do NOT cancel the token so searches continue in the background
        State.OnChanged -= HandleStateChanged;
        _searchDebounceTimer?.Dispose();
        _pageDebounceTimer?.Dispose();

        // The listener is on the document and would outlive this page otherwise,
        // holding a reference to a component that is no longer rendering.
        _ = JS.InvokeVoidAsync("logTools.stopEscape");
        _self?.Dispose();
    }
}
