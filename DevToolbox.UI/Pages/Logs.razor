@page "/logs"
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using DevToolbox.UI.Services
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using System.Threading
@inject ILogFileService LogFileService
@inject IYamlStorageService YamlStorage
@inject IJSRuntime JS
@inject LogSearchStateService State
@implements IDisposable

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-4xl font-bold text-gradient">Log Viewer</h1>
    <p class="text-dark-text-muted mt-2">View and analyze application logs with powerful search and filtering capabilities.</p>
</div>

@if (!string.IsNullOrWhiteSpace(State.ErrorMessage))
{
    <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4 mb-6 flex items-start justify-between">
        <div class="flex items-start space-x-3">
            <i class="bi bi-exclamation-triangle text-red-400 text-xl"></i>
            <div>
                <div class="font-medium text-red-400">Error</div>
                <div class="text-red-300 text-sm">@State.ErrorMessage</div>
            </div>
        </div>
        <button type="button" class="btn-ghost p-2" @onclick="State.ClearError">
            <i class="bi bi-x text-red-400"></i>
        </button>
    </div>
}

<!-- Search / Filters -->
<div class="modern-card mb-6">
    <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
        <div>
            <label for="templateSelect" class="block text-sm font-medium text-dark-text mb-2">Template</label>
            <select id="templateSelect" class="input-modern w-full" @bind="State.SelectedTemplateName" @bind:after="OnTemplateChanged">
                @foreach (var template in State.AvailableTemplates)
                {
                    <option value="@template.Name">@template.Name</option>
                }
            </select>
        </div>
        <div class="md:col-span-2 relative">
            <label class="block text-sm font-medium text-dark-text mb-2">Location</label>
            <button type="button" class="input-modern w-full text-left flex items-center justify-between" @onclick="ToggleLocationMenu">
                <span class="truncate">@State.LocationSummary</span>
                <i class="bi bi-chevron-down text-dark-text-muted ml-2"></i>
            </button>
            @if (State.ShowLocationMenu)
            {
                <div class="absolute z-20 mt-1 w-full bg-dark-surface border border-dark-border rounded-lg shadow-lg max-h-64 overflow-auto">
                    <label class="flex items-center space-x-2 px-3 py-2 hover:bg-dark-surface-hover cursor-pointer border-b border-dark-border">
                        <input type="checkbox" checked="@State.AllLocationsSelected" @onchange="_ => State.ToggleAllLocations()" />
                        <span class="text-sm text-dark-text font-medium">Select all</span>
                    </label>
                    @foreach (var location in State.LogLocations)
                    {
                        <label class="flex items-center space-x-2 px-3 py-2 hover:bg-dark-surface-hover cursor-pointer">
                            <input type="checkbox" checked="@State.IsLocationSelected(location)" @onchange="_ => State.ToggleLocation(location)" />
                            <span class="text-sm text-dark-text">@location.Name</span>
                        </label>
                    }
                </div>
            }
        </div>
        <div>
            <label for="startDate" class="block text-sm font-medium text-dark-text mb-2">Start Date</label>
            <input id="startDate" type="date" class="input-modern w-full" @bind="State.StartDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="endDate" class="block text-sm font-medium text-dark-text mb-2">End Date</label>
            <input id="endDate" type="date" class="input-modern w-full" @bind="State.EndDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="logFile" class="block text-sm font-medium text-dark-text mb-2">Log File</label>
            <input id="logFile" class="input-modern w-full" list="logFiles" placeholder="Log file..." @bind="State.LogFile" />
            <datalist id="logFiles">
                @foreach (var file in State.AvailableLogFiles)
                {
                    <option value="@file"></option>
                }
            </datalist>
        </div>
    </div>
    
    <div class="flex items-end gap-4 mt-6">
        <button class="btn-primary flex items-center space-x-2" @onclick="Search" disabled="@State.IsLoading" aria-describedby="searchHelp">
            @if (State.IsLoading)
            {
                <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
            }
            else
            {
                <i class="bi bi-search"></i>
            }
            <span>Search</span>
        </button>
        <button class="btn-secondary flex items-center space-x-2" @onclick="DownloadCsv" disabled="@(State.IsLoading || State.FilteredLogLines.Count == 0)" title="Download as CSV">
            <i class="bi bi-download"></i>
            <span>CSV</span>
        </button>
    </div>
    
    @if (State.IsLoading)
    {
        <div class="flex items-center space-x-2 text-dark-text-muted mt-4">
            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-accent-blue"></div>
            <span>Loading logs...</span>
        </div>
    }

    <!-- Advanced / keyword-group search -->
    <div class="mt-6 border-t border-dark-border pt-4">
        <div class="flex items-center justify-between mb-3">
            <label class="flex items-center space-x-2 cursor-pointer">
                <input type="checkbox" @bind="State.AdvancedRawMode" @bind:after="OnAdvancedToggled" />
                <span class="text-sm font-medium text-dark-text">Advanced query mode (SQL)</span>
            </label>
            <span class="text-xs text-dark-text-muted">@(State.AdvancedRawMode ? "Full SQL against the table named logs." : "Type to filter as you go (Enter or 500ms). Rows combine with AND / OR / NOT.")</span>
        </div>

        @if (State.AdvancedRawMode)
        {
            <div>
                <label for="advExpr" class="block text-sm font-medium text-dark-text mb-2">Custom SQL query</label>
                <textarea id="advExpr" rows="3" class="input-modern w-full font-mono text-sm"
                          placeholder="SELECT LEFT(DateTime,4) AS Year, COUNT(*) AS Hits FROM logs GROUP BY Year"
                          @bind="State.AdvancedExpression" @bind:event="oninput" @bind:after="OnCriteriaInput"></textarea>
                <div class="text-xs text-dark-text-muted mt-1">Full SQL against the table <code>logs</code>. Sorting and keyword groups are ignored in this mode. Run with Search or as you type (500ms).</div>
            </div>
        }
        else
        {
            <div class="space-y-2">
                @for (int i = 0; i < State.KeywordRows.Count; i++)
                {
                    var index = i;
                    var row = State.KeywordRows[index];
                    <div class="flex items-center space-x-2">
                        @if (index == 0)
                        {
                            <span class="w-20 text-xs text-dark-text-muted text-center">where</span>
                        }
                        else
                        {
                            <select class="input-modern w-20" @bind="row.Gate" @bind:after="RunLiveQueryAsync">
                                <option value="AND">AND</option>
                                <option value="OR">OR</option>
                                <option value="NOT">NOT</option>
                            </select>
                        }
                        <input class="input-modern flex-1" placeholder="Interchangeable terms (any match), comma-separated"
                               @bind="row.Text" @bind:event="oninput" @bind:after="OnCriteriaInput" @onkeypress="OnCriteriaKeyPress" />
                        <button type="button" class="btn-ghost p-2" title="Remove group" @onclick="() => RemoveKeywordRow(index)" disabled="@(State.KeywordRows.Count == 1)">
                            <i class="bi bi-x-lg text-dark-text-muted"></i>
                        </button>
                    </div>
                }
                <button type="button" class="btn-secondary flex items-center space-x-2" @onclick="AddKeywordRow">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add Group</span>
                </button>
            </div>
        }
    </div>
</div>

@if (State.IsLoading)
{
    <div class="modern-card text-center py-16">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-accent-blue mx-auto"></div>
        <p class="mt-4 text-dark-text-muted">Loading logs, please wait...</p>
    </div>
}
else if (State.FilteredLogLines.Count == 0 && !State.HasSearched)
{
    <div class="modern-card text-center py-16">
        <i class="bi bi-search text-6xl text-dark-text-muted"></i>
        <p class="text-dark-text-muted mt-4">Enter your search criteria and click "Search" to view logs.</p>
    </div>
}
else if (State.FilteredLogLines.Count == 0)
{
    <div class="modern-card text-center py-16">
        <i class="bi bi-inbox text-6xl text-dark-text-muted"></i>
        <p class="text-dark-text-muted mt-4">No logs found matching your criteria. Try adjusting your filters or date range.</p>
    </div>
}
else
{
    <div class="modern-card">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-semibold text-dark-text flex items-center space-x-2">
                <i class="bi bi-table text-accent-blue"></i>
                <span>Log Results</span>
            </h2>
            <div class="flex items-center space-x-2">
                <label class="text-sm text-dark-text-muted">Page size:</label>
                <select class="input-modern w-auto" @bind="State.PageSize" @bind:after="OnPageSizeChanged">
                    <option value="100">100</option>
                    <option value="250">250</option>
                    <option value="500">500</option>
                    <option value="1000">1000</option>
                </select>
            </div>
        </div>
        
        <div class="border border-dark-border rounded-lg overflow-hidden">
            <div style="max-height: 600px; overflow: auto;" tabindex="0" role="region" aria-label="Log table">
                <table id="logResultsTable" class="w-full select-text" style="table-layout: fixed; min-width: 1200px;">
                    <colgroup>
                        @foreach (var col in State.TableColumns)
                        {
                            <col style="width: 160px;" />
                        }
                    </colgroup>
                    <thead class="bg-dark-surface border-b border-dark-border sticky top-0 z-10">
                        <tr>
                            @foreach (var col in State.TableColumns)
                            {
                                var sortEntry = State.ActiveSorts.FirstOrDefault(s => s.Column == col);
                                var sortIndex = State.ActiveSorts.FindIndex(s => s.Column == col);
                                <th class="relative px-4 py-3 text-left text-xs font-medium text-dark-text uppercase tracking-wider border-r border-dark-border cursor-pointer hover:bg-dark-surface-hover transition-colors"
                                    style="width: 160px;"
                                    @onclick="(e) => SortByColumn(col, e.ShiftKey)"
                                    @onkeypress="@(async (e) => { if (e.Key == "Enter" || e.Key == " ") await SortByColumn(col, false); })"
                                    tabindex="0"
                                    role="button"
                                    title="Click to sort, Shift+Click to add a secondary sort"
                                    aria-label="Sort by @col">
                                    <div class="flex items-center justify-between pr-2">
                                        <span class="truncate">@col</span>
                                        <span class="w-6 h-4 flex items-center justify-center">
                                            @if (sortEntry != null)
                                            {
                                                <i class="bi @(sortEntry.Direction == "desc" ? "bi-chevron-down" : "bi-chevron-up") text-accent-blue"></i>
                                                @if (State.ActiveSorts.Count > 1)
                                                {
                                                    <span class="text-[10px] text-accent-blue ml-0.5">@(sortIndex + 1)</span>
                                                }
                                            }
                                            else
                                            {
                                                <i class="bi bi-chevron-expand text-dark-text-muted opacity-0 hover:opacity-100"></i>
                                            }
                                        </span>
                                    </div>
                                    <span class="col-resizer" style="position:absolute; top:0; right:0; width:6px; height:100%; cursor:col-resize;"></span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody class="bg-dark-bg">
                        <Virtualize Items="@State.FilteredLogLines" ItemSize="32" OverscanCount="10">
                            <ItemContent Context="logLine">
                                <tr class="border-b border-dark-border hover:bg-dark-surface/50 transition-colors" role="row">
                                    @foreach (var col in State.TableColumns)
                                    {
                                        <td class="px-4 py-3 text-sm text-dark-text border-r border-dark-border overflow-hidden text-ellipsis whitespace-nowrap select-text"
                                            title="@logLine.GetValueOrDefault(col, "")" role="cell">
                                            @logLine.GetValueOrDefault(col, "")
                                        </td>
                                    }
                                </tr>
                            </ItemContent>
                            <Placeholder>
                                <tr class="border-b border-dark-border">
                                    @for (int i = 0; i < State.TableColumns.Count; i++)
                                    {
                                        <td class="px-4 py-3 border-r border-dark-border">
                                            <div class="animate-pulse">
                                                <div class="h-4 bg-dark-surface rounded w-3/4"></div>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            </Placeholder>
                        </Virtualize>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="flex justify-between items-center mt-6" role="navigation" aria-label="Pagination">
            <button class="btn-secondary flex items-center space-x-2" @onclick="PrevPage" disabled="@(State.IsLoading || State.CurrentPage == 0)" aria-label="Previous page">
                <i class="bi bi-chevron-left"></i>
                <span>Previous</span>
            </button>

            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-2">
                    <label for="pageInput" class="text-sm text-dark-text-muted">Page:</label>
                    <input id="pageInput"
                           type="number"
                           class="input-modern w-20 text-center"
                           min="1"
                           max="@State.TotalPages"
                           @bind="State.PageInput"
                           @bind:event="oninput"
                           @onkeypress="OnPageKeyPress" />
                    <button class="btn-secondary px-3 py-1" @onclick="JumpToPage" disabled="@State.IsLoading">Go</button>
                </div>
                <span class="text-sm text-dark-text">
                    of <span class="font-semibold text-accent-blue">@State.TotalPages</span> 
                    (<span class="font-semibold text-accent-blue">@State.TotalRecords</span> total)
                </span>
            </div>

            <button class="btn-secondary flex items-center space-x-2" @onclick="NextPage" disabled="@(State.IsLoading || !State.HasMorePages)" aria-label="Next page">
                <span>Next</span>
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
}


@code {
    private System.Threading.Timer? _searchDebounceTimer;

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += HandleStateChanged;
        await State.InitializeAsync();
    }

    // Marshal state-change notifications from background threads back to the Blazor sync context
    private async void HandleStateChanged() => await InvokeAsync(StateHasChanged);

    private void ToggleLocationMenu() => State.ShowLocationMenu = !State.ShowLocationMenu;

    private async Task OnTemplateChanged() => await State.OnTemplateChangedAsync();

    private async Task OnPageSizeChanged() => await State.OnPageSizeChangedAsync();

    private void DebounceQuery()
    {
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new Timer(async _ =>
        {
            await InvokeAsync(State.RunLiveQueryAsync);
        }, null, TimeSpan.FromMilliseconds(500), Timeout.InfiniteTimeSpan);
    }

    // Typing in a keyword group or the SQL box re-queries the existing table (no re-ingest).
    private void OnCriteriaInput()
    {
        if (!State.HasSearched) return;
        DebounceQuery();
    }

    private async Task OnCriteriaKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _searchDebounceTimer?.Dispose();
            await State.RunLiveQueryAsync();
        }
    }

    private async Task OnAdvancedToggled() => await State.OnAdvancedToggledAsync();

    private async Task RunLiveQueryAsync() => await State.RunLiveQueryAsync();

    private async Task Search() => await State.SearchAsync();

    private async Task JumpToPage() => await State.JumpToPageAsync();

    private async Task NextPage() => await State.NextPageAsync();

    private async Task PrevPage() => await State.PrevPageAsync();

    private async Task SortByColumn(string column, bool append) =>
        await State.SortByColumnAsync(column, append);

    private async Task AddKeywordRow() => await State.AddKeywordRowAsync();

    private async Task RemoveKeywordRow(int index) => await State.RemoveKeywordRowAsync(index);

    private async Task OnPageKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await JumpToPage();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!State.IsLoading && State.FilteredLogLines.Count > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("logTools.initColumnResize", "logResultsTable");
            }
            catch
            {
                // Non-fatal: column resizing is a progressive enhancement.
            }
        }
    }

    private async Task DownloadCsv()
    {
        if (State.IsLoading || !State.HasSearched) return;

        var templateEntry = State.AvailableTemplates.FirstOrDefault(t => t.Name == State.SelectedTemplateName);
        if (templateEntry == null)
        {
            State.SetError("No template selected for CSV download.");
            return;
        }

        var wasLoading = State.IsLoading;
        State.IsLoading = true;
        StateHasChanged();

        try
        {
            var sorts = State.AdvancedRawMode ? null : (State.ActiveSorts.Count > 0 ? State.ActiveSorts : null);
            var criteria = State.BuildCriteria();
            var criteriaArg = criteria.HasContent ? criteria : null;

            var filePath = await LogFileService.DownloadLogCsvAsync(
                State.CurrentTableName,
                templateEntry.Name,
                sorts,
                criteriaArg,
                null);

            // Open the file location in Explorer (Blazor Hybrid/WinForms)
            if (!string.IsNullOrWhiteSpace(filePath) && File.Exists(filePath))
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"/select,\"{filePath}\"",
                    UseShellExecute = true
                };
                System.Diagnostics.Process.Start(psi);
            }
        }
        catch (Exception ex)
        {
            State.SetError($"CSV download failed: {ex.Message}");
        }
        finally
        {
            State.IsLoading = wasLoading;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        // Unsubscribe only — do NOT cancel the token so searches continue in the background
        State.OnChanged -= HandleStateChanged;
        _searchDebounceTimer?.Dispose();
    }
}