@page "/logs"
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using Microsoft.AspNetCore.Components.Web.Virtualization
@inject ILogFileService LogFileService

<div class="container my-4">
    <h1 class="mb-3">Log Viewer</h1>
    <p class="lead mb-4">View and analyze application logs.</p>

    <!-- Search / Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <select class="form-select" @bind="selectedTemplateName">
                        @foreach (var template in availableTemplates)
                        {
                            <option value="@template.Name">@template.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="logLocationPath">
                        @foreach (var location in logLocations)
                        {
                            <option value="@location.Path">@location.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control" @bind="startDate" />
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control" @bind="endDate" />
                </div>
                <div class="col-md-2">
                    <input class="form-control" list="logFiles" placeholder="Log file..." @bind="logFile" />
                    <datalist id="logFiles">
                        @foreach (var file in availableLogFiles)
                        {
                            <option value="@file"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-primary w-100" @onclick="Search" disabled="@isLoading">Search</button>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-6">
                    <input type="text" class="form-control" @bind="tableSearch" @bind:event="oninput" placeholder="Search table..." />
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center my-5">
            <img src="images/loading.gif" alt="Loading..." />
        </div>
    }
    else if (filteredLogLines.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <p class="text-muted mb-0">No logs to display. Adjust your filters or check back later.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div style="max-height: 500px; overflow: auto;">
                    <table class="table table-striped table-hover log-table" style="min-width: 1200px;">
                        <thead class="table-dark">
                            <tr>
                                @foreach (var col in tableColumns)
                                {
                                    <th style="position: sticky; top: 0; background: #212529; z-index: 2; white-space: nowrap; border: 1px solid black; padding: 5px;">
                                        @col
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="@filteredLogLines" ItemSize="30">
                                <ItemContent Context="logLine">
                                    <tr class="table-light">
                                        @foreach (var col in tableColumns)
                                        {
                                            <td style="white-space: nowrap; border: 1px solid black; padding: 5px;">
                                                @logLine.GetValueOrDefault(col, "")
                                            </td>
                                        }
                                    </tr>
                                </ItemContent>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <button class="btn btn-secondary" @onclick="PrevPage" disabled="@(isLoading || currentPage == 0)">
                        ◀ Previous
                    </button>

                    <div class="d-flex align-items-center">
                        <input type="number"
                               class="form-control text-center fw-bold"
                               style="width: 80px;"
                               @bind="pageInput"
                               @bind:event="oninput" />
                        <button class="btn btn-secondary ms-2" @onclick="JumpToPage">Go</button>
                        <span class="ms-3 fw-bold">of @totalPages</span>
                    </div>

                    <button class="btn btn-secondary" @onclick="NextPage" disabled="@(isLoading || !hasMorePages)">
                        Next ▶
                    </button>
                </div>

            </div>
        </div>
    }
</div>


@code {
    private string logLocationPath = string.Empty;
    private List<LogLocation> logLocations = new();
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today;
    private string logFile = string.Empty;
    private string tableSearch = string.Empty;
    private List<string> availableLogFiles = new();
    private List<LogTemplateIndexEntry> availableTemplates = new();
    private string selectedTemplateName = "";
    private List<Dictionary<string, string>> originalLogLines = new();
    private List<Dictionary<string, string>> filteredLogLines = new();
    private List<string> tableColumns = new();
    private bool isLoading = false;

    // Pagination state
    private int currentPage = 0;
    private int pageSize = 500;
    private bool hasMorePages = true;

    private int pageInput { get; set; } = 1;  // what the input shows

    private int totalPages = 0;

    protected override async Task OnInitializedAsync()
    {
        logLocations = await LogFileService.GetLogLocationsAsync();
        availableTemplates = await LogFileService.GetAvailableLogFileTemplatesAsync();
        selectedTemplateName = availableTemplates.FirstOrDefault()?.Name ?? string.Empty;
        logLocationPath = logLocations?.FirstOrDefault()?.Path ?? string.Empty;
        await UpdateTableColumns();
    }

    private async Task Search()
    {
        pageInput = 1;
        currentPage = pageInput - 1;
        await LoadPage();
    }

    private async Task LoadPage()
    {
        isLoading = true;
        StateHasChanged();

        var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
        if (templateEntry == null) return;

        var totalEntries = await LogFileService.CountLogEntriesAsync(logFile, logLocationPath, startDate, endDate, templateEntry.Name, tableSearch);

        totalPages = (int)Math.Ceiling(totalEntries / (double)pageSize);

        var pageData = await LogFileService.SearchLogFilesPageAsync(
            logFile,
            logLocationPath,
            startDate,
            endDate,
            templateEntry.Name,
            tableSearch,
            currentPage,
            pageSize);

        originalLogLines = pageData;
        filteredLogLines = pageData;

        tableColumns = pageData
            .OrderByDescending(l => l.Count)
            .FirstOrDefault()?.Keys.ToList() ?? new List<string>();

        hasMorePages = pageData.Count == pageSize;
        pageInput = currentPage + 1;

        isLoading = false;
        StateHasChanged();
    }

    private async Task JumpToPage()
    {
        if (pageInput < 1) pageInput = 1;

        // convert from 1-based input to 0-based currentPage
        currentPage = pageInput - 1;
        await LoadPage();
    }

    private async Task NextPage()
    {
        if (hasMorePages)
        {
            currentPage++;
            await LoadPage();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 0)
        {
            currentPage--;
            await LoadPage();
        }
    }

    private async Task UpdateTableColumns()
    {
        var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
        if (templateEntry != null)
        {
            var template = await LogFileService.LoadTemplateAsync(templateEntry.File);
            tableColumns = template?.Columns ?? new();
        }
    }
}
