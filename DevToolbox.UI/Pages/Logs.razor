@page "/logs"
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using System.Threading
@inject ILogFileService LogFileService
@implements IDisposable

<div class="container my-4">
    <h1 class="mb-3">Log Viewer</h1>
    <p class="lead mb-4">View and analyze application logs.</p>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="ClearError" aria-label="Close"></button>
        </div>
    }

    <!-- Search / Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label for="templateSelect" class="form-label">Template</label>
                    <select id="templateSelect" class="form-select" @bind="selectedTemplateName" @bind:after="OnTemplateChanged">
                        @foreach (var template in availableTemplates)
                        {
                            <option value="@template.Name">@template.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="locationSelect" class="form-label">Location</label>
                    <select id="locationSelect" class="form-select" @bind="logLocationPath" @bind:after="OnLocationChanged">
                        @foreach (var location in logLocations)
                        {
                            <option value="@location.Path">@location.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input id="startDate" type="date" class="form-control" @bind="startDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label for="endDate" class="form-label">End Date</label>
                    <input id="endDate" type="date" class="form-control" @bind="endDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label for="logFile" class="form-label">Log File</label>
                    <input id="logFile" class="form-control" list="logFiles" placeholder="Log file..." @bind="logFile" />
                    <datalist id="logFiles">
                        @foreach (var file in availableLogFiles)
                        {
                            <option value="@file"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-1 d-flex flex-column gap-2">
                    <label class="form-label">&nbsp;</label>
                    <button class="btn btn-primary w-100" @onclick="Search" disabled="@isLoading" aria-describedby="searchHelp">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        Search
                    </button>
                    <button class="btn btn-outline-secondary w-100" @onclick="DownloadCsv" disabled="@(isLoading || filteredLogLines.Count == 0)" title="Download as CSV">
                        <i class="bi bi-download me-1" aria-hidden="true"></i>CSV
                    </button>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-6">
                    <label for="tableSearch" class="form-label">Search in results</label>
                    <input id="tableSearch" type="text" class="form-control" @bind="tableSearch" @bind:event="oninput" @onkeypress="OnSearchKeyPress" placeholder="Search table..." />
                    <div id="searchHelp" class="form-text">Press Enter or wait 500ms to search</div>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    @if (isLoading)
                    {
                        <div class="text-muted">
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            Loading logs...
                        </div>
                    }
                    else if (filteredLogLines.Count > 0)
                    {
                        <div class="text-muted">
                            Showing @filteredLogLines.Count of @totalRecords records
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading logs, please wait...</p>
        </div>
    }
    else if (filteredLogLines.Count == 0 && !hasSearched)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-search fs-1 text-muted"></i>
                <p class="text-muted mb-0 mt-3">Enter your search criteria and click "Search" to view logs.</p>
            </div>
        </div>
    }
    else if (filteredLogLines.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="text-muted mb-0 mt-3">No logs found matching your criteria. Try adjusting your filters or date range.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Log Results</h5>
                    <div class="d-flex align-items-center gap-2">
                        <small class="text-muted">Page size:</small>
                        <select class="form-select form-select-sm" style="width: auto;" @bind="pageSize" @bind:after="OnPageSizeChanged">
                            <option value="100">100</option>
                            <option value="250">250</option>
                            <option value="500">500</option>
                            <option value="1000">1000</option>
                        </select>
                    </div>
                </div>
                
                <div style="max-height: 600px; overflow: auto;" tabindex="0" role="region" aria-label="Log table">
                    <table class="table table-striped table-hover log-table" style="min-width: 1200px;">
                        <thead class="table-dark">
                            <tr>
                                @foreach (var col in tableColumns)
                                {
                                    <th style="position: sticky; top: 0; background: #212529; z-index: 2; white-space: nowrap; border: 1px solid black; padding: 8px; cursor: pointer; user-select: none;"
                                        @onclick="() => SortByColumn(col)"
                                        @onkeypress="@(async (e) => { if (e.Key == "Enter" || e.Key == " ") await SortByColumn(col); })"
                                        tabindex="0"
                                        role="button"
                                        aria-label="Sort by @col">
                                        @col
                                        <span style="display: inline-block; width: 1.2em; text-align: center;" aria-hidden="true">
                                            @if (sortColumn == col)
                                            {
                                                @(sortAscending ? "▲" : "▼")
                                            }
                                            else
                                            {
                                                <span style="visibility: hidden;">▲</span>
                                            }
                                        </span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="@filteredLogLines" ItemSize="32" OverscanCount="10">
                                <ItemContent Context="logLine">
                                    <tr class="table-light" role="row">
                                        @foreach (var col in tableColumns)
                                        {
                                            <td style="white-space: nowrap; border: 1px solid #dee2e6; padding: 8px; max-width: 300px; overflow: hidden; text-overflow: ellipsis;"
                                                title="@logLine.GetValueOrDefault(col, "")" role="cell">
                                                @logLine.GetValueOrDefault(col, "")
                                            </td>
                                        }
                                    </tr>
                                </ItemContent>
                                <Placeholder>
                                    <tr class="table-light">
                                        @for (int i = 0; i < tableColumns.Count; i++)
                                        {
                                            <td style="padding: 8px; border: 1px solid #dee2e6;">
                                                <div class="placeholder-glow">
                                                    <span class="placeholder col-8"></span>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                </Placeholder>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3" role="navigation" aria-label="Pagination">
                    <button class="btn btn-secondary" @onclick="PrevPage" disabled="@(isLoading || currentPage == 0)" aria-label="Previous page">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i> Previous
                    </button>

                    <div class="d-flex align-items-center gap-2">
                        <label for="pageInput" class="form-label mb-0">Page:</label>
                        <input id="pageInput"
                               type="number"
                               class="form-control text-center"
                               style="width: 80px;"
                               min="1"
                               max="@totalPages"
                               @bind="pageInput"
                               @bind:event="oninput"
                               @onkeypress="OnPageKeyPress" />
                        <button class="btn btn-secondary" @onclick="JumpToPage" disabled="@isLoading">Go</button>
                        <span class="fw-bold">of @totalPages (@totalRecords total)</span>
                    </div>

                    <button class="btn btn-secondary" @onclick="NextPage" disabled="@(isLoading || !hasMorePages)" aria-label="Next page">
                        Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>

            </div>
        </div>
    }
</div>


@code {
    // State management
    private string logLocationPath = string.Empty;
    private List<LogLocation> logLocations = new();
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private string logFile = string.Empty;
    private string tableSearch = string.Empty;
    private List<string> availableLogFiles = new();
    private List<LogTemplateIndexEntry> availableTemplates = new();
    private string selectedTemplateName = "";
    private List<Dictionary<string, string>> originalLogLines = new();
    private List<Dictionary<string, string>> filteredLogLines = new();
    private List<string> tableColumns = new();
    private bool isLoading = false;
    private string sortColumn = "";
    private bool sortAscending = true;
    private bool hasSearched = false;
    private string errorMessage = "";
    
    // Pagination state
    private int currentPage = 0;
    private int pageSize = 500;
    private bool hasMorePages = true;
    private int pageInput = 1;
    private int totalPages = 0;
    private int totalRecords = 0;
    
    // Debouncing
    private System.Threading.Timer? _searchDebounceTimer;
    private CancellationTokenSource? _cancellationTokenSource;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            isLoading = true;
            
            var locationsTask = LogFileService.GetLogLocationsAsync();
            var templatesTask = LogFileService.GetAvailableLogFileTemplatesAsync();
            
            await Task.WhenAll(locationsTask, templatesTask);
            
            logLocations = await locationsTask ?? new List<LogLocation>();
            availableTemplates = await templatesTask ?? new List<LogTemplateIndexEntry>();
            
            selectedTemplateName = availableTemplates.FirstOrDefault()?.Name ?? string.Empty;
            logLocationPath = logLocations.FirstOrDefault()?.Path ?? string.Empty;
            
            if (!string.IsNullOrEmpty(selectedTemplateName))
            {
                await UpdateTableColumnsAsync();
            }
        }
        catch (Exception ex)
        {
            SetError($"Failed to load initial data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnTemplateChanged()
    {
        await UpdateTableColumnsAsync();
        ResetPagination();
    }

    private async Task OnLocationChanged()
    {
        // Could load available log files for this location
        ResetPagination();
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 0;
        pageInput = 1;
        
        if (hasSearched)
        {
            await LoadPageAsync();
        }
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CancelSearch();
            await PerformTableSearch();
        }
        else
        {
            DebounceTableSearch();
        }
    }

    private async Task OnPageKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await JumpToPage();
        }
    }

    private void DebounceTableSearch()
    {
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new Timer(async _ => 
        {
            await InvokeAsync(PerformTableSearch);
        }, null, TimeSpan.FromMilliseconds(500), Timeout.InfiniteTimeSpan);
    }

    private async Task PerformTableSearch()
    {
        _searchDebounceTimer?.Dispose();
        ResetPagination();
        
        if (hasSearched)
        {
            await LoadPageAsync();
        }
    }

    private void ResetPagination()
    {
        currentPage = 0;
        pageInput = 1;
        totalPages = 0;
        totalRecords = 0;
        hasMorePages = true;
    }

    private void CancelSearch()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = new CancellationTokenSource();
    }

    private void SetError(string message)
    {
        errorMessage = message;
        StateHasChanged();
    }

    private void ClearError()
    {
        errorMessage = "";
        StateHasChanged();
    }

    private async Task Search()
    {
        ClearError();
        CancelSearch();
        
        if (string.IsNullOrWhiteSpace(selectedTemplateName))
        {
            SetError("Please select a template.");
            return;
        }
        
        if (string.IsNullOrWhiteSpace(logLocationPath))
        {
            SetError("Please select a log location.");
            return;
        }
        
        if (startDate > endDate)
        {
            SetError("Start date cannot be after end date.");
            return;
        }

        ResetPagination();
        hasSearched = true;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        if (isLoading || _cancellationTokenSource?.Token.IsCancellationRequested == true) 
            return;

        isLoading = true;
        StateHasChanged();

        try
        {
            var token = _cancellationTokenSource?.Token ?? CancellationToken.None;
            
            var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
            if (templateEntry == null)
            {
                SetError($"Template '{selectedTemplateName}' not found.");
                return;
            }

            // Load count and data in parallel
            var countTask = LogFileService.CountLogEntriesAsync(logFile, logLocationPath, startDate, endDate, templateEntry.Name, tableSearch);
            var sortColumn = new SortColumn { Column = this.sortColumn, Direction = sortAscending ? "asc" : "desc" };
            var dataTask = LogFileService.SearchLogFilesPageAsync(logFile, logLocationPath, startDate, endDate, templateEntry.Name, tableSearch, currentPage, pageSize, sortColumn);

            await Task.WhenAll(countTask, dataTask);
            
            if (token.IsCancellationRequested) return;

            totalRecords = await countTask;
            totalPages = (int)Math.Ceiling(totalRecords / (double)pageSize);
            
            var pageData = await dataTask;
            originalLogLines = pageData ?? new List<Dictionary<string, string>>();
            filteredLogLines = originalLogLines;

            // Update columns from actual data
            if (pageData?.Any() == true)
            {
                tableColumns = pageData.OrderByDescending(l => l.Count).FirstOrDefault()?.Keys.ToList() ?? new List<string>();
            }

            hasMorePages = pageData?.Count == pageSize && (currentPage + 1) < totalPages;
            pageInput = currentPage + 1;
        }
        catch (OperationCanceledException)
        {
            // Search was cancelled, ignore
            return;
        }
        catch (Exception ex)
        {
            SetError($"Search failed: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task JumpToPage()
    {
        if (pageInput < 1) pageInput = 1;
        if (pageInput > totalPages) pageInput = totalPages;

        var newPage = pageInput - 1;
        if (newPage != currentPage)
        {
            currentPage = newPage;
            await LoadPageAsync();
        }
    }

    private async Task NextPage()
    {
        if (hasMorePages && currentPage < totalPages - 1)
        {
            currentPage++;
            await LoadPageAsync();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 0)
        {
            currentPage--;
            await LoadPageAsync();
        }
    }

    private async Task SortByColumn(string column)
    {
        if (isLoading || !hasSearched) return;

        // Toggle sort direction if the same column, otherwise default to ascending
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        // Reset to first page when sorting changes
        currentPage = 0;
        pageInput = 1;
        
        await LoadPageAsync();
    }

    private async Task UpdateTableColumnsAsync()
    {
        try
        {
            var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
            if (templateEntry != null)
            {
                var template = await LogFileService.LoadTemplateAsync(templateEntry.File);
                tableColumns = template?.Columns ?? new List<string>();
            }
        }
        catch (Exception ex)
        {
            SetError($"Failed to update table columns: {ex.Message}");
        }
    }

    private async Task DownloadCsv()
    {
        if (isLoading || !hasSearched) return;

        var templateEntry = availableTemplates.FirstOrDefault(t => t.Name == selectedTemplateName);
        if (templateEntry == null)
        {
            SetError("No template selected for CSV download.");
            return;
        }

        var originalLoading = isLoading;
        isLoading = true;
        StateHasChanged();

        try
        {
            var sort = new SortColumn
            {
                Column = sortColumn,
                Direction = sortAscending ? "asc" : "desc"
            };

            var filePath = await LogFileService.DownloadLogCsvAsync(
                logFile,
                logLocationPath,
                startDate,
                endDate,
                templateEntry.Name,
                tableSearch,
                sort);

            // Open the file location in Explorer (for Blazor Hybrid/WinForms)
            if (!string.IsNullOrWhiteSpace(filePath) && File.Exists(filePath))
            {
                var psi = new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"/select,\"{filePath}\"",
                    UseShellExecute = true
                };
                System.Diagnostics.Process.Start(psi);
            }
        }
        catch (Exception ex)
        {
            SetError($"CSV download failed: {ex.Message}");
        }
        finally
        {
            isLoading = originalLoading;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _searchDebounceTimer?.Dispose();
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}