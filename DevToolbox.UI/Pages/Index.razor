@page "/"
@using DevToolbox.Services
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using DevToolbox.Services.Services
@using DevToolbox.UI.Components
@using DevToolbox.UI.Components.Dialogs
@using DevToolbox.UI.Services
@using DevToolbox.UI.Models
@using Microsoft.JSInterop
@using System.IO
@using Microsoft.Extensions.Configuration
@inject CardStateService CardStateService
@inject ViewModelFactory ViewModelFactory
@inject ModalStateService ModalStateService
@inject IYamlStorageService YamlStorage
@inject PowerShellService PowerShellService
@inject IWorkspaceService WorkspaceService
@inject IWorkspaceSourceService WorkspaceSourceService
@inject IOpenHandlerService OpenHandlers
@inject IIconService IconService
@inject ISystemService SystemService
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>DevToolbox</PageTitle>

<!-- Dashboard Header -->
<div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-4xl font-bold text-gradient">Projects</h1>
            <p class="text-dark-text-muted mt-2">Manage your development workspaces and projects</p>
        </div>
        <div class="ws-toolbar">
            <!-- Search -->
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="bi bi-search text-dark-text-muted"></i>
                </div>
                <input type="text"
                    class="search-input pl-10 w-80"
                    placeholder="Search across all workspaces..."
                    @ref="searchInput"
                    value="@searchText"
                    @oninput="HandleSearchInput" />
            </div>

            <button class="btn-secondary flex items-center gap-2" title="Rescan every workspace source"
                    @onclick="RescanSources" disabled="@isScanning">
                <i class="bi @(isScanning ? "bi-hourglass-split" : "bi-arrow-repeat")"></i>
                <span>Rescan</span>
            </button>

            <button class="btn-secondary flex items-center gap-2" title="Folders scanned for projects"
                    @onclick="ShowSourcesModal">
                <i class="bi bi-folder-symlink"></i>
                <span>Scan Folders</span>
            </button>
        </div>
    </div>

    @if (scanProblems.Any())
    {
        <div class="ws-scan-note is-error mt-3">
            @foreach (var problem in scanProblems)
            {
                <div>@problem</div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(openError))
    {
        <div class="ws-notice mt-3">
            <i class="bi bi-exclamation-triangle"></i>
            <span>@openError</span>
            <button type="button" class="btn-ghost btn-sm" title="Dismiss" @onclick="() => openError = null">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }
</div>

<!-- Workspace Groups -->
<div class="space-y-6">
    @foreach (var groupViewModel in FilteredGroupViewModels)
    {
        @* Keyed by name, not Id: group ids in workspaceGroups.yaml are not actually
           unique, and Blazor throws when two siblings share a key. *@
        <WorkspaceGroupCard
            @key="GroupKey(groupViewModel.Group)"
            GroupViewModel="groupViewModel"
            GlobalOptions="GlobalOptions"
            AvailableScripts="AvailableScripts"
            AllWorkspaces="AllWorkspaces"
            AllGroups="WorkspaceService.WorkspaceGroups"
            OnDeleteGroup="DeleteGroup"
            OnOpenWorkspaceLocation="OpenWorkspaceLocation"
            OnOpenInExplorer="OpenLocationInExplorer"
            OnOpenInTerminal="OpenLocationInTerminal"
            OnOpenWithCustomApp="OpenLocationWithCustomApp"
            OnRunScriptOnLocation="RunScriptOnLocation"
            OnAddWorkspace="SaveWorkspaces"
            OnMoveToGroup="HandleMoveToGroup"
            OnRescan="RescanSources"
            OnIconChanged="StateHasChanged" />
    }

    <!-- Add New Group Button -->
    <div class="flex justify-center mt-8">
        <button class="btn-primary flex items-center space-x-2 px-6 py-3 text-lg" @onclick="ShowAddGroupModal">
            <i class="bi bi-folder-plus"></i>
            <span>Add New Group</span>
        </button>
    </div>
</div>

<Modal @bind-IsVisible="IsAddGroupModalVisible" Title="Create New Group">
    <AddWorkspaceGroupDialog
        @ref="addGroupDialog"
        GroupName="@NewGroupName"
        GroupNameChanged="(name) => NewGroupName = name"
        ErrorMessage="@GetModalError(AddGroupModalKey)"
        ErrorMessageChanged="(msg) => ModalStateService.SetError(AddGroupModalKey, msg)"
        ExistingGroups="WorkspaceService.WorkspaceGroups"
        OnGroupCreated="HandleGroupCreated" />
</Modal>

<Modal @bind-IsVisible="IsSourcesModalVisible" Title="Scan Folders">
    <WorkspaceSourcesDialog @ref="sourcesDialog" OnSaved="HandleSourcesSaved" />
</Modal>

@code {
    private DotNetObjectReference<Index>? objRef;
    private GlobalCustomOpenOptions GlobalOptions { get; set; } = new();
    private List<ScriptInfo> AvailableScripts { get; set; } = new();
    private List<Workspace> AllWorkspaces { get; set; } = new();
    private List<WorkspaceGroupViewModel> GroupViewModels { get; set; } = new();
    private ElementReference searchInput;
    private string searchText = "";
    private string NewGroupName = string.Empty;
    private bool isScanning;
    private List<string> scanProblems = new();
    private string? openError;

    // Component references for the dialogs
    private AddWorkspaceGroupDialog? addGroupDialog;
    private WorkspaceSourcesDialog? sourcesDialog;

    // Modal management
    private string AddGroupModalKey => ModalStateService.GetModalKey("addGroup", "main");
    private string SourcesModalKey => ModalStateService.GetModalKey("workspaceSources", "main");

    private bool IsAddGroupModalVisible
    {
        get => ModalStateService.IsModalVisible(AddGroupModalKey);
        set
        {
            if (value) ModalStateService.ShowModal(AddGroupModalKey);
            else ModalStateService.HideModal(AddGroupModalKey);
        }
    }

    private bool IsSourcesModalVisible
    {
        get => ModalStateService.IsModalVisible(SourcesModalKey);
        set
        {
            if (value) ModalStateService.ShowModal(SourcesModalKey);
            else ModalStateService.HideModal(SourcesModalKey);
        }
    }

    private string? GetModalError(string modalKey) => ModalStateService.GetError(modalKey);

    /// <summary>
    /// Render key for a group card. A scanned group and a saved group could share a
    /// name, so the origin is part of the key.
    /// </summary>
    private static string GroupKey(WorkspaceGroup group) =>
        $"{(group.IsFromSource ? "src" : "saved")}:{group.Name}";

    private List<WorkspaceGroupViewModel> FilteredGroupViewModels => string.IsNullOrWhiteSpace(searchText)
        ? GroupViewModels
        : GroupViewModels
            .Select(g => new WorkspaceGroupViewModel
            {
                Group = g.Group,
                IsExpanded = !string.IsNullOrWhiteSpace(searchText) || g.IsExpanded,
                Workspaces = FilterWorkspaceViewModels(g.Workspaces)
            })
            .Where(g => g.Workspaces.Any())
            .ToList();

    private List<WorkspaceViewModel> FilterWorkspaceViewModels(List<WorkspaceViewModel> workspaces)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return workspaces;

        return workspaces
            .Where(w => w.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                     || w.Locations.Any(l => l.Path.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        LoadScripts();

        // Both of these are read synchronously later (icon rules during render, open
        // handlers on click), so they have to be in memory first.
        await IconService.GetConfigAsync();
        await OpenHandlers.GetConfigAsync();

        await LoadWorkspacesAsync();
    }

    private void LoadScripts()
    {
        AvailableScripts = PowerShellService.GetAvailableScripts().ToList();
    }

    private async Task LoadWorkspacesAsync(bool forceRescan = false)
    {
        var groups = await WorkspaceService.GetWorkspaceGroupsAsync();
        AllWorkspaces = groups.SelectMany(g => g.Workspaces).ToList();

        // Scanned groups are virtual: they sit alongside the saved ones on screen but are
        // never part of what SaveWorkspaces writes back to workspaceGroups.yaml.
        var scanned = await WorkspaceSourceService.GetGroupsAsync(forceRescan);
        CollectScanProblems();

        // Convert domain models to view models
        GroupViewModels = groups.Concat(scanned)
            .Select(g => ViewModelFactory.CreateWorkspaceGroupViewModel(g))
            .ToList();

        StateHasChanged();
    }

    private void CollectScanProblems()
    {
        scanProblems = WorkspaceSourceService.LastScan
            .Where(r => r.Error is not null || !r.PathExists)
            .Select(r => r.Error is not null
                ? $"Source '{r.SourceName}' failed: {r.Error}"
                : $"Source '{r.SourceName}': folder not found — {r.ResolvedPath}")
            .ToList();
    }

    private async Task RescanSources()
    {
        isScanning = true;
        StateHasChanged();

        try
        {
            await LoadWorkspacesAsync(forceRescan: true);
        }
        finally
        {
            isScanning = false;
            StateHasChanged();
        }
    }

    private void ShowSourcesModal()
    {
        IsSourcesModalVisible = true;
    }

    private async Task HandleSourcesSaved()
    {
        IsSourcesModalVisible = false;
        await RescanSources();
    }

    private void ShowAddGroupModal()
    {
        NewGroupName = string.Empty;
        IsAddGroupModalVisible = true;
    }

    private async Task HandleGroupCreated(WorkspaceGroup group)
    {
        WorkspaceService.WorkspaceGroups.Add(group);

        // Close modal and clear form
        IsAddGroupModalVisible = false;
        NewGroupName = string.Empty;
        addGroupDialog?.ResetForm();

        await SaveWorkspaces();
        StateHasChanged();
    }

    private async Task DeleteGroup(WorkspaceGroup group)
    {
        WorkspaceService.WorkspaceGroups.Remove(group);
        await SaveWorkspaces();
        StateHasChanged();
    }

    private async Task SaveWorkspaces()
    {
        await WorkspaceService.SaveWorkspaceGroupsAsync(WorkspaceService.WorkspaceGroups);
        await LoadWorkspacesAsync();
        StateHasChanged();
    }

    /// <summary>Surfaces a failed open instead of letting it disappear into the console.</summary>
    private void Report(OpenResult result)
    {
        openError = result.Success ? null : result.Error;
        StateHasChanged();
    }

    private async Task OpenWorkspaceLocation((Workspace workspace, WorkspaceLocation location) args)
    {
        // Most specific first: an app named by the scan source, then the by-extension
        // handler, then the Windows file association. The association is last because it
        // is the least trustworthy — it had no entry at all for .code-workspace, and for
        // .sln it routed through a launcher to an older Visual Studio that could not open
        // the file. Both failed silently.
        var openWith = WorkspaceSourceService.GetOpenOptionFor(args.location)
                       ?? OpenHandlers.HandlerFor(args.location.Path);

        Report(openWith is not null
            ? await SystemService.OpenWithCustomAppAsync(args.location.Path, openWith)
            : await WorkspaceService.OpenWorkspaceLocationAsync(args.workspace, args.location));
    }

    private async Task OpenLocationInExplorer(WorkspaceLocation location)
    {
        Report(await WorkspaceService.OpenLocationInExplorerAsync(location));
    }

    private async Task OpenLocationInTerminal(WorkspaceLocation location)
    {
        Report(await WorkspaceService.OpenLocationInTerminalAsync(location));
    }

    private async Task OpenLocationWithCustomApp((Workspace workspace, WorkspaceLocation location, CustomOpenOption option) args)
    {
        Report(await WorkspaceService.OpenLocationWithCustomAppAsync(args.workspace, args.location, args.option));
    }

    private async Task RunScriptOnLocation((ScriptInfo script, Workspace workspace, WorkspaceLocation location) args)
    {
        Report(await WorkspaceService.RunScriptOnLocationAsync(args.script, args.workspace, args.location));
    }

    private async Task HandleMoveToGroup((Workspace workspace, string groupName) args)
    {
        await WorkspaceService.SaveWorkspaceGroupsAsync(WorkspaceService.WorkspaceGroups);
        await LoadWorkspacesAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerSearchShortcut", searchInput, objRef);
        }
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        bool isSearching = !string.IsNullOrWhiteSpace(searchText);

        // Update CardStateService before computing filtered groups
        CardStateService.SetSearchExpanded(isSearching,
            GroupViewModels.Select(g => g.Group.Name).ToList());

        StateHasChanged();
    }

    [JSInvokable]
    public void HandleSearchCleared()
    {
        searchText = string.Empty;
        CardStateService.SetSearchExpanded(false, Array.Empty<string>());
        StateHasChanged();
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}
