@page "/"
@using DevToolbox.Services
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Models
@using DevToolbox.Services.Services
@using DevToolbox.UI.Components
@using DevToolbox.UI.Components.Dialogs
@using DevToolbox.UI.Services
@using DevToolbox.UI.Models
@using Microsoft.JSInterop
@using System.IO
@using Microsoft.Extensions.Configuration
@inject CardStateService CardStateService
@inject ViewModelFactory ViewModelFactory
@inject ModalStateService ModalStateService
@inject IYamlStorageService YamlStorage
@inject PowerShellService PowerShellService
@inject IWorkspaceService WorkspaceService
@inject IWorkspaceSourceService WorkspaceSourceService
@inject IDashboardLayoutService Layout
@inject IOpenHandlerService OpenHandlers
@inject IIconService IconService
@inject ISystemService SystemService
@inject IUiSettingsService UiSettings
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>DevToolbox</PageTitle>

@* One row instead of a title block plus a toolbar plus a subtitle. The subtitle said
   "manage your development workspaces", which is what the tab is; the count that replaced
   it is at least a fact about this screen. *@
<div class="ws-page-head">
    <h1 class="ws-page-title text-gradient">Projects</h1>
    <span class="ws-page-meta">
        @GroupViewModels.Count groups · @TotalWorkspaces workspaces
        @* Said out loud, because the scanned groups arrive after the saved ones and cards
           appearing a second later otherwise reads as a glitch rather than as loading. *@
        @if (isScanning)
        {
            <span class="ws-scanning"><i class="bi bi-arrow-repeat"></i> scanning folders…</span>
        }
    </span>

    <div class="ws-toolbar">
        <div class="ws-search">
            <i class="bi bi-search"></i>
            <input type="text"
                class="ws-input"
                placeholder="Search or abbreviate — Ctrl+F"
                @ref="searchInput"
                value="@searchText"
                @oninput="HandleSearchInput" />
            @if (!string.IsNullOrEmpty(searchText))
            {
                <button type="button" class="ws-search-clear" title="Clear search" @onclick="ClearSearch">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>

        @* Absent, not disabled, when nothing is hidden — unlike Collapse All beside it. A disabled
           "0 hidden" is a permanent reminder of a feature you are not using, and there is nothing
           this button could do in that state anyway. *@
        @if (HiddenCount > 0)
        {
            <button class="ws-tool @(showHidden ? "is-on" : "")"
                    title="@(showHidden ? "Hide them again" : $"Show the {HiddenCount} hidden group{(HiddenCount == 1 ? "" : "s")}")"
                    @onclick="ToggleShowHidden">
                <i class="bi @(showHidden ? "bi-eye" : "bi-eye-slash")"></i>
                <span>@HiddenCount hidden</span>
            </button>
        }

        @* Disabled rather than absent when there is nothing to collapse: a button that comes
           and goes moves the three next to it, and this one sits where the pointer already is. *@
        <button class="ws-tool" title="Collapse every group and card"
                @onclick="CollapseAll" disabled="@(!AnythingExpanded)">
            <i class="bi bi-chevron-bar-contract"></i>
            <span>Collapse All</span>
        </button>

        <button class="ws-tool" title="Rescan every workspace source"
                @onclick="RescanSources" disabled="@isScanning">
            <i class="bi @(isScanning ? "bi-hourglass-split" : "bi-arrow-repeat")"></i>
            <span>Rescan</span>
        </button>

        <button class="ws-tool" title="Smart folders — the folders scanned for projects" @onclick="ShowSourcesModal">
            <i class="bi bi-folder-symlink"></i>
            <span>Smart Folders</span>
        </button>

        @* Was a full-width call to action at the bottom of the page, below every card. It is
           pressed once a month and cost a screenful of scrolling to reach. *@
        <button class="ws-tool is-primary" title="Create a new group" @onclick="ShowAddGroupModal">
            <i class="bi bi-folder-plus"></i>
            <span>New Group</span>
        </button>
    </div>
</div>

@if (scanProblems.Any())
{
    <div class="ws-scan-note is-error">
        @foreach (var problem in scanProblems)
        {
            <div>@problem</div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(openError))
{
    @* mb-3, not a margin on .ws-notice: that class is shared with the Host Changer and Log
       Viewer dialogs, which space it themselves. *@
    <div class="ws-notice mb-3">
        <i class="bi bi-exclamation-triangle"></i>
        <span>@openError</span>
        <button type="button" class="btn-ghost btn-sm" title="Dismiss" @onclick="() => openError = null">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
}

<!-- Workspace Groups -->
<div class="ws-groups">
    @foreach (var groupViewModel in FilteredGroupViewModels)
    {
        @* Keyed by name, not Id: group ids in workspaceGroups.yaml are not actually
           unique, and Blazor throws when two siblings share a key. *@
        <WorkspaceGroupCard
            @key="GroupKey(groupViewModel.Group)"
            GroupViewModel="groupViewModel"
            GlobalOptions="GlobalOptions"
            AvailableScripts="AvailableScripts"
            AllWorkspaces="AllWorkspaces"
            AllGroups="WorkspaceService.WorkspaceGroups"
            QuickOpenCount="quickOpenCount"
            IsHidden="@Layout.IsHidden(groupViewModel.Group.Name)"
            HiddenCardCount="@HiddenCardsIn(groupViewModel.Group)"
            IsDragging="@(dragGroup == groupViewModel.Group.Name)"
            IsDropTarget="@(dragGroup is not null && dragOverGroup == groupViewModel.Group.Name && dragGroup != groupViewModel.Group.Name)"
            OnDeleteGroup="DeleteGroup"
            OnOpenWorkspaceLocation="OpenWorkspaceLocation"
            OnOpenInExplorer="OpenLocationInExplorer"
            OnOpenInTerminal="OpenLocationInTerminal"
            OnOpenInVsCode="OpenLocationInVsCode"
            OnOpenWithCustomApp="OpenLocationWithCustomApp"
            OnRunScriptOnLocation="RunScriptOnLocation"
            OnAddWorkspace="SaveWorkspaces"
            OnMoveToGroup="HandleMoveToGroup"
            OnRescan="RescanSources"
            OnEditSource="ShowSourcesModalFor"
            OnCustomized="HandleCustomized"
            OnArrangeCards="ShowArrangeModalFor"
            OnRenameSourceGroup="HandleRenameSourceGroup"
            OnIconChanged="StateHasChanged"
            OnToggleHidden="HandleToggleHidden"
            OnTogglePin="HandleTogglePin"
            OnAliasesChanged="HandleAliasesChanged"
            OnDragStarted="HandleGroupDragStart"
            OnDragEntered="HandleGroupDragOver"
            OnDropped="HandleGroupDrop"
            OnDragEnded="HandleGroupDragEnd" />
    }

    @* The one position a drag could not reach. Dropping on a card means "take this card's place",
       which is the right rule everywhere except the end of the list: the last card's place is
       second-to-last once you are standing in it. MoveGroupAsync has always appended when it does
       not recognise the target — there was simply nothing below the last card to drop on.

       Only while a group is in flight, so it costs no space the rest of the time. *@
    @if (dragGroup is not null)
    {
        <div class="ws-drop-end @(dragOverGroup == string.Empty ? "is-over" : "")"
             @ondragover:preventDefault="true"
             @ondragenter:preventDefault="true"
             @ondragover="() => HandleGroupDragOver(string.Empty)"
             @ondrop:preventDefault="true"
             @ondrop="() => HandleGroupDrop(string.Empty)">
            <i class="bi bi-box-arrow-in-down"></i>
            <span>Drop here to make <strong>@dragGroup</strong> last</span>
        </div>
    }

    @if (!FilteredGroupViewModels.Any())
    {
        <div class="ws-empty">
            @if (isScanning)
            {
                @* "No groups yet" is what this said for the whole of a 4.5-second scan on a
                   machine with eight sources — an empty dashboard, telling you to go and make
                   one, while the groups were on their way. *@
                <span><i class="bi bi-arrow-repeat ws-spin"></i> Scanning folders for projects…</span>
            }
            else if (HiddenCount > 0 && !showHidden && GroupViewModels.Count == 0)
            {
                @* Every group hidden. "No groups yet" would be a straight lie, and the way back
                   is the button that is already in the toolbar. *@
                <span>
                    Everything is hidden. <strong>@HiddenCount hidden</strong> in the toolbar brings
                    them back.
                </span>
            }
            else if (string.IsNullOrWhiteSpace(searchText))
            {
                <span>No groups yet. <strong>New Group</strong> adds one by hand, <strong>Smart Folders</strong> finds them on disk.</span>
            }
            else
            {
                <span>Nothing matches “@searchText”.</span>
            }
        </div>
    }
</div>

<Modal @bind-IsVisible="IsAddGroupModalVisible" Title="Create New Group">
    <AddWorkspaceGroupDialog
        @ref="addGroupDialog"
        GroupName="@NewGroupName"
        GroupNameChanged="(name) => NewGroupName = name"
        ErrorMessage="@GetModalError(AddGroupModalKey)"
        ErrorMessageChanged="(msg) => ModalStateService.SetError(AddGroupModalKey, msg)"
        ExistingGroups="WorkspaceService.WorkspaceGroups"
        OnGroupCreated="HandleGroupCreated" />
</Modal>

@* is-xwide, not is-wide: three columns and a scrolling match list want the room, and the panel
   is bounded by the viewport regardless.

   is-tall as well, which takes the full window height and hands each of the three columns its own
   scroll. Without it the panel is as tall as its content, so the matches list — the one thing here
   with an unbounded number of rows — was a 18rem box with the rest of the dialog's height empty
   underneath it. *@
<Modal @bind-IsVisible="IsSourcesModalVisible" Title="Smart Folders" SizeClass="is-xwide is-tall">
    <WorkspaceSourcesDialog @ref="sourcesDialog" InitialSourceName="@sourcesModalFocus" OnSaved="HandleSourcesSaved" />
</Modal>

@* One group, the whole window. It is a list of up to sixty rows that has to be dragged around, so
   the room is the feature — and being about one named group is what the toolbar toggle it replaced
   could never be. *@
<Modal @bind-IsVisible="IsArrangeModalVisible" Title="@ArrangeModalTitle" SizeClass="is-full is-tall">
    <ArrangeCardsDialog
        GroupName="@(arrangeGroupName ?? string.Empty)"
        Group="ArrangeGroup"
        OnChanged="HandleCustomized"
        OnFinished="CloseArrangeModal" /></Modal>

@code {
    private DotNetObjectReference<Index>? objRef;
    private GlobalCustomOpenOptions GlobalOptions { get; set; } = new();
    private List<ScriptInfo> AvailableScripts { get; set; } = new();
    private List<Workspace> AllWorkspaces { get; set; } = new();
    private List<WorkspaceGroupViewModel> GroupViewModels { get; set; } = new();

    // The two halves, held separately so either can be refreshed without the other. Saved groups
    // come from a file and change when the user edits one; scanned groups come from disk and
    // change only on a rescan — and a rescan is slow enough that it must not be on the path of
    // anything else.
    private List<WorkspaceGroup> savedGroups = new();
    private List<WorkspaceGroup> scannedGroups = new();

    /// <summary>Set in <see cref="Dispose"/>, so a scan landing afterwards does not touch the renderer.</summary>
    private bool disposed;

    /// <summary>Source the Smart Folders dialog should open on. Null opens on the first one.</summary>
    private string? sourcesModalFocus;
    private ElementReference searchInput;
    private string searchText = "";
    private string NewGroupName = string.Empty;
    private bool isScanning;
    private List<string> scanProblems = new();
    private string? openError;

    /// <summary>How many one-click Open buttons a collapsed card gets. From ui_settings.yaml.</summary>
    private int quickOpenCount = 3;

    /// <summary>
    /// Whether hidden groups are being shown. A view state, not a setting: it is how you get at a
    /// hidden group to unhide it, and it resets when the tab is reopened.
    /// </summary>
    private bool showHidden;

    /// <summary>Group the arrange dialog is open on, or null. One group at a time, by name.</summary>
    private string? arrangeGroupName;

    // Drag state for reordering groups. Held here rather than in the cards because a drag is a
    // relationship between two of them and neither one can see the other.
    private string? dragGroup;
    private string? dragOverGroup;

    // Component references for the dialogs
    private AddWorkspaceGroupDialog? addGroupDialog;
    private WorkspaceSourcesDialog? sourcesDialog;

    // Modal management
    private string AddGroupModalKey => ModalStateService.GetModalKey("addGroup", "main");
    private string SourcesModalKey => ModalStateService.GetModalKey("workspaceSources", "main");

    private bool IsAddGroupModalVisible
    {
        get => ModalStateService.IsModalVisible(AddGroupModalKey);
        set
        {
            if (value) ModalStateService.ShowModal(AddGroupModalKey);
            else ModalStateService.HideModal(AddGroupModalKey);
        }
    }

    private bool IsSourcesModalVisible
    {
        get => ModalStateService.IsModalVisible(SourcesModalKey);
        set
        {
            if (value) ModalStateService.ShowModal(SourcesModalKey);
            else ModalStateService.HideModal(SourcesModalKey);
        }
    }

    private string? GetModalError(string modalKey) => ModalStateService.GetError(modalKey);

    private int TotalWorkspaces => GroupViewModels.Sum(g => g.Workspaces.Count);

    /// <summary>
    /// Whether anything at all is open, read from <see cref="CardStateService"/> rather than off
    /// the view models: the view models are refreshed by each card during its own render, so
    /// reading them here would describe the previous frame.
    /// </summary>
    private bool AnythingExpanded => GroupViewModels.Any(g =>
        CardStateService.IsExpanded("group", g.Group.Name)
        || g.Workspaces.Any(w => CardStateService.IsExpanded("workspace", w.StateKey)));

    /// <summary>
    /// Render key for a group card. A scanned group and a saved group could share a
    /// name, so the origin is part of the key.
    /// </summary>
    private static string GroupKey(WorkspaceGroup group) =>
        $"{(group.IsFromSource ? "src" : "saved")}:{group.Name}";

    private List<WorkspaceGroupViewModel> FilteredGroupViewModels
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
            {
                return GroupViewModels;
            }

            return GroupViewModels
                .Select(g => new WorkspaceGroupViewModel
                {
                    Group = g.Group,
                    IsExpanded = true,

                    // A group whose own name (or alias) matches keeps all of its cards: typing
                    // the group's shorthand is a request for the group, not for whichever cards
                    // inside it happen to be spelled like it.
                    Workspaces = GroupMatches(g) ? g.Workspaces : FilterWorkspaceViewModels(g.Workspaces)
                })
                .Where(g => g.Workspaces.Any())
                .ToList();
        }
    }

    private bool GroupMatches(WorkspaceGroupViewModel group) =>
        WorkspaceSearch.MatchesName(searchText, group.Name, Layout.AliasesFor(AliasScope.Group, group.Name));

    private List<WorkspaceViewModel> FilterWorkspaceViewModels(List<WorkspaceViewModel> workspaces)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return workspaces;
        }

        return workspaces
            .Where(w => WorkspaceSearch.MatchesName(searchText, w.Name, Layout.AliasesFor(AliasScope.Workspace, w.Name))
                     || w.Locations.Any(l => WorkspaceSearch.MatchesPath(searchText, l.Path)))
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        // Collapse All has to know whether anything is open, and what opens a card is a click
        // handled inside the card — which re-renders the card and nothing above it. Without
        // this the button stays greyed out after the first group is expanded.
        CardStateService.OnStateChanged += OnCardStateChanged;

        LoadScripts();

        // All three of these are read synchronously later — icon rules and aliases during
        // render, open handlers on click — so they have to be in memory first.
        await IconService.GetConfigAsync();
        await OpenHandlers.GetConfigAsync();
        await Layout.GetAsync();

        quickOpenCount = (await UiSettings.GetAsync()).QuickOpenButtonCount;

        // The saved groups are one 189 KB YAML file — 64ms — so they are awaited and painted.
        // The scan is not: it is one directory stat per folder under every source, which over
        // eight working copies measured 4.5 seconds on this machine. Awaiting it here left the
        // tab showing its "No groups yet" empty state for the whole of that, which reads as an
        // empty dashboard rather than a loading one.
        await LoadSavedGroupsAsync();
        StartScan();
    }

    private void LoadScripts()
    {
        AvailableScripts = PowerShellService.GetAvailableScripts().ToList();
    }

    /// <summary>
    /// The hand-managed half, from workspaceGroups.yaml. Fast, and the half that has to be on
    /// screen before anything else happens.
    /// </summary>
    private async Task LoadSavedGroupsAsync()
    {
        savedGroups = await WorkspaceService.GetWorkspaceGroupsAsync();
        AllWorkspaces = savedGroups.SelectMany(g => g.Workspaces).ToList();
        RebuildViewModels();
        StateHasChanged();
    }

    /// <summary>
    /// Folds the two halves into the view models the cards render.
    /// <para>
    /// Both go through the same ordering and the same pin lookup, which is the point of keying
    /// dashboardLayout.yaml on names: a scanned group can be dragged above a saved one, and a
    /// scanned card can be pinned, without either being persisted as a workspace. Called again
    /// when the scan lands, so a group that was dragged or a card that was pinned while the scan
    /// was still running keeps its place.
    /// </para>
    /// </summary>
    private void RebuildViewModels()
    {
        // Hidden groups are dropped here rather than in FilteredGroupViewModels, so everything
        // downstream — the group count in the header, Collapse All, the search — is about what is
        // on screen. A hidden group turning up in a search result would be the one place the
        // dashboard disagreed with itself about whether it exists.
        GroupViewModels = Layout.OrderGroups(savedGroups.Concat(scannedGroups))
            .Where(g => showHidden || !Layout.IsHidden(g.Name))

            // The hand edits go on here, between the scan and the view models: renames, merges,
            // relabelled locations, hidden cards. Only for scanned groups — a hand-made group's
            // cards are editable for real, and Customize returns copies, which would send those
            // edits to an object nothing saves.
            .Select(g => g.IsFromSource ? Layout.Customize(g) : g)
            .Select(g => ViewModelFactory.CreateWorkspaceGroupViewModel(g, Layout.OrderWorkspaces(g.Name, g.Workspaces)))
            .ToList();
    }

    // ---- card customization ----------------------------------------------------------------

    /// <summary>
    /// How many of a group's cards are hidden. Counted off the group handed in — which for a
    /// scanned group is the pristine scan, before <see cref="IDashboardLayoutService.Customize"/>
    /// has dropped anything. Counting the customized list could only ever say zero.
    /// </summary>
    private int HiddenCardsIn(WorkspaceGroup group)
    {
        if (!group.IsFromSource || !Layout.HasCardOverrides(group.Name))
        {
            return 0;
        }

        var scanned = scannedGroups.FirstOrDefault(g => g.Name.Equals(group.Name, StringComparison.OrdinalIgnoreCase));
        return scanned?.Workspaces.Count(w => Layout.IsCardHidden(group.Name, w.Name)) ?? 0;
    }

    /// <summary>
    /// A card override or a sort changed. Reapplied from memory — no rescan, because nothing on
    /// disk moved.
    /// </summary>
    private void HandleCustomized()
    {
        RebuildViewModels();
        StateHasChanged();
    }

    // ---- the arrange dialog ------------------------------------------------------------------

    private bool IsArrangeModalVisible
    {
        get => arrangeGroupName is not null;
        set
        {
            // The Modal's own close (backdrop, ✕) comes through the setter, so it has to clear the
            // group as well or the dialog could never be reopened.
            if (!value) arrangeGroupName = null;
        }
    }

    private string ArrangeModalTitle => $"Arrange {arrangeGroupName}";

    /// <summary>
    /// The group the dialog works on: the scan with the hand edits applied but the hidden cards
    /// <em>kept</em>. This is the only place they are reachable, and a hidden card you cannot get
    /// back is a deleted one.
    /// </summary>
    private WorkspaceGroup? ArrangeGroup
    {
        get
        {
            if (arrangeGroupName is null)
            {
                return null;
            }

            var scanned = scannedGroups.FirstOrDefault(
                g => g.Name.Equals(arrangeGroupName, StringComparison.OrdinalIgnoreCase));

            if (scanned is not null)
            {
                return Layout.Customize(scanned, includeHidden: true);
            }

            // A hand-made group. Nothing to customize, but the order still applies.
            return savedGroups.FirstOrDefault(
                g => g.Name.Equals(arrangeGroupName, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void ShowArrangeModalFor(string groupName)
    {
        arrangeGroupName = groupName;
        StateHasChanged();
    }

    private void CloseArrangeModal()
    {
        arrangeGroupName = null;

        // The dialog saved as it went, so this is only about what is behind it.
        RebuildViewModels();
        StateHasChanged();
    }

    /// <summary>
    /// Renames a scanned group by editing the rules that produce it. A scanned group's name is the
    /// <c>group:</c> field of every smart folder pointed at it, so this is a real rename rather
    /// than a display override — nothing downstream has to translate between two names.
    /// </summary>
    private async Task HandleRenameSourceGroup((string oldName, string newName) args)
    {
        var config = await WorkspaceSourceService.GetConfigAsync();

        var feeding = config.Sources
            .Where(s => s.GroupName.Equals(args.oldName, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (feeding.Count == 0)
        {
            openError = $"Nothing to rename: no smart folder targets '{args.oldName}' any more.";
            StateHasChanged();
            return;
        }

        foreach (var source in feeding)
        {
            // Set explicitly even where the group was only implied by the rule's name, or the
            // rename would last until the next time anyone looked at that rule.
            source.Group = args.newName;
        }

        // Before the rescan: the arrangement is keyed by group name, and the rescan is what
        // produces the group under its new name.
        await Layout.RenameGroupAsync(args.oldName, args.newName);
        await IconService.RenameOverrideAsync(IconScope.Group, args.oldName, args.newName);

        await WorkspaceSourceService.SaveConfigAsync(config);
        RescanSources();
    }

    // ---- hiding ----------------------------------------------------------------------------

    /// <summary>
    /// How many groups are hidden — of the ones that exist. The stored list can name a group that
    /// has since been deleted or renamed, and a toolbar saying "3 hidden" with two to show is a
    /// count of stale config rather than of anything the user can act on.
    /// </summary>
    private int HiddenCount => savedGroups.Concat(scannedGroups)
        .Select(g => g.Name)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count(Layout.IsHidden);

    private void ToggleShowHidden()
    {
        showHidden = !showHidden;
        RebuildViewModels();
        StateHasChanged();
    }

    private async Task HandleToggleHidden(string groupName)
    {
        var nowHidden = await Layout.ToggleHiddenAsync(groupName);

        // Unhiding while the reveal is on leaves the card where it is, now undimmed. Hiding the
        // last hidden group turns the reveal off with it, or the toolbar button would vanish —
        // it only renders when something is hidden — and leave the mode stuck on.
        if (!nowHidden && HiddenCount == 0)
        {
            showHidden = false;
        }

        RebuildViewModels();
        StateHasChanged();
    }

    /// <summary>
    /// Starts a scan without waiting for it. Deliberately not awaited by the caller — the point
    /// is that the rest of the tab is usable while it runs — so the task is given somewhere to
    /// put an exception rather than becoming an unobserved one.
    /// </summary>
    private void StartScan(bool forceRescan = false)
    {
        isScanning = true;
        _ = ScanAsync(forceRescan);
    }

    private async Task ScanAsync(bool forceRescan)
    {
        try
        {
            // WorkspaceSourceService runs the scan itself on a thread pool thread, and serialises
            // concurrent callers on its own gate — so a Rescan pressed while this one is still
            // going queues rather than racing it.
            scannedGroups = await WorkspaceSourceService.GetGroupsAsync(forceRescan);
            CollectScanProblems();
        }
        catch (Exception ex)
        {
            // A scan that throws must not take the saved groups off the screen with it.
            scanProblems = new List<string> { $"Scan failed: {ex.Message}" };
        }
        finally
        {
            isScanning = false;

            // Disposed means the user navigated away mid-scan; touching the renderer then throws.
            if (!disposed)
            {
                RebuildViewModels();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CollectScanProblems()
    {
        scanProblems = WorkspaceSourceService.LastScan
            .Where(r => r.Error is not null || !r.PathExists)
            .Select(r => r.Error is not null
                ? $"Source '{r.SourceName}' failed: {r.Error}"
                : $"Source '{r.SourceName}': folder not found — {r.ResolvedPath}")
            .ToList();
    }

    /// <summary>
    /// Rescans in the background, the way the first load does. Not awaited: the cards already on
    /// screen stay usable while it runs, and the button shows its hourglass until it lands.
    /// </summary>
    private void RescanSources()
    {
        StartScan(forceRescan: true);
        StateHasChanged();
    }

    private void ShowSourcesModal()
    {
        sourcesModalFocus = null;
        IsSourcesModalVisible = true;
    }

    /// <summary>
    /// Smart Folders, opened on one source — from a scanned group's context menu, so the row you
    /// were looking at is the row you land on.
    /// </summary>
    private void ShowSourcesModalFor(string? sourceName)
    {
        sourcesModalFocus = sourceName;
        IsSourcesModalVisible = true;
    }

    private void HandleSourcesSaved()
    {
        IsSourcesModalVisible = false;
        RescanSources();
    }

    private void ShowAddGroupModal()
    {
        NewGroupName = string.Empty;
        IsAddGroupModalVisible = true;
    }

    private async Task HandleGroupCreated(WorkspaceGroup group)
    {
        WorkspaceService.WorkspaceGroups.Add(group);

        // Close modal and clear form
        IsAddGroupModalVisible = false;
        NewGroupName = string.Empty;
        addGroupDialog?.ResetForm();

        await SaveWorkspaces();
        StateHasChanged();
    }

    private async Task DeleteGroup(WorkspaceGroup group)
    {
        WorkspaceService.WorkspaceGroups.Remove(group);
        await SaveWorkspaces();
        StateHasChanged();
    }

    private async Task SaveWorkspaces()
    {
        await WorkspaceService.SaveWorkspaceGroupsAsync(WorkspaceService.WorkspaceGroups);

        // Only the saved half changed. Reloading the scan as well would cost seconds for
        // something that cannot have altered what is on disk under a source.
        await LoadSavedGroupsAsync();
        StateHasChanged();
    }

    // ---- collapse all ----------------------------------------------------------------------

    /// <summary>
    /// Shuts everything: the groups and the workspace cards inside them. Both, because a group
    /// closed over a dozen open cards is a group that reopens full of them.
    /// <para>
    /// There is no matching Expand. Opening all of them meant 457 cards and 756 location rows
    /// in one frame, with a disk check on every one of those paths on the way — not something
    /// anyone wants a button for.
    /// </para>
    /// </summary>
    private void CollapseAll()
    {
        CardStateService.SetAllExpanded(
            false,
            GroupViewModels.Select(g => g.Group.Name),
            GroupViewModels.SelectMany(g => g.Workspaces).Select(w => w.StateKey));

        // The cards read their state in OnParametersSet, so this render already picks it up.
        StateHasChanged();
    }

    // ---- pinning ---------------------------------------------------------------------------

    private async Task HandleTogglePin((string groupName, string workspaceName) args)
    {
        await Layout.TogglePinAsync(args.groupName, args.workspaceName);

        // Rebuilt rather than nudged: the pinned card has to move to the front of its group,
        // and that order is decided where the view models are made. Nothing is re-read from
        // disk — a pin changes the order of what is already in memory and nothing else.
        RebuildViewModels();
        StateHasChanged();
    }

    private void HandleAliasesChanged() => StateHasChanged();

    // ---- reordering groups -----------------------------------------------------------------

    private void HandleGroupDragStart(string groupName)
    {
        dragGroup = groupName;
        dragOverGroup = null;
    }

    private void HandleGroupDragOver(string groupName)
    {
        // dragover fires continuously while the pointer is over a card; only a change is worth
        // a render.
        if (dragGroup is null || dragOverGroup == groupName)
        {
            return;
        }

        dragOverGroup = groupName;
        StateHasChanged();
    }

    private async Task HandleGroupDrop(string groupName)
    {
        var moved = dragGroup;
        dragGroup = null;
        dragOverGroup = null;

        if (moved is null || moved == groupName)
        {
            StateHasChanged();
            return;
        }

        // The order on screen is passed along so a first-ever drag writes a complete list
        // rather than a two-name one that leaves every other group floating at the end.
        await Layout.MoveGroupAsync(moved, groupName, GroupViewModels.Select(g => g.Group.Name));

        // Reordering is a re-sort of what is in memory, so no disk read either.
        RebuildViewModels();
        StateHasChanged();
    }

    private void HandleGroupDragEnd()
    {
        // Fires on a cancelled drag too — Escape, or a drop outside any card — so the
        // highlight cannot be left behind.
        if (dragGroup is null && dragOverGroup is null)
        {
            return;
        }

        dragGroup = null;
        dragOverGroup = null;
        StateHasChanged();
    }

    /// <summary>Surfaces a failed open instead of letting it disappear into the console.</summary>
    private void Report(OpenResult result)
    {
        openError = result.Success ? null : result.Error;
        StateHasChanged();
    }

    private async Task OpenWorkspaceLocation((Workspace workspace, WorkspaceLocation location) args)
    {
        // Most specific first: an app named by the scan source, then the by-extension
        // handler, then the Windows file association. The association is last because it
        // is the least trustworthy — it had no entry at all for .code-workspace, and for
        // .sln it routed through a launcher to an older Visual Studio that could not open
        // the file. Both failed silently.
        var openWith = WorkspaceSourceService.GetOpenOptionFor(args.location)
                       ?? OpenHandlers.HandlerFor(args.location.Path);

        Report(openWith is not null
            ? await SystemService.OpenWithCustomAppAsync(args.location.Path, openWith)
            : await WorkspaceService.OpenWorkspaceLocationAsync(args.workspace, args.location));
    }

    private async Task OpenLocationInExplorer(WorkspaceLocation location)
    {
        Report(await WorkspaceService.OpenLocationInExplorerAsync(location));
    }

    private async Task OpenLocationInTerminal(WorkspaceLocation location)
    {
        Report(await WorkspaceService.OpenLocationInTerminalAsync(location));
    }

    private async Task OpenLocationInVsCode(WorkspaceLocation location)
    {
        Report(await WorkspaceService.OpenLocationInVsCodeAsync(location));
    }

    private async Task OpenLocationWithCustomApp((Workspace workspace, WorkspaceLocation location, CustomOpenOption option) args)
    {
        Report(await WorkspaceService.OpenLocationWithCustomAppAsync(args.workspace, args.location, args.option));
    }

    private async Task RunScriptOnLocation((ScriptInfo script, Workspace workspace, WorkspaceLocation location) args)
    {
        Report(await WorkspaceService.RunScriptOnLocationAsync(args.script, args.workspace, args.location));
    }

    private async Task HandleMoveToGroup((Workspace workspace, string groupName) args)
    {
        await WorkspaceService.SaveWorkspaceGroupsAsync(WorkspaceService.WorkspaceGroups);
        await LoadSavedGroupsAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerSearchShortcut", searchInput, objRef);
        }
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        bool isSearching = !string.IsNullOrWhiteSpace(searchText);

        // Update CardStateService before computing filtered groups
        CardStateService.SetSearchExpanded(isSearching,
            GroupViewModels.Select(g => g.Group.Name).ToList());

        StateHasChanged();
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
        CardStateService.SetSearchExpanded(false, Array.Empty<string>());
        StateHasChanged();
    }

    [JSInvokable]
    public void HandleSearchCleared()
    {
        ClearSearch();
    }

    /// <summary>
    /// A card somewhere opened or shut. Only the toolbar depends on it — the cards themselves
    /// read their own state — so this is a re-render and nothing more.
    /// </summary>
    private void OnCardStateChanged(object? sender, CardStateChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        // Checked by ScanAsync: a scan started here can outlive the page, and the renderer of a
        // disposed component throws rather than ignoring the call.
        disposed = true;

        CardStateService.OnStateChanged -= OnCardStateChanged;
        objRef?.Dispose();
    }
}
