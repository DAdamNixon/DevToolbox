@using Microsoft.AspNetCore.Components
@using DevToolbox.UI.Services
@inherits LayoutComponentBase
@inject AppShellService Shell
@inject NavigationManager Navigation
@inject MenuStateService Menu
@inject IJSRuntime JS
@using Microsoft.JSInterop
@implements IDisposable

@* An app shell rather than a tall document: the window's height is the shell's
   height, and only the content between the bars scrolls. The nav carried
   `sticky top-0`, but a sticky element can only travel inside its own parent —
   and that header box was exactly nav-height, so there was nowhere to travel
   and it scrolled away like anything else. Owning the scroll container pins
   both bars outright. *@
<div class="app-shell bg-dark-bg">
    <!-- Navigation -->
    <header>
        <NavMenu />
    </header>

    <!-- Main Content. Full width on purpose: the cap that used to sit here
         (max-w-7xl) left dead gutters either side of the Log Viewer on a
         maximised window, which is exactly where its table needs the room. -->
    <main>
        <div class="w-full px-4 sm:px-6 lg:px-8 py-3">
            @Body
        </div>
    </main>

    <!-- Footer - Always at bottom -->
    <footer class="border-t border-dark-border">
        <StatusBar />
    </footer>
</div>

@code {
    private DotNetObjectReference<MainLayout>? _self;

    protected override void OnInitialized() => Shell.NavigationRequested += OnNavigationRequested;

    // Registered once, for the life of the window. See wwwroot/js/menu.js for why this is a document
    // listener rather than a backdrop element.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("devtoolboxMenu.watch", _self, nameof(CloseMenus));
    }

    /// <summary>Called from JavaScript when a click lands outside every menu.</summary>
    [JSInvokable]
    public void CloseMenus() => Menu.Close();

    // Raised from the tray icon, which runs on the Windows Forms thread, so it has to be marshalled
    // onto the Blazor context before touching the router.
    private void OnNavigationRequested(string route) =>
        _ = InvokeAsync(() => Navigation.NavigateTo(route));

    public void Dispose()
    {
        Shell.NavigationRequested -= OnNavigationRequested;
        _self?.Dispose();
    }
}