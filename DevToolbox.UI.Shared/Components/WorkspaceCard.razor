@using DevToolbox.UI.Components
@using DevToolbox.Services.Models
@using DevToolbox.Services.Interfaces
@using DevToolbox.Services.Services
@using DevToolbox.UI.Services
@using DevToolbox.UI.Models
@using Microsoft.JSInterop
@using System.Diagnostics
@using DevToolbox.UI.Components.Dialogs
@inject IJSRuntime JS
@inject CardStateService CardStateService
@inject MenuStateService Menu
@inject ViewModelFactory ViewModelFactory
@inject ModalStateService ModalStateService
@inject IIconService IconService
@inject IDashboardLayoutService Layout
@inject ISystemService SystemService
@implements IDisposable

@* One definition of the location menu, rendered from three places below: the ⋮ on an expanded
   location row, a right-click on that row, and a right-click on a collapsed card's quick-open chip.

   A templated delegate rather than a child component because the menu needs five of this
   component's callbacks, IsReadOnly, the script list and the open-with options — plumbing all of
   that through parameters would be more code than the menu itself, and two copies of the markup
   would be worse than either. Declared up here because Razor emits the body top to bottom, so a
   local declared below its first use does not compile. *@
@{
    RenderFragment<WorkspaceLocation> LocationMenu = location =>
    @<div class="ws-menu @(AtCursor(LocationMenuId(location)) ? "is-at-cursor" : "")"
          style="@CursorStyle(LocationMenuId(location))">
        <button class="dropdown-item" @onclick="() => OnOpenInExplorer.InvokeAsync(location)">
            <i class="bi bi-folder2-open"></i>
            <span>Open in Explorer</span>
        </button>
        <button class="dropdown-item" @onclick="() => OnOpenInTerminal.InvokeAsync(location)">
            <i class="bi bi-terminal"></i>
            <span>Open in Terminal</span>
        </button>
        @* Alongside Explorer and Terminal rather than down in "Open With": those three are the same
           question — which of my usual tools do I want this in — and the answer is VS Code often
           enough that it should not be two sections away. *@
        <button class="dropdown-item" @onclick="() => OnOpenInVsCode.InvokeAsync(location)">
            <i class="bi bi-code-slash"></i>
            <span>Open in VS Code</span>
        </button>
        <button class="dropdown-item" @onclick="() => CopyPath(location)">
            <i class="bi bi-clipboard"></i>
            <span>Copy Path</span>
        </button>

        @if (GlobalOptions.Options.Any())
        {
            <div class="ws-menu-sep"></div>
            <div class="ws-menu-heading">Open With</div>
            @foreach (var option in GlobalOptions.Options)
            {
                <button class="dropdown-item" @onclick="() => OnOpenWithCustomApp.InvokeAsync((WorkspaceViewModel.Workspace, location, option.Value))">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>@option.Key</span>
                </button>
            }
        }

        @if (AvailableScripts.Any())
        {
            <div class="ws-menu-sep"></div>
            <div class="ws-menu-heading">Run Script</div>
            @foreach (var script in AvailableScripts)
            {
                <button class="dropdown-item" @onclick="() => OnRunScriptOnLocation.InvokeAsync((script, WorkspaceViewModel.Workspace, location))">
                    <i class="bi bi-play-circle"></i>
                    <span>@script.Name</span>
                </button>
            }
        }

        @if (!IsReadOnly)
        {
            <div class="ws-menu-sep"></div>
            <button class="dropdown-item danger" @onclick="() => DeleteLocation(location)">
                <i class="bi bi-trash"></i>
                <span>Delete Location</span>
            </button>
        }
    </div>;
}

@* The whole card expands it, not just the name. The handler was on .ws-card-title, which wraps only
   the icon, the name and the count, leaving most of the card dead to the click that is the obvious
   thing to do to it. The regions that must not collapse the card stop the click themselves:
   the pin, the actions menu, the quick-open row, and the locations list. *@
@* Reordering and merging are not here. They are one group at a time, in the arrange dialog, where
   both gestures have somewhere unambiguous to land — a grip on all 591 of these at once was a mode
   with no object. *@
@* Right-click anywhere on the card opens the same menu the ⋮ does, at the cursor — collapsed or
   expanded. The ⋮ is a 20px target in the corner of a card that may be one of sixty on screen, and
   it is the only way in to renaming, hiding and the aliases.

   Deliberately not marked data-menu-anchor: that attribute means "clicking here does not dismiss a
   menu", which is the wrong thing to say about a whole card. menu.js ignores right-button
   pointerdown instead, which is the actual distinction. stopPropagation because the group card
   underneath has its own right-click handler. *@
<div class="workspace-card ws-card cursor-pointer @CardStateClass"
     @onclick="ToggleExpand"
     @oncontextmenu="OpenCardMenu"
     @oncontextmenu:preventDefault="true"
     @oncontextmenu:stopPropagation="true">
    <!-- Workspace Header -->
    <div class="ws-card-header">
        <div class="ws-card-title">
            <i class="bi @icon.Icon ws-icon" style="color: @icon.Color"></i>
            <h4 class="ws-card-name" title="@TitleTooltip">@WorkspaceViewModel.Name</h4>
            <span class="ws-group-meta">@WorkspaceViewModel.Locations.Count</span>

            @* The customization layer, said out loud. A renamed or merged card that looked exactly
               like a scanned one would be indistinguishable from a scan doing something
               inexplicable, which is the failure mode of every "it just remembers" feature. *@
            @if (Override is not null)
            {
                <span class="ws-badge is-custom" title="@OverrideTooltip">
                    <i class="bi bi-pencil-fill"></i>
                    @if (Override.Absorb.Count > 0)
                    {
                        <text>merged</text>
                    }
                    else
                    {
                        <text>edited</text>
                    }
                </span>
            }
        </div>

        <!-- Actions Menu -->
        <div class="ws-actions">
            @* Outside the menu on purpose: pinning is a one-click habit, and burying it two
               clicks deep would make the feature not worth having. *@
            <button type="button"
                class="ws-pin @(IsPinned ? "is-on" : "")"
                title="@(IsPinned ? "Unpin from the top of this group" : "Pin to the top of this group")"
                @onclick:stopPropagation="true"
                @onclick="() => OnTogglePin.InvokeAsync()">
                <i class="bi @(IsPinned ? "bi-star-fill" : "bi-star")"></i>
            </button>

            <div class="ws-menu-anchor" data-menu-anchor @onclick:stopPropagation="true">
                <button type="button"
                    class="btn-ghost ws-icon-btn"
                    title="Workspace actions"
                    @onclick="() => ToggleAnchoredMenu(WorkspaceMenuId)">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>

                @if (Menu.IsOpen(WorkspaceMenuId))
                {
                    <div class="ws-menu @(AtCursor(WorkspaceMenuId) ? "is-at-cursor" : "")"
                         style="@CursorStyle(WorkspaceMenuId)">
                        <button class="dropdown-item" @onclick="ShowIconModal">
                            <i class="bi bi-palette"></i>
                            <span>Change Icon</span>
                        </button>
                        <button class="dropdown-item" @onclick="ShowAliasModal">
                            <i class="bi bi-tags"></i>
                            <span>Search Aliases@(aliases.Count > 0 ? $" ({aliases.Count})" : "")</span>
                        </button>

                        @* A scanned card cannot be edited — it is rebuilt from disk — so these
                           write a patch that is reapplied after each rescan instead. Same three
                           verbs the hand-made cards get below, doing the same thing by a different
                           route. *@
                        @if (IsReadOnly)
                        {
                            <div class="ws-menu-sep"></div>
                            <button class="dropdown-item" @onclick="ShowOverrideModal">
                                <i class="bi bi-pencil"></i>
                                <span>Rename / Labels…</span>
                            </button>
                            @* One-way from here: a hidden card is not rendered on the dashboard, so
                               there is nothing left to click to bring it back. The group header
                               keeps a count and its Arrange dialog is where you unhide. *@
                            <button class="dropdown-item" @onclick="HideCard">
                                <i class="bi bi-eye-slash"></i>
                                <span>Hide Card</span>
                            </button>
                            @if (Override?.Absorb.Count > 0)
                            {
                                <button class="dropdown-item" @onclick="Unmerge">
                                    <i class="bi bi-arrows-expand"></i>
                                    <span>Split Cards</span>
                                </button>
                            }
                        }

                        @if (!IsReadOnly)
                        {
                            <div class="ws-menu-sep"></div>
                            <button class="dropdown-item" @onclick="ShowAddLocationModal">
                                <i class="bi bi-plus-circle"></i>
                                <span>Add Location</span>
                            </button>
                            <button class="dropdown-item" @onclick="ShowMoveToGroupModal">
                                <i class="bi bi-folder2"></i>
                                <span>Move to Group</span>
                            </button>
                            <button class="dropdown-item" @onclick="ShowRenameModal">
                                <i class="bi bi-pencil"></i>
                                <span>Rename</span>
                            </button>
                            <div class="ws-menu-sep"></div>
                            <button class="dropdown-item danger" @onclick="() => OnDeleteWorkspace.InvokeAsync()">
                                <i class="bi bi-trash"></i>
                                <span>Delete Workspace</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* Only while collapsed. Expanded, every location already has its own Open button a few
       pixels lower down, and two rows of the same buttons is worse than either.

       Left-click opens; right-click gets the same menu the expanded row's ⋮ gives, because a chip
       *is* that row in miniature and there is nowhere else on a collapsed card to put a ⋮ without
       doubling the width of every chip. *@
    @if (!WorkspaceViewModel.IsExpanded && QuickLocations.Count > 0)
    {
        <div class="ws-quick" @onclick:stopPropagation="true">
            @foreach (var location in QuickLocations)
            {
                @* data-menu-anchor keeps menu.js's document listener off it: without it the
                   pointerdown that precedes the contextmenu closes the menu the contextmenu is
                   about to open, and clicking an item would dismiss instead of running it. *@
                <div class="ws-menu-anchor ws-quick-anchor" data-menu-anchor>
                    @* stopPropagation, or the chip's menu is opened and then immediately replaced:
                       contextmenu bubbles to the card, whose own handler runs second and wins, so
                       right-clicking a chip gave you the card's menu. Positioned at the cursor like
                       the location rows, rather than anchored to a chip that may be at the left
                       edge of the card. *@
                    <button type="button" class="ws-quick-btn"
                            title="Open @location.Path — right-click for more"
                            @onclick="() => OpenLocation(location)"
                            @oncontextmenu="e => OpenLocationMenu(e, location)"
                            @oncontextmenu:preventDefault="true"
                            @oncontextmenu:stopPropagation="true">
                        <i class="bi @LocationIcon(location)" style="color: @LocationColor(location)"></i>
                        <span>@location.Name</span>
                    </button>

                    @if (Menu.IsOpen(LocationMenuId(location)))
                    {
                        @LocationMenu(location)
                    }
                </div>
            }
            @if (HiddenLocationCount > 0)
            {
                <button type="button" class="ws-quick-more" title="Show all @WorkspaceViewModel.Locations.Count locations"
                        @onclick="ToggleExpand">
                    +@HiddenLocationCount
                </button>
            }
        </div>
    }

    <!-- Workspace Locations -->
    @if (WorkspaceViewModel.IsExpanded)
    {
        <div class="ws-locations" @onclick:stopPropagation="true">
            @foreach (var location in WorkspaceViewModel.Locations)
            {
                @* And on each location row, which gets that row's own menu rather than the card's —
                   the row is the thing under the pointer, and its ⋮ is the smallest target on the
                   card. Stops propagation so it does not also open the card's menu. *@
                <div class="ws-loc @(missing.Contains(location.Path) ? "is-missing" : "")"
                     @oncontextmenu="e => OpenLocationMenu(e, location)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true">
                    <i class="bi @LocationIcon(location) ws-icon" style="color: @LocationColor(location)"></i>

                    <div class="ws-loc-body">
                        <span class="ws-loc-name">
                            @location.Name
                            @if (missing.Contains(location.Path))
                            {
                                <span title="This path no longer exists on disk"> · missing</span>
                            }
                        </span>
                        @if (!string.IsNullOrWhiteSpace(location.Description))
                        {
                            <span class="ws-loc-desc" title="@location.Description">@location.Description</span>
                        }
                        <PathLabel Path="@location.Path" />
                    </div>

                    <div class="ws-loc-actions">
                        <button class="btn-secondary btn-sm" title="Open @location.Path" @onclick="() => OpenLocation(location)">
                            <i class="bi bi-box-arrow-up-right"></i>
                        </button>

                        <!-- More Actions Dropdown for Location -->
                        <div class="ws-menu-anchor" data-menu-anchor>
                            <button type="button"
                                class="btn-ghost btn-sm"
                                title="More actions"
                                @onclick="() => ToggleAnchoredMenu(LocationMenuId(location))">
                                <i class="bi bi-three-dots"></i>
                            </button>

                            @if (Menu.IsOpen(LocationMenuId(location)))
                            {
                                @LocationMenu(location)
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<Modal @bind-IsVisible="IsAddLocationModalVisible" Title="@AddLocationModalTitle">
    <AddWorkspaceLocation @ref="locationForm"
        OnLocationSubmitted="HandleLocationAdded"
        ButtonText="Add Location" />
</Modal>

<Modal @bind-IsVisible="IsMoveToGroupModalVisible" Title="@MoveToGroupModalTitle">
    <MoveWorkspaceDialog @ref="moveWorkspaceDialog"
        Workspace="WorkspaceViewModel.Workspace"
        AvailableGroups="AvailableGroups"
        ErrorMessage="@GetModalError(MoveGroupModalKey)"
        ErrorMessageChanged="(msg) => ModalStateService.SetError(MoveGroupModalKey, msg)"
        OnMoveToGroup="HandleMoveToGroup" />
</Modal>

<Modal @bind-IsVisible="IsRenameModalVisible" Title="Rename Workspace">
    <RenameWorkspaceDialog @ref="renameWorkspaceDialog"
        @* The value being edited has to live here, not be read back off the workspace. It used to be
           bound to WorkspaceViewModel.Name with a Changed callback that did nothing, so every commit
           of the input was immediately overwritten by the unchanged parameter on the next render —
           and Rename then wrote the old name back over itself. WorkspaceGroupCard already does it
           this way for groups. *@
        WorkspaceName="@renameName"
        WorkspaceNameChanged="(name) => renameName = name"
        ErrorMessage="@GetModalError(RenameModalKey)"
        ErrorMessageChanged="(msg) => ModalStateService.SetError(RenameModalKey, msg)"
        Workspace="WorkspaceViewModel.Workspace"
        AllGroups="AllGroups"
        OnRenameCompleted="HandleRenameCompleted" />
</Modal>

<Modal @bind-IsVisible="IsOverrideModalVisible" Title="@OverrideModalTitle">
    <CardOverrideDialog
        GroupName="@GroupName"
        Card="WorkspaceViewModel.Workspace"
        SiblingNames="SiblingNames"
        OnSaved="HandleOverrideSaved" />
</Modal>

<Modal @bind-IsVisible="IsIconModalVisible" Title="@IconModalTitle">
    <IconPickerDialog @ref="iconPicker"
        Scope="IconScope.Workspace"
        Name="@WorkspaceViewModel.Name"
        Current="icon"
        OnSaved="HandleIconSaved" />
</Modal>

<Modal @bind-IsVisible="IsAliasModalVisible" Title="@AliasModalTitle">
    <AliasDialog Scope="AliasScope.Workspace"
        Name="@WorkspaceViewModel.Name"
        OnSaved="HandleAliasesSaved" />
</Modal>

@code {
    [Parameter] public WorkspaceViewModel WorkspaceViewModel { get; set; } = null!;
    [Parameter] public GlobalCustomOpenOptions GlobalOptions { get; set; } = null!;
    [Parameter] public List<ScriptInfo> AvailableScripts { get; set; } = null!;
    [Parameter] public List<WorkspaceGroup> AvailableGroups { get; set; } = null!;
    [Parameter] public List<WorkspaceGroup> AllGroups { get; set; } = null!;

    /// <summary>Set for workspaces produced by a scan: they are rebuilt from disk, so editing them here would be lost.</summary>
    [Parameter] public bool IsReadOnly { get; set; }

    /// <summary>Whether this card is pinned to the front of its group.</summary>
    [Parameter] public bool IsPinned { get; set; }

    /// <summary>
    /// The group this card is in. Needed because every card override is keyed by group plus card
    /// name — two groups can hold a <c>Products</c> and they are not the same project.
    /// </summary>
    [Parameter] public string GroupName { get; set; } = string.Empty;

    /// <summary>The other card names in this group, for the rename dialog's clash check.</summary>
    [Parameter] public IReadOnlyList<string> SiblingNames { get; set; } = Array.Empty<string>();

    /// <summary>Raised after any card override changes, so the dashboard reapplies them.</summary>
    [Parameter] public EventCallback OnCustomized { get; set; }

    /// <summary>
    /// How many locations get a one-click Open button while the card is shut. 0 turns the row off.
    /// </summary>
    [Parameter] public int QuickOpenCount { get; set; } = 3;

    [Parameter] public EventCallback OnDeleteWorkspace { get; set; }
    [Parameter] public EventCallback<(Workspace, WorkspaceLocation)> OnOpenWorkspaceLocation { get; set; }
    [Parameter] public EventCallback<WorkspaceLocation> OnOpenInExplorer { get; set; }
    [Parameter] public EventCallback<WorkspaceLocation> OnOpenInTerminal { get; set; }
    [Parameter] public EventCallback<WorkspaceLocation> OnOpenInVsCode { get; set; }
    [Parameter] public EventCallback<(Workspace, WorkspaceLocation, CustomOpenOption)> OnOpenWithCustomApp { get; set; }
    [Parameter] public EventCallback<(ScriptInfo, Workspace, WorkspaceLocation)> OnRunScriptOnLocation { get; set; }
    [Parameter] public EventCallback OnAddLocation { get; set; }
    [Parameter] public EventCallback<(Workspace, string)> OnMoveToGroup { get; set; }
    [Parameter] public EventCallback OnRename { get; set; }
    [Parameter] public EventCallback OnIconChanged { get; set; }
    [Parameter] public EventCallback OnTogglePin { get; set; }
    [Parameter] public EventCallback OnAliasesChanged { get; set; }

    // Component state
    private IconStyle icon = new();
    private IReadOnlyList<string> aliases = Array.Empty<string>();

    /// <summary>The name being typed in the rename dialog, owned here so a re-render cannot revert it.</summary>
    private string renameName = string.Empty;
    private readonly HashSet<string> missing = new(StringComparer.OrdinalIgnoreCase);
    private bool missingChecked;

    // Component references for forms
    private AddWorkspaceLocation? locationForm;
    private MoveWorkspaceDialog? moveWorkspaceDialog;
    private RenameWorkspaceDialog? renameWorkspaceDialog;
    private IconPickerDialog? iconPicker;

    // Modal keys for ModalStateService - centralized approach.
    // Keyed off StateKey (group + name) rather than the workspace id, which is not unique.
    private string AddLocationModalKey => ModalStateService.GetModalKey("addLocation", WorkspaceViewModel.StateKey);
    private string MoveGroupModalKey => ModalStateService.GetModalKey("moveGroup", WorkspaceViewModel.StateKey);
    private string RenameModalKey => ModalStateService.GetModalKey("rename", WorkspaceViewModel.StateKey);
    private string IconModalKey => ModalStateService.GetModalKey("icon", WorkspaceViewModel.StateKey);
    private string AliasModalKey => ModalStateService.GetModalKey("alias", WorkspaceViewModel.StateKey);
    private string OverrideModalKey => ModalStateService.GetModalKey("cardOverride", WorkspaceViewModel.StateKey);

    // Create a helper method to get/set modal visibility to reduce duplication
    private bool GetModalVisibility(string modalKey) => ModalStateService.IsModalVisible(modalKey);
    private void SetModalVisibility(string modalKey, bool isVisible)
    {
        if (isVisible) ModalStateService.ShowModal(modalKey);
        else ModalStateService.HideModal(modalKey);
    }

    // Properties for binding to Modal components using the helper methods
    private bool IsAddLocationModalVisible
    {
        get => GetModalVisibility(AddLocationModalKey);
        set => SetModalVisibility(AddLocationModalKey, value);
    }

    private bool IsMoveToGroupModalVisible
    {
        get => GetModalVisibility(MoveGroupModalKey);
        set => SetModalVisibility(MoveGroupModalKey, value);
    }

    private bool IsRenameModalVisible
    {
        get => GetModalVisibility(RenameModalKey);
        set => SetModalVisibility(RenameModalKey, value);
    }

    private bool IsIconModalVisible
    {
        get => GetModalVisibility(IconModalKey);
        set => SetModalVisibility(IconModalKey, value);
    }

    private bool IsAliasModalVisible
    {
        get => GetModalVisibility(AliasModalKey);
        set => SetModalVisibility(AliasModalKey, value);
    }

    private bool IsOverrideModalVisible
    {
        get => GetModalVisibility(OverrideModalKey);
        set => SetModalVisibility(OverrideModalKey, value);
    }

    private string OverrideModalTitle => $"Customize {WorkspaceViewModel.Name}";

    private string? GetModalError(string modalKey) => ModalStateService.GetError(modalKey);

    // Menu identity, not menu state: which menu is open is owned by MenuStateService, so that
    // opening one closes every other and the backdrop can close whichever it is. Keyed off StateKey
    // for the same reason the modal keys are — the workspace id is not unique.
    private string WorkspaceMenuId => $"workspace:{WorkspaceViewModel.StateKey}";
    private string LocationMenuId(WorkspaceLocation location) =>
        $"location:{WorkspaceViewModel.StateKey}:{location.Path}";

    /// <summary>
    /// The name this card's override is keyed by: what the scan called it, not what it is being
    /// shown as. Renaming a card once must not make it impossible to rename again.
    /// </summary>
    private string OverrideKey => WorkspaceViewModel.Workspace.OverrideKey;

    private CardOverride? Override => IsReadOnly ? Layout.CardOverrideFor(GroupName, OverrideKey) : null;

    private string OverrideTooltip
    {
        get
        {
            var patch = Override;
            if (patch is null)
            {
                return WorkspaceViewModel.Name;
            }

            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(patch.Name)) parts.Add($"renamed from {OverrideKey}");
            if (patch.Absorb.Count > 0) parts.Add($"merged with {string.Join(", ", patch.Absorb)}");
            if (patch.Locations.Count > 0) parts.Add($"{patch.Locations.Count} location label(s) set");
            if (patch.Hidden) parts.Add("hidden");

            return parts.Count == 0 ? WorkspaceViewModel.Name : "Edited by hand: " + string.Join("; ", parts);
        }
    }

    private string CardStateClass
    {
        get
        {
            var classes = new List<string>();

            if (WorkspaceViewModel.IsExpanded) classes.Add("is-expanded");
            if (IsPinned) classes.Add("is-pinned");

            return string.Join(' ', classes);
        }
    }

    private string AddLocationModalTitle => $"Add Location to {WorkspaceViewModel.Name}";
    private string MoveToGroupModalTitle => $"Move {WorkspaceViewModel.Name} to Group";
    private string IconModalTitle => $"Icon for {WorkspaceViewModel.Name}";
    private string AliasModalTitle => $"Search aliases for {WorkspaceViewModel.Name}";

    /// <summary>
    /// The locations that get a one-click Open button. The first few in display order, which for
    /// a scanned card is alphabetical — <c>demo</c> then <c>dev</c> — and for a hand-made one is
    /// whatever order they were added in.
    /// </summary>
    private List<WorkspaceLocation> QuickLocations
    {
        get
        {
            if (QuickOpenCount <= 0)
            {
                return new List<WorkspaceLocation>();
            }

            var all = WorkspaceViewModel.Locations;
            if (all.Count <= QuickOpenCount)
            {
                return all.ToList();
            }

            // One fewer than asked for when there are more than fit, so the +N badge has room on
            // the same line. Three chips plus a badge does not fit a 17rem card: the row either
            // wrapped, putting the badge alone on a second line and making the card taller than its
            // neighbours, or every label truncated — and a chip reading "dem…" is a quick-open
            // button you cannot identify. Two readable chips and "+2" says more than three
            // unreadable ones.
            return all.Take(Math.Max(1, QuickOpenCount - 1)).ToList();
        }
    }

    private int HiddenLocationCount => WorkspaceViewModel.Locations.Count - QuickLocations.Count;

    /// <summary>
    /// The aliases go in the tooltip. They are otherwise invisible, and an alias you have
    /// forgotten setting is an alias you cannot tell from a bug in the search box.
    /// </summary>
    private string TitleTooltip => aliases.Count > 0
        ? $"{WorkspaceViewModel.Name} — also found as: {string.Join(", ", aliases)}"
        : WorkspaceViewModel.Name;

    protected override void OnInitialized() => Menu.Changed += OnMenuChanged;

    // The click that closes this card's menu usually lands on another card, or on the backdrop, so
    // nothing local would prompt the re-render that hides it.
    private void OnMenuChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Menu.Changed -= OnMenuChanged;

    protected override void OnParametersSet()
    {
        // Ensure the view model's expanded state is updated from CardStateService
        ViewModelFactory.UpdateWorkspaceExpandedState(WorkspaceViewModel);

        icon = IconService.Resolve(IconScope.Workspace, WorkspaceViewModel.Name);
        aliases = Layout.AliasesFor(AliasScope.Workspace, WorkspaceViewModel.Name);

        // Only collapsed-to-expanded transitions need a disk check. OnParametersSet runs
        // on every parent re-render — a keystroke in the search box re-renders every card —
        // and there are hundreds of cards, so checking unconditionally would stat the
        // whole tree on each character typed.
        if (WorkspaceViewModel.IsExpanded && !missingChecked)
        {
            RefreshMissing();
        }
    }

    /// <summary>Flags locations whose path is gone, so a stale entry is obvious.</summary>
    private void RefreshMissing()
    {
        missingChecked = true;
        missing.Clear();
        foreach (var location in WorkspaceViewModel.Locations)
        {
            if (string.IsNullOrWhiteSpace(location.Path))
            {
                continue;
            }

            if (!File.Exists(location.Path) && !Directory.Exists(location.Path))
            {
                missing.Add(location.Path);
            }
        }
    }

    private string LocationIcon(WorkspaceLocation location) =>
        IconService.Resolve(IconScope.Location, location.Name, DefaultLocationStyle(location)).Icon!;

    private string LocationColor(WorkspaceLocation location) =>
        IconService.Resolve(IconScope.Location, location.Name, DefaultLocationStyle(location)).Color!;

    private static IconStyle DefaultLocationStyle(WorkspaceLocation location) => new()
    {
        Icon = location.Type == LocationType.Folder ? "bi-folder" : "bi-file-earmark-code"
    };

    // ---- menus at the cursor -----------------------------------------------------------------
    //
    // Which menu was opened by right-click, and where. Only one menu is ever open — MenuStateService
    // owns that — so one id and one point is all the state needed, and a menu opened from its own ⋮
    // simply is not the one named here and hangs off its anchor as before.

    private string? cursorMenuId;
    private double cursorX;
    private double cursorY;

    private bool AtCursor(string menuId) => cursorMenuId == menuId;

    private string? CursorStyle(string menuId) =>
        AtCursor(menuId) ? $"left:{cursorX}px;top:{cursorY}px" : null;

    /// <summary>
    /// Open rather than toggle: right-clicking a second place on a card whose menu is already up
    /// should move the menu there, not dismiss it.
    /// </summary>
    private void OpenCardMenu(MouseEventArgs e)
    {
        cursorMenuId = WorkspaceMenuId;
        cursorX = e.ClientX;
        cursorY = e.ClientY;
        Menu.Open(WorkspaceMenuId);
    }

    private void OpenLocationMenu(MouseEventArgs e, WorkspaceLocation location)
    {
        var id = LocationMenuId(location);
        cursorMenuId = id;
        cursorX = e.ClientX;
        cursorY = e.ClientY;
        Menu.Open(id);
    }

    /// <summary>Back to hanging off the anchor, whatever a previous right-click set.</summary>
    private void ToggleAnchoredMenu(string menuId)
    {
        cursorMenuId = null;
        Menu.Toggle(menuId);
    }

    private void ToggleExpand()
    {
        cursorMenuId = null;
        CardStateService.ToggleExpand("workspace", WorkspaceViewModel.StateKey);
        WorkspaceViewModel.IsExpanded = !WorkspaceViewModel.IsExpanded;
        Menu.Close();

        if (WorkspaceViewModel.IsExpanded)
        {
            // Re-check on each expand — a path may have appeared or gone since last time.
            RefreshMissing();
        }
    }

    private void ShowAddLocationModal()
    {
        IsAddLocationModalVisible = true;
        Menu.Close();
    }

    private void ShowMoveToGroupModal()
    {
        IsMoveToGroupModalVisible = true;
        Menu.Close();
    }

    private void ShowRenameModal()
    {
        renameName = WorkspaceViewModel.Name;
        IsRenameModalVisible = true;
        Menu.Close();
    }

    private void ShowIconModal()
    {
        iconPicker?.ResetForm();
        IsIconModalVisible = true;
        Menu.Close();
    }

    // ---- the card override -----------------------------------------------------------------

    private void ShowOverrideModal()
    {
        IsOverrideModalVisible = true;
        Menu.Close();
    }

    private async Task HandleOverrideSaved()
    {
        IsOverrideModalVisible = false;
        await OnCustomized.InvokeAsync();
    }

    private async Task HideCard()
    {
        Menu.Close();
        await Layout.SetCardHiddenAsync(GroupName, OverrideKey, true);
        await OnCustomized.InvokeAsync();
    }

    private async Task Unmerge()
    {
        Menu.Close();
        await Layout.UnmergeCardAsync(GroupName, OverrideKey);
        await OnCustomized.InvokeAsync();
    }

    private void ShowAliasModal()
    {
        IsAliasModalVisible = true;
        Menu.Close();
    }

    private async Task HandleIconSaved()
    {
        IsIconModalVisible = false;
        icon = IconService.Resolve(IconScope.Workspace, WorkspaceViewModel.Name);
        await OnIconChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task HandleAliasesSaved()
    {
        IsAliasModalVisible = false;
        aliases = Layout.AliasesFor(AliasScope.Workspace, WorkspaceViewModel.Name);
        await OnAliasesChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task CopyPath(WorkspaceLocation location)
    {
        Menu.Close();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", location.Path);
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Could not copy path to clipboard: {ex.Message}");
        }
    }

    private async Task HandleLocationAdded(WorkspaceLocation location)
    {
        IsAddLocationModalVisible = false;
        WorkspaceViewModel.Workspace.Locations.Add(location);
        locationForm?.ResetForm();
        RefreshMissing();
        await OnAddLocation.InvokeAsync();
        StateHasChanged();
    }

    private async Task HandleMoveToGroup((Workspace workspace, string groupName) moveInfo)
    {
        IsMoveToGroupModalVisible = false;
        moveWorkspaceDialog?.ResetForm();
        await OnMoveToGroup.InvokeAsync(moveInfo);
        StateHasChanged();
    }

    private void DeleteLocation(WorkspaceLocation location)
    {
        WorkspaceViewModel.Workspace.Locations.Remove(location);
        OnAddLocation.InvokeAsync();
        Menu.Close();
        StateHasChanged();
    }

    private async Task OpenLocation(WorkspaceLocation location)
    {
        await OnOpenWorkspaceLocation.InvokeAsync((WorkspaceViewModel.Workspace, location));
    }

    private async Task HandleRenameCompleted()
    {
        IsRenameModalVisible = false;
        renameWorkspaceDialog?.ResetForm();
        await OnRename.InvokeAsync();
        StateHasChanged();
    }
}
