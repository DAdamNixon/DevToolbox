@page "/powershell"
@namespace DevToolbox.UI.Pages
@using DevToolbox.Services.Models
@using DevToolbox.UI.Components
@using DevToolbox.UI.Components.Dialogs

@* One row, like the Projects tab: the nav bar already names this screen, and the
   subtitle here only said what the tab is. The count that replaced it is at least
   a fact about what is in front of you. *@
<div class="ws-page-head">
    <h1 class="ws-page-title text-gradient">PowerShell Scripts</h1>
    <span class="ws-page-meta">
        @availableScripts.Count @(availableScripts.Count == 1 ? "script" : "scripts")
        @if (FilteredScripts.Count() != availableScripts.Count)
        {
            <text>· @FilteredScripts.Count() matching</text>
        }
    </span>
</div>

<div class="ps-layout">
    <!-- Left Sidebar -->
    <div class="modern-card ps-pane">
        <div class="ps-pane-head">
            <div class="relative">
                <input type="text"
                    @bind-value="searchText"
                    @bind-value:event="oninput"
                    placeholder="Search scripts..."
                    class="input-modern w-full pl-10" />
                <i class="bi bi-search absolute left-3 top-1/2 transform -translate-y-1/2 text-dark-text-muted"></i>
            </div>
        </div>

        <div class="ps-script-list">
            @foreach (var script in FilteredScripts)
            {
                <button type="button" class="ps-script @(script.Name == selectedScript ? "is-active" : null)"
                        title="@script.Name"
                        @onclick="() => SelectScript(script.Name)">
                    <i class="bi bi-file-earmark-code"></i>
                    <span>@script.Name</span>
                </button>
            }
        </div>

        <button class="btn-primary w-full flex items-center justify-center space-x-2" @onclick="CreateNewScript">
            <i class="bi bi-plus-circle"></i>
            <span>New Script</span>
        </button>
    </div>

    <!-- Main Content -->
    <div class="modern-card ps-pane">
        @if (!string.IsNullOrEmpty(selectedScript))
        {
            <div class="ps-editor-head">
                <h2 class="ps-editor-title">
                    <i class="bi bi-file-earmark-code text-accent-blue"></i>
                    <span>@selectedScript</span>
                </h2>

                @* Everything that acts on the file, together: save it, check it, delete it. Save
                   and Delete sat in the bottom bar beside Run, which made the one button you press
                   most share a row with the one you press least and can least afford to hit.

                   Save is first so that appearing does not move anything: the group is aligned
                   to the right, so a button added at its start grows it leftwards. *@
                <div class="ps-editor-tools">
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <span class="ps-status @(statusIsError ? "is-error" : "")" role="status">
                            <i class="bi @(statusIsError ? "bi-exclamation-circle" : "bi-check2")" aria-hidden="true"></i>
                            @statusMessage
                        </span>
                    }

                    @* Only when there is something to save. The editor says so on the first
                       keystroke (OnEdited) rather than when it loses focus, or the button would
                       not exist until you had clicked somewhere else to go and look for it. *@
                    @if (IsDirty)
                    {
                        <button type="button" class="btn-primary btn-sm flex items-center space-x-2"
                                title="Save @(selectedScript).ps1" disabled="@Run.IsRunning" @onclick="SaveScript">
                            <i class="bi bi-save"></i>
                            <span>Save</span>
                        </button>
                    }

                    <label class="flex items-center space-x-2 cursor-pointer">
                        <input type="checkbox" id="enableValidation" @bind="enableScriptValidation" class="checkbox-modern">
                        <span class="text-xs text-dark-text-muted">Validate on save</span>
                    </label>
                    <button type="button" class="btn-secondary btn-sm flex items-center space-x-2" @onclick="ValidateCurrentScript">
                        <i class="bi bi-shield-check"></i>
                        <span>Validate</span>
                    </button>

                    @* The Smart Folders dialog's Remove: quiet, and on the far right. One
                       difference, because the two are not the same act — Remove there is undone by
                       closing the dialog, and this deletes the file now. So the first click only
                       arms it, and clicking anywhere else disarms it. *@
                    <button type="button" class="btn-ghost btn-sm @(confirmingDelete ? "ps-delete-armed" : "")"
                            title="@(confirmingDelete ? $"Click again to delete {selectedScript}.ps1 from disk" : "Delete this script")"
                            disabled="@Run.IsRunning"
                            @onclick="DeleteClicked" @onblur="DisarmDelete">
                        <i class="bi bi-trash"></i> @(confirmingDelete ? "Confirm delete" : "Delete")
                    </button>
                </div>
            </div>
            @if (showValidationResults)
            {
                <div class="mb-3 space-y-2">
                    @if (validationErrors.Any())
                    {
                        <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-3">
                            <div class="flex items-start space-x-3">
                                <i class="bi bi-exclamation-triangle text-red-400 text-lg"></i>
                                <div>
                                    <h5 class="font-medium text-red-400 mb-2">Validation Errors:</h5>
                                    <ul class="text-red-300 text-sm space-y-1 list-disc list-inside">
                                        @foreach (var error in validationErrors)
                                        {
                                            <li>@error</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                    
                    @if (validationWarnings.Any())
                    {
                        <div class="bg-yellow-500/10 border border-yellow-500/20 rounded-lg p-3">
                            <div class="flex items-start space-x-3">
                                <i class="bi bi-exclamation-triangle text-yellow-400 text-lg"></i>
                                <div>
                                    <h5 class="font-medium text-yellow-400 mb-2">Validation Warnings:</h5>
                                    <ul class="text-yellow-300 text-sm space-y-1 list-disc list-inside">
                                        @foreach (var warning in validationWarnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            <div class="ps-editor-body">
                @* Everything but the buttons scrolls together. With the error and output
                   panes showing there is more here than the card can hold, and when it all
                   shared one fixed-height column the editor and the parameter form were
                   squeezed to nothing while the textarea's own minimum height still drew —
                   underneath the error pane. The buttons stay outside so Run never scrolls
                   away. *@
                <div class="ps-editor-scroll @(Run.EditorCollapsed ? "is-editor-collapsed" : "")">
                @* The pane is a flex column and the editor flexes inside it.

                   It folds the way the Log Viewer's source card does: Run folds it to one line
                   so the console gets the column, and the lip along its bottom edge brings it
                   back. Hidden rather than removed while folded, because a textarea taken out of
                   the page takes its undo history with it. *@
                <div class="ps-editor-pane @(Run.EditorCollapsed ? "is-collapsed" : "")">
                    <label for="psScriptEditor" class="block text-sm font-medium text-dark-text mb-2">Script Editor</label>
                    @* bind:after rebuilds the parameter form from the text. The value comes back
                       on change, so this happens when the editor loses focus rather than on every
                       keystroke — a form that reshuffled itself mid-word would be unusable. *@
                    <PowerShellEditor Id="psScriptEditor" Class="ps-editor-code"
                                      @bind-Value="scriptText" @bind-Value:after="OnScriptChanged"
                                      OnEdited="OnScriptEdited"
                                      Placeholder="Enter your PowerShell script here..." />

                    @if (Run.EditorCollapsed)
                    {
                        @* Clickable for the mouse; the lip below is the control a keyboard reaches,
                           so there is one tab stop for the one action. *@
                        <div class="ps-editor-summary" @onclick="ToggleEditor">
                            <i class="bi bi-file-earmark-code" aria-hidden="true"></i>
                            <span class="ps-editor-summary-text">@EditorSummary</span>
                            @if (IsDirty)
                            {
                                <span class="ps-editor-dirty">Unsaved changes</span>
                            }
                        </div>
                    }

                    <button type="button" class="ps-editor-lip"
                            aria-expanded="@(Run.EditorCollapsed ? "false" : "true")"
                            aria-controls="psScriptEditor"
                            title="@(Run.EditorCollapsed ? "Show the script" : "Collapse the script")"
                            @onclick="ToggleEditor">
                        <i class="bi @(Run.EditorCollapsed ? "bi-chevron-down" : "bi-chevron-up")" aria-hidden="true"></i>
                        <span>@(Run.EditorCollapsed ? "Show script" : "Collapse")</span>
                    </button>
                </div>

                @* Parameters, read off the script's own param() block.

                   This was one box labelled "Path to run against", wired to -ProjectPath. It
                   worked for the four bundled scripts and for nothing else: a script wanting
                   an output file or a mode had nowhere to be given one, so running it from
                   this tab meant editing that parameter's default and saving. The form is
                   rebuilt whenever the editor's text changes, so a parameter you add turns
                   into a field without anything having to be kept in step by hand. *@
                <div class="ps-params">
                    <div class="ps-params-head">
                        <label class="text-sm font-medium text-dark-text">Parameters</label>
                        @if (parameters.Count > 0)
                        {
                            <span class="text-xs text-dark-text-muted">
                                Read from this script's <span class="font-mono">param()</span> block. Required ones are marked.
                            </span>
                        }
                    </div>

                    @if (parameters.Count == 0)
                    {
                        @* Nothing to fill in, and saying so. This used to be a "Project path" box,
                           kept for scripts that read $ProjectPath without declaring it — which put a
                           folder field on every script, including the ones that have no use for a
                           folder. A script that wants a value declares it, and gets a field for it. *@
                        <p class="ps-param-hint">
                            This script takes no parameters. Declare some in a
                            <span class="font-mono">param()</span> block and they appear here.
                        </p>
                    }
                    else
                    {
                        @foreach (var parameter in parameters)
                        {
                            var name = parameter.Name;
                            var fieldId = "param-" + name;
                            <div class="ps-param-row">
                                <label for="@fieldId" class="ps-param-label">
                                    @parameter.Label
                                    @if (parameter.IsMandatory)
                                    {
                                        <span class="ps-param-required" title="Required by the script">*</span>
                                    }
                                </label>
                                <div class="ps-param-control">
                                    @switch (parameter.Kind)
                                    {
                                        case ScriptParameterKind.Switch:
                                            <label class="ps-param-switch">
                                                <input type="checkbox" id="@fieldId"
                                                       checked="@IsChecked(name)"
                                                       @onchange="e => SetValue(name, e.Value is true ? bool.TrueString : string.Empty)" />
                                                <span class="text-sm text-dark-text-muted">
                                                    Pass <span class="font-mono">-@name</span>
                                                </span>
                                            </label>
                                            break;

                                        case ScriptParameterKind.Choice:
                                            <select id="@fieldId" class="input-modern w-full"
                                                    value="@Value(name)" @onchange="e => SetValue(name, e.Value?.ToString())">
                                                @* An optional choice needs a way back to unset, or the first
                                                   option silently becomes a value nobody picked. *@
                                                @if (!parameter.IsMandatory)
                                                {
                                                    <option value="">(not set)</option>
                                                }
                                                @foreach (var allowed in parameter.AllowedValues)
                                                {
                                                    <option value="@allowed">@allowed</option>
                                                }
                                            </select>
                                            break;

                                        case ScriptParameterKind.Number:
                                            <input type="number" id="@fieldId" class="input-modern w-full"
                                                   value="@Value(name)" @oninput="e => SetValue(name, e.Value?.ToString())" />
                                            break;

                                        case ScriptParameterKind.Folder:
                                        case ScriptParameterKind.File:
                                            <div class="ps-param-input-group">
                                                <input type="text" id="@fieldId" class="input-modern w-full"
                                                       value="@Value(name)" @oninput="e => SetValue(name, e.Value?.ToString())" />
                                                <button type="button" class="btn-secondary px-3"
                                                        title="@(parameter.Kind == ScriptParameterKind.Folder ? "Browse for a folder" : "Browse for a file")"
                                                        @onclick="() => BrowseFor(parameter)">
                                                    <i class="bi @(parameter.Kind == ScriptParameterKind.Folder ? "bi-folder2" : "bi-file-earmark")"></i>
                                                </button>
                                            </div>
                                            break;

                                        default:
                                            <input type="text" id="@fieldId" class="input-modern w-full"
                                                   value="@Value(name)" @oninput="e => SetValue(name, e.Value?.ToString())" />
                                            break;
                                    }

                                    @* Razor trims trailing whitespace out of markup, so the
                                       separator has to be a character rather than a space. *@
                                    <p class="ps-param-hint">
                                        @if (!string.IsNullOrEmpty(parameter.HelpMessage))
                                        {
                                            <span>@parameter.HelpMessage</span>
                                            <span class="ps-param-hint-sep">&middot;</span>
                                        }
                                        <span class="font-mono">@ParameterSignature(parameter)</span>
                                    </p>
                                </div>
                            </div>
                        }

                        @* Only after a Run has been asked for. Shown on sight it was an
                           error message about something you had not done yet, on every
                           script in the library — the asterisk on the field is how a
                           required value announces itself before then. *@
                        @if (showMissingRequired && MissingRequired.Count > 0)
                        {
                            <div class="ws-notice">
                                <i class="bi bi-exclamation-triangle"></i>
                                <span>
                                    @string.Join(", ", MissingRequired) still needs a value. The script declares it
                                    as required, so PowerShell would stop to prompt — and there is no console here
                                    to prompt on.
                                </span>
                            </div>
                        }
                    }
                </div>

                @* One console, in the order things were written. It was two boxes — every error
                   in a red one, everything else in a green one, both filled only once the script
                   had finished — so a long run looked hung, and "Installing in X" and X's failure
                   sat in different boxes with nothing to pair them up. *@
                @if (Run.HasRun)
                {
                    var (statusIcon, statusText, statusTone) = ConsoleStatus();
                    <section class="ps-console" aria-label="Script output">
                        <header class="ps-console-head">
                            <span class="ps-console-status @statusTone">
                                <i class="bi @statusIcon" aria-hidden="true"></i>
                                <span>@statusText</span>
                            </span>
                            <span class="ps-console-meta">
                                @Run.ScriptName &middot; @FormatElapsed(Run.Elapsed) &middot; @Run.Lines.Count.ToString("N0") line@(Run.Lines.Count == 1 ? "" : "s")
                            </span>

                            <div class="ps-console-tools">
                                @if (Run.ErrorCount > 0)
                                {
                                    <button type="button" class="ps-console-chip @(errorsOnly ? "is-active" : "")"
                                            aria-pressed="@(errorsOnly ? "true" : "false")"
                                            title="@(errorsOnly ? "Show all output" : "Show only errors")"
                                            @onclick="ToggleErrorsOnly">
                                        <i class="bi bi-funnel" aria-hidden="true"></i>
                                        @Run.ErrorCount.ToString("N0") error@(Run.ErrorCount == 1 ? "" : "s")
                                    </button>
                                }
                                <button type="button" class="ps-console-tool" title="Copy all output"
                                        disabled="@(Run.Lines.Count == 0)" @onclick="CopyOutput">
                                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                                    <span class="sr-only">Copy all output</span>
                                </button>
                                <button type="button" class="ps-console-tool" title="Clear output"
                                        disabled="@Run.IsRunning" @onclick="ClearOutput">
                                    <i class="bi bi-eraser" aria-hidden="true"></i>
                                    <span class="sr-only">Clear output</span>
                                </button>
                            </div>
                        </header>

                        <div class="ps-console-body" role="log" @ref="consoleBody">
                            @if (HiddenLineCount > 0)
                            {
                                <div class="ps-console-note">
                                    @HiddenLineCount.ToString("N0") earlier lines are not shown. Copy includes them.
                                </div>
                            }
                            @foreach (var line in VisibleLines)
                            {
                                <div class="@LineClass(line)">@line.Text</div>
                            }
                            @if (Run.Lines.Count == 0)
                            {
                                <div class="ps-console-note">
                                    @(Run.IsRunning ? "Waiting for the script to write something…" : "The script finished without writing anything.")
                                </div>
                            }
                        </div>

                        @* Shown by scriptConsole.js when you have scrolled up to read, so the
                           console stops dragging you to the bottom and still offers the way back. *@
                        <button type="button" class="ps-console-jump">
                            <i class="bi bi-arrow-down" aria-hidden="true"></i>
                            Latest output
                        </button>
                    </section>
                }
                </div>

                @* Run, alone. Save and Delete moved up beside Validate with the other things that
                   act on the file, which leaves this bar for the one thing that acts on the
                   machine — so Run is the primary button now rather than a secondary one. *@
                <div class="ps-actions">
                    @* One Run button, not two. "Run Script" and "Run With Parameters" differed only in
                       whether the path was passed, and the one that did not pass it could never work:
                       every bundled script declares ProjectPath as mandatory. *@
                    @* Enabled even when a required value is missing, and the run stops itself
                       with a message. A disabled button is a dead end: it will not tell you
                       which value it is waiting for, and the alternative — letting the run
                       go through — fails with a PowerShell binding error that reads like the
                       tab is broken. *@
                    @* Run becomes Stop while a script runs. It used to become a disabled "Running..."
                       with no way to end a run short of closing the app. *@
                    @if (Run.IsRunning)
                    {
                        <button class="btn-secondary flex items-center space-x-2" @onclick="StopScript"
                                disabled="@Run.IsStopping" title="Stop @Run.ScriptName">
                            <i class="bi bi-stop-fill"></i>
                            <span>@(Run.IsStopping ? "Stopping…" : "Stop")</span>
                        </button>
                    }
                    else
                    {
                        <button class="btn-primary flex items-center space-x-2" @onclick="ExecuteScript"
                                title="@(MissingRequired.Count > 0 ? $"Needs a value for {string.Join(", ", MissingRequired)}" : "Run this script with the parameters above")">
                            <i class="bi bi-play-fill"></i>
                            <span>Run Script</span>
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            @* Centred in the pane rather than padded into it: the pane has its own padding
               now, and this state is one sentence and a button. *@
            <div class="flex flex-col items-center justify-center flex-1 text-center gap-2">
                <i class="bi bi-file-earmark-code text-3xl text-dark-text-muted"></i>
                <h3 class="text-base font-semibold text-dark-text">No script selected</h3>
                <p class="text-xs text-dark-text-muted mb-1">Pick one from the list, or start a new one.</p>
                <button class="btn-primary flex items-center space-x-2" @onclick="CreateNewScript">
                    <i class="bi bi-plus-circle"></i>
                    <span>New Script</span>
                </button>
            </div>
        }
    </div>
</div>

<NewScriptDialog IsVisible="newScriptVisible"
                 IsVisibleChanged="visible => newScriptVisible = visible"
                 ExistingNames="ScriptNames"
                 OnCreate="CreateScriptNamed" />